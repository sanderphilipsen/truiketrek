@page "/special/{Id:int}"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Special – Truitje Trek</PageTitle>
<PitchFx Teams="_info?.Affiche" />

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
    <a class="btn" href="">Naar de startpagina</a>
}
else if (_overview is null || _info is null)
{
    <div class="center-msg"><Spinner /></div>
}
else
{
    var answered = _overview.Questions.Count(q => q.Status == QuestionStatus.Answered);
    var next = _overview.Questions.FirstOrDefault(q => q.Status != QuestionStatus.Answered);

    <section class="card hero special-hero">
        @if (_info.Affiche is { } affiche)
        {
            <AfficheBanner Affiche="affiche" Big="true" />
        }
        <div class="special-icon">@_info.Icon</div>
        <h1>@_info.Name</h1>
        <p class="muted">@_info.Description</p>
        <div class="muted">@Period(_info)</div>
        <div class="score-big">@_overview.TotalPoints <small>punten</small></div>
        <div class="muted">@answered / @_overview.Questions.Count vragen gespeeld</div>

        @if (next is not null && _info.IsActive)
        {
            <a class="btn primary big" href="special/@Id/vraag/@next.Number">
                @(_overview.Questions.All(q => q.Status == QuestionStatus.NotStarted) ? "Start de special" : $"Verder met vraag {next.Number}")
            </a>
        }
        else if (next is null)
        {
            <p class="done">Klaar.</p>
            <RewardPopup Kicker="@($"{_info.Name} voltooid!")" />
        }
        else
        {
            <p class="muted">Deze special is afgelopen.</p>
        }
    </section>

    <ol class="question-list">
        @foreach (var q in _overview.Questions)
        {
            <li class="@(q.Correct == true ? "ok" : q.Correct == false ? "fail" : q.Status == QuestionStatus.NotStarted ? "todo" : "busy")">
                <span class="num">@q.Number</span>
                <span class="name">@(q.PlayerName ?? (q.Status == QuestionStatus.NotStarted ? "?" : "bezig…"))</span>
                <span class="pts">@(q.Points is { } p ? $"{p}" : "")</span>
            </li>
        }
    </ol>

    @if (!_info.IsUpcoming)
    {
        <h2 class="section-title">🏆 Klassement</h2>
        @if (_board is null)
        {
            <div class="center-msg"><Spinner /></div>
        }
        else if (_board.Entries.Count == 0)
        {
            <div class="card center muted">Nog niemand speelde deze special.</div>
        }
        else
        {
            <LeaderboardList Entries="@_board.Entries.Select(e => new LeaderboardList.Row(e.Rank, e.UserName, e.AvatarId, e.Points, e.IsMe)).ToList()" />
            <p class="section-note">@_board.Note</p>
        }
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private SpecialSummary? _info;
    private DailyOverview? _overview;
    private Leaderboard? _board;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _info = (await Api.GetSpecialsAsync()).FirstOrDefault(s => s.Id == Id)
                    ?? throw new ApiException("Deze special is niet (meer) beschikbaar.");
            _overview = await Api.GetDailyAsync(Id);
            if (!_info.IsUpcoming) _board = await Api.GetSpecialLeaderboardAsync(Id);
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    public static string Period(SpecialSummary s) =>
        s.StartDate == s.EndDate ? DutchDates.DayMonth(s.StartDate) : $"{DutchDates.DayMonth(s.StartDate)} – {DutchDates.DayMonth(s.EndDate)}";
}
