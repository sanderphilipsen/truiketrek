@page "/badges"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthState Auth

<PageTitle>Prijzenkast – Truitje Trek</PageTitle>

<PageHeader Title="Prijzenkast">
    <Aside>
        @if (_p is not null)
        {
            <span class="sb-digits" aria-label="@_p.Badges.Count(b => b.Earned) van @_p.Badges.Count verdiend">@_p.Badges.Count(b => b.Earned)/@_p.Badges.Count</span>
            <span class="sb-label" aria-hidden="true">verdiend</span>
        }
    </Aside>
</PageHeader>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_p is null)
{
    <div class="center-msg"><Spinner /></div>
}
else
{
    var earned = _p.Badges.Count(b => b.Earned);
    <section class="card badge-summary">
        <div class="badge-meter"><span style="width:@(earned * 100 / Math.Max(1, _p.Badges.Count))%"></span></div>
        <p class="center"><b>@earned</b> / @_p.Badges.Count · @_p.Trophies.Count @(_p.Trophies.Count == 1 ? "beker" : "bekers")</p>
    </section>

    <BadgesAndTrophies Profile="_p" />
}

@code {
    private PublicProfile? _p;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await Auth.GetAuthenticationStateAsync();
            var name = state.User.Identity?.Name ?? throw new ApiException("Je bent niet aangemeld.");
            _p = await Api.GetPlayerProfileAsync(name);
        }
        catch (ApiException ex) { _error = ex.Message; }
    }
}
