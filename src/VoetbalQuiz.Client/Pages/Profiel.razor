@page "/profiel"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject PushClient Push

<PageTitle>Spelersfiche – Truitje Trek</PageTitle>

<PageHeader Title="Spelersfiche" />
<ConfirmSheet @ref="_confirm" />

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_profile is null)
{
    <div class="center-msg"><Spinner /></div>
}
else
{
    var lvl = _profile.Level;

    <div class="profile-layout">
        @* ---------- Links: wie je bent ---------- *@
        <aside class="profile-side">
            <section class="card profile-hero">
                <button class="hero-avatar" title="Avatar wijzigen" @onclick="() => _tab = ProfileTab.Avatar">
                    <Avatar Id="@_profile.AvatarId" User="@_profile.UserName" Size="96" />
                    <span class="hero-edit"><Icon Name="pencil-simple" /></span>
                </button>
                <div class="hero-main">
                    <h2>@_profile.UserName</h2>
                    <div class="level-line"><span class="lvl big">Level @lvl.Level</span> @lvl.Title</div>
                    <div class="xpbar"><div style="width:@Percent(lvl.XpIntoLevel, lvl.XpForNextLevel)"></div></div>
                    <small class="muted">@lvl.XpIntoLevel / @lvl.XpForNextLevel XP tot level @(lvl.Level + 1)</small>
                </div>
            </section>

            @if (_public is not null)
            {
                <div class="my-stats profile-stats">
                    <div><b>@_public.DaysPlayed</b><small>@(_public.DaysPlayed == 1 ? "dag" : "dagen") gespeeld</small></div>
                    <div><b>@_public.DaysWon</b><small>dagzeges</small></div>
                    <div><b>@_public.BestDay</b><small>beste dag</small></div>
                    <div><b>@_public.Rating</b><small>online rating</small></div>
                </div>

                var earned = _public.Badges.Where(b => b.Earned).ToList();
                <a class="card badge-teaser" href="badges">
                    <div class="teaser-text">
                        <b><Icon Name="medal" Class="sb-icon" /> @earned.Count/@_public.Badges.Count badges</b>
                        <small class="muted">@_public.Trophies.Count @(_public.Trophies.Count == 1 ? "beker" : "bekers") · @(earned.Count == 0 ? "bekijk wat je kan verdienen" : "bekijk ze allemaal")</small>
                        @if (earned.Count > 0)
                        {
                            <div class="teaser-icons">
                                @foreach (var b in earned.Take(6))
                                {
                                    <span class="tier-@b.Tier.ToString().ToLowerInvariant()" title="@b.Name"><Icon Name="@b.Icon" /></span>
                                }
                            </div>
                        }
                    </div>
                    <span class="teaser-go">›</span>
                </a>
            }
        </aside>

        @* ---------- Rechts: wat je kan aanpassen ---------- *@
        <div class="profile-main">
            <div class="tabs profile-tabs">
                <button class="@(_tab == ProfileTab.Avatar ? "active" : "")" aria-pressed="@(_tab == ProfileTab.Avatar ? "true" : "false")" @onclick="() => _tab = ProfileTab.Avatar"><Icon Name="palette" /> Avatar</button>
                <button class="@(_tab == ProfileTab.Level ? "active" : "")" aria-pressed="@(_tab == ProfileTab.Level ? "true" : "false")" @onclick="() => _tab = ProfileTab.Level"><Icon Name="star" /> Level</button>
                <button class="@(_tab == ProfileTab.Account ? "active" : "")" aria-pressed="@(_tab == ProfileTab.Account ? "true" : "false")" @onclick="() => _tab = ProfileTab.Account"><Icon Name="lock" /> Account</button>
            </div>

            @switch (_tab)
            {
                case ProfileTab.Avatar:
                    <section class="card">
                        <div class="tabs light">
                            <button class="@(_build ? "" : "active")" aria-pressed="@(_build ? "false" : "true")" @onclick="() => _build = false"><Icon Name="soccer-ball" /> Voetballer kiezen</button>
                            <button class="@(_build ? "active" : "")" aria-pressed="@(_build ? "true" : "false")" @onclick="() => _build = true"><Icon Name="palette" /> Zelf maken</button>
                        </div>
                        @if (_avatarSaved)
                        {
                            <p class="success" role="status">Je avatar is opgeslagen.</p>
                        }
                        @if (_build)
                        {
                            <p class="muted">Begin van je huidige avatar of druk op Willekeurig, en pas alles aan naar je eigen smaak.</p>
                            <AvatarBuilder Start="@Avatars.Get(_profile.AvatarId)" OnSave="PickAsync" Saving="_saving" />
                        }
                        else
                        {
                            <div class="avatar-grid">
                                @foreach (var a in Avatars.All)
                                {
                                    <button class="avatar-option @(a.Id == _profile.AvatarId ? "selected" : "")" @onclick="() => PickAsync(a.Id)" disabled="@_saving" title="@a.Name">
                                        <Avatar Id="@a.Id" Size="60" />
                                        <small>@a.Name</small>
                                    </button>
                                }
                            </div>
                        }
                    </section>
                    break;

                case ProfileTab.Level:
                    <section class="card xp-card">
                        <div class="xp-total">
                            <span class="lvl big">Level @lvl.Level</span>
                            <b>@lvl.Xp XP</b>
                            <small class="muted">in totaal verdiend</small>
                        </div>
                        <table class="xp-table">
                            @foreach (var part in _profile.XpBreakdown)
                            {
                                <tr><td>@part.Label</td><td>@part.Xp XP</td></tr>
                            }
                        </table>
                        <h3>Hoe verdien je XP?</h3>
                        <ul class="xp-rules">
                            <li><b>+@Levels.XpPerQuestion</b> per vraag waarop je iets probeerde (passen telt niet)</li>
                            <li><b>+1</b> per @Levels.CorrectPointsPerXp punten bij een juist antwoord (kaart, opstelling en counter: ook je deelpunten)</li>
                            <li><b>+@Levels.XpPerCompletedDay</b> voor een volledige dag (minstens de helft van de vragen geprobeerd)</li>
                            <li><b>+@Levels.XpPerPerfectDay</b> voor 10 op 10</li>
                            <li><b>+@Levels.XpPerDayWon</b> per dagzege</li>
                            <li><b>+@Levels.XpPerMatch</b> per uitgespeelde online wedstrijd, <b>+@Levels.XpPerMatchWon</b> bij een zege (enkel passen telt niet)</li>
                        </ul>
                        <small class="muted">Elk level vraagt 100 XP meer dan het vorige. Er is geen maximum.</small>
                    </section>
                    break;

                default:
                    <section class="card">
                        <h3 class="card-title">@(_profile.HasPassword ? "Wachtwoord wijzigen" : "Wachtwoord instellen")</h3>
                        @if (!_profile.HasPassword)
                        {
                            <p class="muted">Je meldt je aan met Google. Met een wachtwoord kan je je ook aanmelden met je gebruikersnaam.</p>
                        }
                        <form class="stack" @onsubmit="ChangePasswordAsync">
                            @if (_profile.HasPassword)
                            {
                                <label>Huidig wachtwoord
                                    <input type="password" @bind="_current" autocomplete="current-password" required />
                                </label>
                            }
                            <div class="form-row">
                                <label>Nieuw wachtwoord
                                    <input type="password" @bind="_new" autocomplete="new-password" minlength="6" required />
                                </label>
                                <label>Herhaal nieuw wachtwoord
                                    <input type="password" @bind="_repeat" autocomplete="new-password" minlength="6" required />
                                </label>
                            </div>
                            @if (_pwError is not null) { <p class="error" role="alert">@_pwError</p> }
                            @if (_pwOk) { <p class="success" role="status">Je wachtwoord is gewijzigd.</p> }
                            <button class="btn primary" disabled="@_saving">Wachtwoord opslaan</button>
                        </form>
                    </section>

                    @if (_push is { PublicKey: not null } push)
                    {
                        <section class="card push-settings" aria-labelledby="push-settings-title">
                            <h3 id="push-settings-title" class="card-title">Meldingen</h3>
                            <label class="push-toggle">
                                <span>
                                    <b>Herinnering voor de daily</b>
                                    <small class="muted">Om @(PushRules.DailyReminderHour)u, als je de daily nog niet speelde.</small>
                                </span>
                                <input type="checkbox" class="toggle" checked="@push.DailyReminder" disabled="@_pushBusy"
                                       @onchange="e => SetReminderAsync(e.Value is true)" />
                            </label>
                            @if (push.DailyReminder)
                            {
                                <p class="muted push-device" role="status">@DeviceText</p>
                                @if (_device == PushDeviceState.Default)
                                {
                                    <button type="button" class="btn small" @onclick="EnableDeviceAsync" disabled="@_pushBusy">Zet aan op dit toestel</button>
                                }
                            }
                            @if (_pushError is not null) { <p class="error" role="alert">@_pushError</p> }
                        </section>
                    }

                    <section class="card menu-list">
                        @if (Auth.User?.IsAdmin == true)
                        {
                            <a href="admin"><span><Icon Name="gear-six" /></span>Bestuurskamer<i>›</i></a>
                        }
                        <a href="feedback"><span><Icon Name="bug" /></span>Naar de VAR (bug of idee)<i>›</i></a>
                        <button @onclick="LogoutAsync"><span><Icon Name="sign-out" /></span>Afmelden<i>›</i></button>
                    </section>

                    <section class="card menu-list">
                        <a href="faq"><span><Icon Name="chat-circle" /></span>Veelgestelde vragen<i>›</i></a>
                        <a href="privacy"><span><Icon Name="shield" /></span>Privacyverklaring<i>›</i></a>
                        <a href="voorwaarden"><span><Icon Name="handshake" /></span>Gebruiksvoorwaarden<i>›</i></a>
                        @if (_profile.DeletionRequestedAt is null)
                        {
                            <button @onclick="RequestDeletionAsync" disabled="@_saving"><span><Icon Name="trash" /></span>Account verwijderen<i>›</i></button>
                        }
                    </section>

                    @if (_profile.DeletionRequestedAt is { } requested)
                    {
                        <section class="card deletion-request" role="status">
                            <h3 class="card-title">Verwijdering aangevraagd</h3>
                            <p class="muted">
                                Je vroeg op @DutchDates.DayMonth(LocalDate(requested)) om je account te verwijderen. De beheerder
                                verwerkt je aanvraag; tot dan kan je gewoon verder spelen.
                            </p>
                            <button class="btn small" @onclick="CancelDeletionAsync" disabled="@_saving">Aanvraag intrekken</button>
                        </section>
                    }
                    @if (_deletionError is not null) { <p class="error" role="alert">@_deletionError</p> }

                    <p class="member-since">Lid sinds @DutchDates.DayMonth(_profile.MemberSince) @_profile.MemberSince.Year · @_profile.Email</p>
                    break;
            }
        </div>
    </div>
}

@code {
    private enum ProfileTab { Avatar, Level, Account }

    private ProfileInfo? _profile;
    private PublicProfile? _public;
    private string? _error, _pwError, _deletionError;
    private ConfirmSheet _confirm = null!;
    private string _current = "", _new = "", _repeat = "";
    private bool _saving, _pwOk, _build, _avatarSaved;
    private ProfileTab _tab = ProfileTab.Avatar;

    /// <summary>De tab om mee te openen, bv. "account" vanuit het tegeltje Instellingen op Home.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? StartTab { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Enum.TryParse<ProfileTab>(StartTab, ignoreCase: true, out var start)) _tab = start;
        try
        {
            _profile = await Api.GetProfileAsync();
            _public = await Api.GetPlayerProfileAsync(_profile.UserName);
        }
        catch (ApiException ex) { _error = ex.Message; }

        // Meldingen zijn bijzaak: lukt dit niet, dan verschijnt het blok gewoon niet.
        try
        {
            _push = await Api.GetPushConfigAsync();
            _device = await Push.GetDeviceStateAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _push = null; }
    }

    // ---------- Meldingen ----------

    private PushConfig? _push;
    private PushDeviceState _device;
    private bool _pushBusy;
    private string? _pushError;

    private string DeviceText => _device switch
    {
        PushDeviceState.Granted => "Op dit toestel staan meldingen aan.",
        PushDeviceState.Default => "Op dit toestel staan meldingen nog niet aan.",
        PushDeviceState.Denied => "Je browser blokkeert meldingen van Truitje Trek. Laat ze toe in de instellingen van je browser, bij deze site.",
        PushDeviceState.IosInstall => "Op een iPhone krijg je meldingen enkel als Truitje Trek op je beginscherm staat: tik op Deel en kies Zet op beginscherm.",
        _ => "Deze browser kan geen meldingen tonen. Op een ander toestel kan het wel.",
    };

    private async Task SetReminderAsync(bool on)
    {
        _pushBusy = true;
        _pushError = null;
        try
        {
            // Eerst de toestemming: de browser vraagt ze enkel meteen na een tik.
            if (on && _device == PushDeviceState.Default)
            {
                await Push.EnableDeviceAsync(_push!.PublicKey!, ask: true);
                _device = await Push.GetDeviceStateAsync();
            }
            await Api.SetDailyReminderAsync(on);
            _push = _push! with { DailyReminder = on };
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _pushError = "Opslaan lukte niet. Probeer het opnieuw."; }
        finally { _pushBusy = false; }
    }

    private async Task EnableDeviceAsync()
    {
        _pushBusy = true;
        _pushError = null;
        try
        {
            await Push.EnableDeviceAsync(_push!.PublicKey!, ask: true);
            _device = await Push.GetDeviceStateAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _pushError = "Meldingen aanzetten lukte niet. Probeer het later opnieuw."; }
        finally { _pushBusy = false; }
    }

    private async Task PickAsync(string id)
    {
        _saving = true;
        _avatarSaved = false;
        try
        {
            await Auth.SetAvatarAsync(id);
            _avatarSaved = true;
            _profile = _profile! with { AvatarId = id };
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task ChangePasswordAsync()
    {
        _pwError = null;
        _pwOk = false;
        if (_new != _repeat)
        {
            _pwError = "De nieuwe wachtwoorden zijn niet gelijk.";
            return;
        }

        _saving = true;
        try
        {
            await Api.ChangePasswordAsync(new ChangePasswordRequest(_current, _new));
            _pwOk = true;
            _current = _new = _repeat = "";
            _profile = _profile! with { HasPassword = true };
        }
        catch (ApiException ex) { _pwError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task RequestDeletionAsync()
    {
        if (!await _confirm.AskAsync("Account verwijderen?",
                "De beheerder verwijdert dan je e-mailadres, je aanmeldgegevens, je meldingen en je trainingen. Je resultaten in " +
                "eerdere klassementen blijven bestaan onder een anonieme naam. Dit kan je niet ongedaan maken.",
                "Verwijdering aanvragen"))
            return;

        _saving = true;
        _deletionError = null;
        try
        {
            await Api.RequestDeletionAsync();
            _profile = _profile! with { DeletionRequestedAt = DateTime.UtcNow };
        }
        catch (ApiException ex) { _deletionError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task CancelDeletionAsync()
    {
        _saving = true;
        _deletionError = null;
        try
        {
            await Api.CancelDeletionAsync();
            _profile = _profile! with { DeletionRequestedAt = null };
        }
        catch (ApiException ex) { _deletionError = ex.Message; }
        finally { _saving = false; }
    }

    private static DateOnly LocalDate(DateTime utc) => DateOnly.FromDateTime(utc.ToLocalTime());

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login");
    }

    private static string Percent(int part, int total) =>
        (total == 0 ? 0 : Math.Clamp(100.0 * part / total, 0, 100)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
}
