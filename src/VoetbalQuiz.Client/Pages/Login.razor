@page "/login"
@inject AuthState Auth
@inject NavigationManager Nav
@inject ApiClient Api

<PageTitle>Aanmelden – Truitje Trek</PageTitle>

<div class="auth-logo"><img src="logo.svg" alt="Truitje Trek" /><div>Truitje Trek</div><small>De voetbalquiz waar je niet loskomt</small></div>

<section class="card auth">
    <h1>@(_register ? "Account maken" : "Aanmelden")</h1>
    <p class="muted">Elke dag een nieuwe voetbalquiz. Hoe sneller, hoe meer punten.</p>

    @if (_google)
    {
        <button class="btn google-btn" @onclick="Google" disabled="@_busy">
            <svg class="google-g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
            Doorgaan met Google
        </button>
        <div class="or-line"><span>of met je gebruikersnaam</span></div>
    }

    <form @onsubmit="SubmitAsync">
        @if (_register)
        {
            <label>Gebruikersnaam
                <input @bind="_userName" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" maxlength="20" required />
            </label>
            <label>E-mail
                <input type="email" @bind="_email" autocomplete="email" required />
            </label>
        }
        else
        {
            <label>Gebruikersnaam of e-mail
                <input @bind="_userName" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" required />
            </label>
        }
        <label>Wachtwoord
            <input type="password" @bind="_password" autocomplete="@(_register ? "new-password" : "current-password")" minlength="6" required />
        </label>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <button class="btn primary" disabled="@_busy">@(_register ? "Registreren" : "Aanmelden")</button>
        @if (_register)
        {
            <p class="auth-legal">
                Door te registreren ga je akkoord met de <a href="voorwaarden">gebruiksvoorwaarden</a>.
                Lees ook hoe we met je gegevens omgaan in de <a href="privacy">privacyverklaring</a>.
            </p>
        }
    </form>

    @if (!_register)
    {
        <button class="linkish switch" @onclick="() => _forgot = !_forgot" aria-expanded="@(_forgot ? "true" : "false")">Wachtwoord vergeten?</button>
        @if (_forgot)
        {
            <p class="muted" role="status">Contacteer de beheerder van de app. Die geeft je een tijdelijk wachtwoord, waarmee je je aanmeldt en daarna in je Spelersfiche zelf een nieuw wachtwoord kiest.</p>
        }
    }

    <button class="linkish switch" @onclick="Toggle">
        @(_register ? "Al een account? Meld je aan" : "Nog geen account? Registreer je")
    </button>
</section>

<nav class="info-links" aria-label="Info">
    <a href="faq">Veelgestelde vragen</a> · <a href="privacy">Privacy</a> · <a href="voorwaarden">Voorwaarden</a>
</nav>

@code {
    /// <summary>Waar je na het aanmelden heen gaat, bv. een gedeeld partijtje (online/12).</summary>
    [SupplyParameterFromQuery(Name = "terug")] public string? Terug { get; set; }

    private bool _register;
    private string _userName = "", _email = "", _password = "";
    private string? _error;
    private bool _busy;
    private bool _forgot;
    private bool _google;

    /// <summary>Foutcode van de terugsprong na Google (zie AccountEndpoints).</summary>
    [SupplyParameterFromQuery(Name = "fout")] public string? Fout { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _error = Fout switch
        {
            "google" => "Aanmelden met Google is niet gelukt. Probeer het opnieuw.",
            "geblokkeerd" => "Te veel pogingen. Probeer het over enkele minuten opnieuw.",
            "koppel" => "Er bestaat al een account met je Google-e-mailadres. Meld je één keer aan met je gebruikersnaam en wachtwoord: dan koppelen we Google en kan je voortaan met Google aanmelden. Is het niet jouw account? Contacteer de beheerder.",
            "onbevestigd" => "Je Google-account heeft geen bevestigd e-mailadres. Meld je aan met je gebruikersnaam en wachtwoord.",
            _ => null,
        };
        try { _google = (await Api.GetLoginOptionsAsync()).Google; }
        catch { /* zonder antwoord geen Google-knop; aanmelden met wachtwoord blijft werken */ }
    }

    /// <summary>Een volledige paginalading: de server stuurt door naar Google en na afloop terug naar de app.</summary>
    private void Google()
    {
        _busy = true;
        var terug = ReturnPath.Safe(Terug);
        Nav.NavigateTo("api/account/google" + (terug.Length > 0 ? "?terug=" + Uri.EscapeDataString(terug) : ""), forceLoad: true);
    }

    private void Toggle()
    {
        _register = !_register;
        _forgot = false;
        _error = null;
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            if (_register) await Auth.RegisterAsync(new RegisterRequest(_userName, _email, _password));
            else await Auth.LoginAsync(new LoginRequest(_userName, _password));
            Nav.NavigateTo(ReturnPath.Safe(Terug));
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
