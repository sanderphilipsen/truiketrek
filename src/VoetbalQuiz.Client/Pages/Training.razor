@page "/academie"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Academie – Truitje Trek</PageTitle>

<PageHeader Title="Academie" Label="Oefenen · telt niet mee" />

<div class="month-nav">
    <button class="linkish" aria-label="Vorige maand" @onclick="() => MoveMonthAsync(-1)" disabled="@(_archive is not { HasEarlier: true })">‹</button>
    <span>@(_archive is null ? "" : DutchDates.MonthYear(_archive.Year, _archive.Month))</span>
    <button class="linkish" aria-label="Volgende maand" @onclick="() => MoveMonthAsync(1)" disabled="@(_archive is not { HasLater: true })">›</button>
</div>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_archive is null)
{
    <div class="center-msg"><Spinner /></div>
}
else if (_archive.Days.Count == 0)
{
    <div class="card center muted">Geen dailies in deze maand.</div>
}
else
{
    @* Per dag één strook in de vorm van Home: de dag en het vraagtype, rechts je echte score in gele cijfers. *@
    <ul class="training-days">
        @foreach (var day in _archive.Days)
        {
            <li>
                <a class="card sb-strip training-day" href="@DayUrl(day)" aria-label="@AriaLabel(day)">
                    <span class="training-day-text" aria-hidden="true">
                        @if (day.Special is { } sp)
                        {
                            <b>@sp.Name</b>
                            <small>Special · @SpecialDates(sp) · @Sub(day)</small>
                        }
                        else
                        {
                            <b class="cap">@DutchDates.DayMonth(day.Date)</b>
                            <small>@QuestionTypes.Name(day.Types) · @Sub(day)</small>
                        }
                    </span>
                    @if (day.Real is { } real)
                    {
                        <span class="sb-digits" aria-hidden="true">@real.Points</span>
                    }
                    <span class="sb-go" aria-hidden="true">›</span>
                </a>
            </li>
        }
    </ul>
}

@code {
    private TrainingArchive? _archive;
    private string? _error;

    // Zonder maand kiest de server (Belgische tijd) de maand van de laatste daily die je kan spelen; de klok van de browser telt niet.
    protected override Task OnInitializedAsync() => LoadAsync(null, null);

    private Task MoveMonthAsync(int delta)
    {
        var d = new DateOnly(_archive!.Year, _archive.Month, 1).AddMonths(delta);
        return LoadAsync(d.Year, d.Month);
    }

    private async Task LoadAsync(int? year, int? month)
    {
        (_archive, _error) = (null, null);
        try { _archive = await Api.GetTrainingArchiveAsync(year, month); }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private static string DayUrl(TrainingDay day) =>
        day.Special is { } sp ? $"academie/special/{sp.Id}" : $"academie/{day.Date:yyyy-MM-dd}";

    /// <summary>"25 december" voor een special van één dag, anders "1 – 3 oktober".</summary>
    public static string SpecialDates(TrainingSpecial sp) => sp.StartDate == sp.EndDate
        ? $"{sp.EndDate.Day} {DutchDates.Month(sp.EndDate.Month)}"
        : sp.StartDate.Month == sp.EndDate.Month
            ? $"{sp.StartDate.Day} – {sp.EndDate.Day} {DutchDates.Month(sp.EndDate.Month)}"
            : $"{sp.StartDate.Day} {DutchDates.Month(sp.StartDate.Month)} – {sp.EndDate.Day} {DutchDates.Month(sp.EndDate.Month)}";

    /// <summary>Je plaats toen ("3de van 12"), hoe vaak je al oefende, of "nog niet gespeeld".</summary>
    private static string Sub(TrainingDay day)
    {
        var parts = new List<string>();
        if (day.Real is { } real) parts.Add($"{real.Rank}{DutchDates.OrdinalSuffix(real.Rank)} van {real.Players}");
        if (day.Runs > 0) parts.Add(day.Runs == 1 ? "1× geoefend" : $"{day.Runs}× geoefend");
        return parts.Count == 0 ? "nog niet gespeeld" : string.Join(" · ", parts);
    }

    private static string AriaLabel(TrainingDay day)
    {
        var what = day.Special is { } sp ? $"Special {sp.Name}, {SpecialDates(sp)}" : DutchDates.DayMonth(day.Date);
        var score = day.Real is { } real ? $", {real.Points} punten" : "";
        return $"{what}, {QuestionTypes.Name(day.Types)}, {Sub(day)}{score}";
    }
}
