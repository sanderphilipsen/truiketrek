@page "/klassement"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Klassement – Truitje Trek</PageTitle>

<PageHeader Title="Klassement" Label="@Label">
    <Aside>
        @if (Me is { } me)
        {
            var place = $"{me.Rank}{DutchDates.OrdinalSuffix(me.Rank)}";
            <span class="sb-digits" aria-label="@($"Je staat {place} van {me.Count}")">@place</span>
            <span class="sb-label" aria-hidden="true">van @me.Count</span>
        }
    </Aside>
</PageHeader>

@* De vaste set: drie klassementen, meer komt er niet bij (backlog 002). Specials hebben hun eigen klassement op hun pagina. *@
<div class="tabs">
    <button class="@(_tab == Tab.Vandaag ? "active" : "")" aria-pressed="@(_tab == Tab.Vandaag ? "true" : "false")" @onclick="() => ShowAsync(Tab.Vandaag)">Vandaag</button>
    <button class="@(_tab == Tab.Maand ? "active" : "")" aria-pressed="@(_tab == Tab.Maand ? "true" : "false")" @onclick="() => ShowAsync(Tab.Maand)">Maand</button>
    <button class="@(_tab == Tab.Online ? "active" : "")" aria-pressed="@(_tab == Tab.Online ? "true" : "false")" @onclick="() => ShowAsync(Tab.Online)">Online</button>
</div>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_tab == Tab.Vandaag)
{
    @* ---------- Dagklassement: enkel de daily van vandaag ---------- *@
    @if (_today is null)
    {
        <div class="center-msg"><Spinner /></div>
    }
    else if (_today.Entries.Count == 0)
    {
        <div class="card center muted">Nog niemand gespeeld vandaag.</div>
    }
    else
    {
        <LeaderboardList Entries="@_today.Entries.Select(e => new LeaderboardList.Row(e.Rank, e.UserName, e.AvatarId, e.Points, e.IsMe)).ToList()" />
    }
}
else if (_tab == Tab.Maand)
{
    @* ---------- Maandklassement (daily + specials + bonussen), als de stand op tv: zones en pijltjes ---------- *@
    <div class="month-nav">
        <button class="linkish" aria-label="Vorige maand" @onclick="() => MoveMonthAsync(-1)">‹</button>
        <span>@DutchDates.MonthYear(_year, _month)</span>
        <button class="linkish" aria-label="Volgende maand" @onclick="() => MoveMonthAsync(1)" disabled="@IsCurrentMonth">›</button>
    </div>

    @if (_ranking is null)
    {
        <div class="center-msg"><Spinner /></div>
    }
    else if (_ranking.Entries.Count == 0)
    {
        <div class="card center muted">Nog niemand gespeeld deze maand.</div>
    }
    else
    {
        var players = _ranking.Entries.Count;
        <LeaderboardList ShowMovement="@_ranking.ShowMovement"
                         Entries="@_ranking.Entries.Select(e => new LeaderboardList.Row(e.Rank, e.UserName, e.AvatarId, e.Total, e.IsMe,
                             _ranking.ShowMovement ? e.Change : null, MonthRules.Zone(e.Rank, players))).ToList()" />
        <p class="section-note board-legend">
            <span class="zone-prize">Top @MonthRules.PrizeZone: beker, de eerste de Gouden Bal.</span>
            @if (players >= MonthRules.DropZoneMinPlayers)
            {
                <span class="zone-drop">Onderste @MonthRules.DropZone: degradatiezone.</span>
            }
            @if (_ranking.ShowMovement)
            {
                <span>Pijltjes: tegenover gisteren.</span>
            }
        </p>
        <p class="section-note">@_ranking.Explanation</p>
    }
}
else
{
    @* ---------- Online: de rating, los van de maand ---------- *@
    @if (_online is null)
    {
        <div class="center-msg"><Spinner /></div>
    }
    else if (_online.Entries.Count == 0)
    {
        <div class="card center muted">Nog niemand speelde een online wedstrijd uit.</div>
    }
    else
    {
        <LeaderboardList Entries="@_online.Entries.Select(e => new LeaderboardList.Row(e.Rank, e.UserName, e.AvatarId, e.Value, e.IsMe,
                             Sub: $"{e.Played} gespeeld · {e.Wins} gewonnen")).ToList()" />
        @if (_online.Note is not null)
        {
            <p class="section-note">@_online.Note</p>
        }
    }
}

@code {
    private enum Tab { Vandaag, Maand, Online }

    private Tab _tab;
    private int _year = QuizDay.Today().Year, _month = QuizDay.Today().Month;
    private Leaderboard? _today;
    private MonthRanking? _ranking;
    private OnlineLeaderboard? _online;
    private string? _error;

    /// <summary>Open meteen een tabblad, bv. <c>/klassement?tab=maand</c> vanaf Home.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? StartTab { get; set; }

    /// <summary>Open het maandklassement op een afgelopen maand, bv. <c>?tab=maand&amp;maand=2026-10</c> vanaf de Gouden Bal.</summary>
    [SupplyParameterFromQuery(Name = "maand")] public string? StartMonth { get; set; }

    private bool IsCurrentMonth => _year == QuizDay.Today().Year && _month == QuizDay.Today().Month;

    private string Label => _tab switch { Tab.Vandaag => "Vandaag", Tab.Maand => "Maand", _ => "Online" };

    /// <summary>Jouw plaats in het getoonde klassement, voor het kerngetal in de kop (null als je er niet in staat).</summary>
    private (int Rank, int Count)? Me => _tab switch
    {
        Tab.Maand => _ranking?.Entries.FirstOrDefault(e => e.IsMe) is { } m ? (m.Rank, _ranking.Entries.Count) : null,
        Tab.Online => _online?.Entries.FirstOrDefault(e => e.IsMe) is { } o ? (o.Rank, _online.Entries.Count) : null,
        _ => _today?.Entries.FirstOrDefault(e => e.IsMe) is { } t ? (t.Rank, _today.Entries.Count) : null,
    };

    protected override Task OnInitializedAsync()
    {
        if (Enum.TryParse<Tab>(StartTab, ignoreCase: true, out var start)) _tab = start;
        if (DateOnly.TryParseExact(StartMonth + "-01", "yyyy-MM-dd", out var month) && month <= QuizDay.Today())
            (_year, _month) = (month.Year, month.Month);
        return LoadAsync();
    }

    private async Task ShowAsync(Tab tab)
    {
        _tab = tab;
        await LoadAsync();
    }

    private async Task MoveMonthAsync(int delta)
    {
        var d = new DateTime(_year, _month, 1).AddMonths(delta);
        (_year, _month) = (d.Year, d.Month);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            switch (_tab)
            {
                case Tab.Maand:
                    _ranking = null;
                    _ranking = await Api.GetMonthRankingAsync(_year, _month);
                    break;
                case Tab.Online:
                    _online = null;
                    _online = await Api.GetOnlineLeaderboardAsync();
                    break;
                default:
                    _today = null;
                    _today = await Api.GetTodayLeaderboardAsync();
                    break;
            }
        }
        catch (ApiException ex) { _error = ex.Message; }
    }
}
