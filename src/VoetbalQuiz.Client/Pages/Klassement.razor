@page "/klassement"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Klassement – Truitje Trek</PageTitle>

<PageHeader Title="Klassement" Label="@Label">
    <Aside>
        @if (Me is { } me)
        {
            var place = $"{me.Rank}{DutchDates.OrdinalSuffix(me.Rank)}";
            <span class="sb-digits" aria-label="@($"Je staat {place} van {me.Count}")">@place</span>
            <span class="sb-label" aria-hidden="true">van @me.Count</span>
        }
    </Aside>
</PageHeader>

@* De vaste set: drie klassementen, meer komt er niet bij (backlog 002). Specials hebben hun eigen klassement op hun pagina.
   Tab en maand staan in het adres, zodat je na een spelersprofiel en "terug" op dezelfde plek uitkomt. *@
<div class="tabs">
    <button class="@(_tab == Tab.Vandaag ? "active" : "")" aria-pressed="@(_tab == Tab.Vandaag ? "true" : "false")" @onclick="() => Go(Tab.Vandaag)">Vandaag</button>
    <button class="@(_tab == Tab.Maand ? "active" : "")" aria-pressed="@(_tab == Tab.Maand ? "true" : "false")" @onclick="() => Go(Tab.Maand)">Maand</button>
    <button class="@(_tab == Tab.Online ? "active" : "")" aria-pressed="@(_tab == Tab.Online ? "true" : "false")" @onclick="() => Go(Tab.Online)">Online</button>
</div>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_tab == Tab.Vandaag)
{
    @* ---------- Dagklassement: enkel de daily van vandaag ---------- *@
    @if (_today is null)
    {
        @BoardSkeleton
    }
    else
    {
        @if (!_today.Entries.Any(e => e.IsMe) && Auth.User is { } user)
        {
            @* Nog niet gespeeld: je ontbreekt in de lijst, dus hier de knop om erin te komen. *@
            <div class="card board-cta">
                <Avatar Id="@user.AvatarId" User="@user.UserName" Size="38" />
                <div class="board-cta-text">
                    <b>@(_today.Entries.Count == 0 ? "Nog niemand gespeeld vandaag" : "Jij staat er nog niet bij")</b>
                    <small>@(_today.Entries.Count == 0 ? "Speel als eerste de daily en pak de leiding." : "Speel de daily van vandaag en pak je plaats.")</small>
                </div>
                <a class="btn primary small" href="daily">Speel</a>
            </div>
        }
        @if (_today.Entries.Count == 0)
        {
            @if (Auth.User is null)
            {
                <div class="card center muted">Nog niemand gespeeld vandaag.</div>
            }
        }
        else
        {
            <LeaderboardList Entries="@_today.Entries.Select(e => new LeaderboardList.Row(e.Rank, e.UserName, e.AvatarId, e.Points, e.IsMe,
                                 Sub: CorrectLabel(e))).ToList()" />
        }
    }
}
else if (_tab == Tab.Maand)
{
    @* ---------- Maandklassement (daily + specials + bonussen), als de stand op tv: zones en pijltjes ---------- *@
    <div class="month-nav">
        <button class="linkish" aria-label="Vorige maand" @onclick="() => MoveMonth(-1)">‹</button>
        <span>@DutchDates.MonthYear(_year, _month)</span>
        <button class="linkish" aria-label="Volgende maand" @onclick="() => MoveMonth(1)" disabled="@IsCurrentMonth">›</button>
    </div>

    @if (Ranking is null)
    {
        @BoardSkeleton
    }
    else if (Ranking.Entries.Count == 0)
    {
        <div class="card center muted">Nog niemand gespeeld deze maand.</div>
    }
    else
    {
        var players = Ranking.Entries.Count;
        <LeaderboardList ShowMovement="@Ranking.ShowMovement"
                         Entries="@Ranking.Entries.Select(e => new LeaderboardList.Row(e.Rank, e.UserName, e.AvatarId, e.Total, e.IsMe,
                             Ranking.ShowMovement ? e.Change : null, MonthRules.Zone(e.Rank, players))).ToList()" />
        <p class="section-note board-legend">
            <span class="zone-prize">Top @MonthRules.PrizeZone: beker, de eerste de Gouden Bal.</span>
            @if (players >= MonthRules.DropZoneMinPlayers)
            {
                <span class="zone-drop">Onderste @MonthRules.DropZone: degradatiezone.</span>
            }
            @if (Ranking.ShowMovement)
            {
                <span>Pijltjes: tegenover gisteren.</span>
            }
        </p>
        <p class="section-note">@Ranking.Explanation</p>
    }
}
else
{
    @* ---------- Online: de rating, los van de maand ---------- *@
    @if (_online is null)
    {
        @BoardSkeleton
    }
    else if (_online.Entries.Count == 0)
    {
        <div class="card center muted">Nog niemand speelde een online wedstrijd uit.</div>
    }
    else
    {
        <LeaderboardList Entries="@_online.Entries.Select(e => new LeaderboardList.Row(e.Rank, e.UserName, e.AvatarId, e.Value, e.IsMe,
                             Sub: $"{e.Played} gespeeld")).ToList()" />
        @if (_online.Note is not null)
        {
            <p class="section-note">@_online.Note</p>
        }
    }
}

@code {
    private enum Tab { Vandaag, Maand, Online }

    private Tab _tab;
    private int _year = QuizDay.Today().Year, _month = QuizDay.Today().Month;
    // Wat al geladen is blijft staan: bij een tabwissel zie je meteen de vorige stand, en die wordt op de achtergrond ververst.
    private Leaderboard? _today;
    private readonly Dictionary<(int Year, int Month), MonthRanking> _months = [];
    private OnlineLeaderboard? _online;
    private string? _error;

    /// <summary>Het tabblad, bv. <c>/klassement?tab=maand</c> vanaf Home.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? StartTab { get; set; }

    /// <summary>Een afgelopen maand in het maandklassement, bv. <c>?tab=maand&amp;maand=2026-10</c> vanaf de Gouden Bal.</summary>
    [SupplyParameterFromQuery(Name = "maand")] public string? StartMonth { get; set; }

    private MonthRanking? Ranking => _months.GetValueOrDefault((_year, _month));

    private bool IsCurrentMonth => _year == QuizDay.Today().Year && _month == QuizDay.Today().Month;

    private string Label => _tab switch { Tab.Vandaag => "Vandaag", Tab.Maand => "Maand", _ => "Online" };

    /// <summary>Jouw plaats in het getoonde klassement, voor het kerngetal in de kop (null als je er niet in staat).</summary>
    private (int Rank, int Count)? Me => _tab switch
    {
        Tab.Maand => Ranking?.Entries.FirstOrDefault(e => e.IsMe) is { } m ? (m.Rank, Ranking.Entries.Count) : null,
        Tab.Online => _online?.Entries.FirstOrDefault(e => e.IsMe) is { } o ? (o.Rank, _online.Entries.Count) : null,
        _ => _today?.Entries.FirstOrDefault(e => e.IsMe) is { } t ? (t.Rank, _today.Entries.Count) : null,
    };

    /// <summary>Het adres bepaalt wat je ziet: een tab of maand kiezen past enkel het adres aan.</summary>
    protected override Task OnParametersSetAsync()
    {
        _tab = Enum.TryParse<Tab>(StartTab, ignoreCase: true, out var tab) ? tab : Tab.Vandaag;
        var today = QuizDay.Today();
        (_year, _month) = _tab == Tab.Maand && DateOnly.TryParseExact(StartMonth + "-01", "yyyy-MM-dd", out var month) && month <= today
            ? (month.Year, month.Month)
            : (today.Year, today.Month);
        _error = null;
        return LoadAsync();
    }

    private void Go(Tab tab, int? year = null, int? month = null)
    {
        var today = QuizDay.Today();
        var pastMonth = tab == Tab.Maand && year is { } y && month is { } m && (y, m) != (today.Year, today.Month);
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["tab"] = tab == Tab.Vandaag ? null : tab.ToString().ToLowerInvariant(),
            ["maand"] = pastMonth ? $"{year:0000}-{month:00}" : null,
        }), replace: true);
    }

    private void MoveMonth(int delta)
    {
        var d = new DateTime(_year, _month, 1).AddMonths(delta);
        Go(Tab.Maand, d.Year, d.Month);
    }

    private async Task LoadAsync()
    {
        var (tab, key) = (_tab, (_year, _month));
        try
        {
            switch (tab)
            {
                case Tab.Maand:
                    // Een afgelopen maand ligt vast: eens geladen hoeft ze niet opnieuw.
                    if (_months.ContainsKey(key) && !IsCurrentMonth) return;
                    _months[key] = await Api.GetMonthRankingAsync(key.Item1, key.Item2);
                    break;
                case Tab.Online:
                    _online = await Api.GetOnlineLeaderboardAsync();
                    break;
                default:
                    _today = await Api.GetTodayLeaderboardAsync();
                    break;
            }
        }
        catch (ApiException ex)
        {
            // Een mislukte verversing laat de oude stand staan; enkel zonder stand tonen we de fout.
            if (tab == _tab && !HasData) _error = ex.Message;
        }
    }

    // Deels juist (bv. een artikel van De Zondag met een gat fout) telt apart, anders lijkt het of niemand iets vond.
    private static string CorrectLabel(LeaderboardEntry e) => (e.CorrectAnswers, e.PartialAnswers) switch
    {
        (_, 0) => $"{e.CorrectAnswers} juist",
        (0, var p) => $"{p} deels juist",
        var (c, p) => $"{c} juist · {p} deels",
    };

    private bool HasData => _tab switch { Tab.Maand => Ranking is not null, Tab.Online => _online is not null, _ => _today is not null };

    // Plaatshouders in de vorm van de lijst, zodat er niets verspringt als de stand binnenkomt.
    private RenderFragment BoardSkeleton => @<div aria-busy="true">
        <ol class="board board-skeleton" aria-hidden="true">
            @for (var i = 0; i < 6; i++)
            {
                <li>
                    <span class="skeleton sk-rank"></span>
                    <span class="skeleton sk-avatar"></span>
                    <span class="skeleton sk-name"></span>
                    <span class="skeleton sk-pts"></span>
                </li>
            }
        </ol>
        <span class="sr-only" role="status">Klassement laden…</span>
    </div>;
}
