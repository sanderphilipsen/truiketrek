@page "/admin/vragen/{Id:int}"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Vraag bewerken – Bestuurskamer</PageTitle>
<ConfirmSheet @ref="_confirm" />

<AdminGuard>
    <div class="editor-top"><a href="admin/vragen?type=@_type" class="back">‹ Terug naar de vragenbank</a></div>

    @if (_loadError is not null)
    {
        <p class="error">@_loadError</p>
    }
    else if (_loaded)
    {
        var info = QuestionTypes.Get(_type);
        var status = _original?.Status ?? PlayerStatus.Review;
        var complete = Missing().Count == 0;

        <div class="editor">
            <div class="editor-main">
                <section class="card stack">
                    <h2><Icon Name="@info.Icon" /> @info.Name</h2>
                    <p class="muted">@info.HowTo</p>

                    @switch (_type)
                    {
                        case QuestionType.Snelvuur:
                            <label>Vraag <input @bind="_text" @bind:event="oninput" @bind:after="Touch" placeholder="Bv. Bij welke club won De Bruyne de titel in 2011?" /></label>
                            <OptionsEditor Options="_options" Correct="_correct" CorrectChanged="SetCorrect" Label="Juist antwoord" OnChange="Touch" />
                            break;

                        case QuestionType.NietBij:
                            <label>Vraag <input @bind="_text" @bind:event="oninput" @bind:after="Touch" placeholder="Bv. Wie werd nooit kampioen met Club Brugge?" /></label>
                            <OptionsEditor Options="_options" Correct="_correct" CorrectChanged="SetCorrect" Label="Hoort er niet bij" OnChange="Touch" />
                            <label>Uitleg (na afloop getoond) <input @bind="_explanation" @bind:after="Touch" /></label>
                            break;

                        case QuestionType.Jaar:
                            <label>Gebeurtenis (zonder jaartal) <textarea rows="2" @bind="_text" @bind:event="oninput" @bind:after="Touch"></textarea></label>
                            <label>Jaar <input type="number" min="@QuestionRules.MinYear" max="@QuestionRules.MaxYear" @bind="_year" @bind:after="Touch" /></label>
                            break;

                        case QuestionType.Carriere:
                            <label>Speler <input @bind="_answer" @bind:event="oninput" @bind:after="Touch" placeholder="Bv. Kevin De Bruyne" /></label>
                            <label>Ook goed als antwoord <input @bind="_aliases" @bind:after="Touch" placeholder="Bv. De Bruyne, KDB" /></label>
                            <label>Clubs, in volgorde (één per lijn, met jaartallen)
                                <textarea rows="7" @bind="_lines" @bind:event="oninput" @bind:after="Touch" placeholder="KRC Genk (2008–2012)&#10;Chelsea (2012–2014)"></textarea>
                            </label>
                            break;

                        case QuestionType.Emoji:
                            <label>Emoji's <input class="emoji-input" @bind="_text" @bind:event="oninput" @bind:after="Touch" placeholder="🇧🇪👑🧤" /></label>
                            <div class="row-2">
                                <label>Antwoord <input @bind="_answer" @bind:event="oninput" @bind:after="Touch" /></label>
                                <label>Soort
                                    <select @bind="_kind" @bind:after="Touch"><option value="speler">Speler</option><option value="club">Club</option></select>
                                </label>
                            </div>
                            <label>Ook goed als antwoord <input @bind="_aliases" @bind:after="Touch" /></label>
                            <label>Uitleg per emoji (na afloop getoond) <input @bind="_explanation" @bind:after="Touch" /></label>
                            break;

                        case QuestionType.Opstelling:
                            <div class="row-2">
                                <label>Wedstrijd <input @bind="_text" @bind:event="oninput" @bind:after="Touch" placeholder="België – Brazilië, WK 2018 (2-1)" /></label>
                                <label>Ploeg <input @bind="_answer" @bind:after="Touch" placeholder="België" /></label>
                            </div>
                            <div class="field-label">Basiself (positie K = keeper, V = verdediger, M = middenvelder, A = aanvaller)</div>
                            @for (var i = 0; i < 11; i++)
                            {
                                var index = i;
                                <div class="lineup-edit">
                                    <select @bind="_positions[index]" @bind:after="Touch"><option>K</option><option>V</option><option>M</option><option>A</option></select>
                                    <input @bind="_names[index]" @bind:event="oninput" @bind:after="Touch" placeholder="Naam" />
                                    <input @bind="_nameAliases[index]" @bind:after="Touch" placeholder="Ook goed (bv. achternaam)" />
                                </div>
                            }
                            break;

                        case QuestionType.Wissel:
                            <div class="row-2">
                                <label>Speler <input @bind="_answer" @bind:event="oninput" @bind:after="Touch" placeholder="Bv. Eden Hazard" /></label>
                                <label>Ook goed als antwoord <input @bind="_aliases" @bind:after="Touch" placeholder="Bv. Hazard" /></label>
                            </div>
                            <p class="muted">De feiten verschijnen in deze volgorde, één per stap.</p>
                            <label>1. Wanneer <input @bind="_when" @bind:event="oninput" @bind:after="Touch" placeholder="Zomer 2019" /></label>
                            <label>2. Bedrag <input @bind="_fee" @bind:event="oninput" @bind:after="Touch" placeholder="Ruim €100 miljoen" /></label>
                            <div class="row-2">
                                <label>3. Van <input @bind="_from" @bind:event="oninput" @bind:after="Touch" placeholder="Chelsea" /></label>
                                <label>4. Naar <input @bind="_to" @bind:event="oninput" @bind:after="Touch" placeholder="Real Madrid" /></label>
                            </div>
                            <label>5. Extra tip (zonder naam) <input @bind="_extra" @bind:event="oninput" @bind:after="Touch" /></label>
                            break;

                        case QuestionType.Rugnummer:
                            <div class="row-2">
                                <label>Speler <input @bind="_answer" @bind:event="oninput" @bind:after="Touch" placeholder="Bv. Kevin De Bruyne" /></label>
                                <label>Ook goed als antwoord <input @bind="_aliases" @bind:after="Touch" placeholder="Bv. De Bruyne, KDB" /></label>
                            </div>
                            <div class="row-2">
                                <label>Rugnummer <input type="number" min="1" max="99" @bind="_number" @bind:after="Touch" /></label>
                                <label>Positie <input @bind="_position" @bind:event="oninput" @bind:after="Touch" placeholder="Middenvelder" /></label>
                            </div>
                            <div class="row-2">
                                <label>Land <input @bind="_country" @bind:event="oninput" @bind:after="Touch" placeholder="België" /></label>
                                <label>Club (met jaartallen) <input @bind="_club" @bind:event="oninput" @bind:after="Touch" placeholder="Manchester City (2015–2025)" /></label>
                            </div>
                            <label>Extra tip (zonder naam) <input @bind="_extra" @bind:event="oninput" @bind:after="Touch" /></label>
                            break;

                        case QuestionType.Fiche:
                            <div class="row-2">
                                <label>Speler <input @bind="_answer" @bind:event="oninput" @bind:after="Touch" placeholder="Bv. Jan Vertonghen" /></label>
                                <label>Ook goed als antwoord <input @bind="_aliases" @bind:after="Touch" placeholder="Bv. Vertonghen" /></label>
                            </div>
                            <div class="row-2">
                                <label>1. Lengte (cm) <input type="number" min="@QuestionRules.FicheMinHeight" max="@QuestionRules.FicheMaxHeight" @bind="_height" @bind:after="Touch" /></label>
                                <label>2. Geboortejaar <input type="number" min="@QuestionRules.FicheMinBirthYear" max="@QuestionRules.FicheMaxBirthYear" @bind="_birthYear" @bind:after="Touch" /></label>
                            </div>
                            <label>3. Positie <input @bind="_position" @bind:event="oninput" @bind:after="Touch" placeholder="Centrale verdediger" /></label>
                            <div class="row-2">
                                <label>4. Interlands <input type="number" min="0" @bind="_caps" @bind:after="Touch" /></label>
                                <label>4. Interlandgoals <input type="number" min="0" @bind="_goals" @bind:after="Touch" /></label>
                            </div>
                            <div class="row-2">
                                <label>5. Nationaliteit <input @bind="_country" @bind:event="oninput" @bind:after="Touch" placeholder="België" /></label>
                                <label>6. Laatste of huidige club <input @bind="_club" @bind:event="oninput" @bind:after="Touch" placeholder="RSC Anderlecht" /></label>
                            </div>
                            <label>Peildatum interlands en club (enkel bij een actieve speler; leeg = gestopt) <input type="date" @bind="_asOf" @bind:after="Touch" /></label>
                            break;

                        case QuestionType.Mannetje:
                            <div class="row-2">
                                <label>Speler <input @bind="_answer" @bind:event="oninput" @bind:after="Touch" /></label>
                                <label>Ook goed als antwoord <input @bind="_aliases" @bind:after="Touch" /></label>
                            </div>
                            <div class="row-icon">
                                <Avatar Id="@_avatar" Size="64" />
                                <label class="grow">Avatar
                                    <select @bind="_avatar" @bind:after="Touch">
                                        @if (!Avatars.All.Any(a => a.Id == _avatar)) { <option value="@_avatar">Eigen avatar (@_avatar)</option> }
                                        @foreach (var a in Avatars.All) { <option value="@a.Id">@a.Name</option> }
                                    </select>
                                </label>
                            </div>
                            <label>Tips na het mannetje (één per lijn, minstens 2, zonder naam)
                                <textarea rows="3" @bind="_lines" @bind:event="oninput" @bind:after="Touch"></textarea>
                            </label>
                            break;

                        case QuestionType.Volgorde:
                            <label>Opdracht <input @bind="_text" @bind:event="oninput" @bind:after="Touch" placeholder="Bv. Van oud naar jong: wie werd het eerst geboren?" /></label>
                            <p class="muted">Zet de kaartjes in de juiste volgorde (1 = eerst). De speler ziet ze door elkaar; de waarde verschijnt pas na afloop.</p>
                            @for (var i = 0; i < QuestionRules.VolgordeCards; i++)
                            {
                                var index = i;
                                <div class="row-2">
                                    <label>@(index + 1). Kaartje <input @bind="_options[index]" @bind:event="oninput" @bind:after="Touch" placeholder="Bv. Kevin De Bruyne" /></label>
                                    <label>Waarde <input @bind="_values[index]" @bind:event="oninput" @bind:after="Touch" placeholder="Bv. 28 juni 1991" /></label>
                                </div>
                            }
                            break;

                        case QuestionType.Krant:
                            var article = KrantText.Parse(_lines);
                            <div class="row-2">
                                <label>Soort
                                    <select @bind="_krantKind" @bind:after="Touch">
                                        <option value="verslag">Matchverslag</option><option value="interview">Interview</option><option value="dossier">Dossier</option>
                                    </select>
                                </label>
                                <label>Kop (zonder antwoorden) <input @bind="_text" @bind:event="oninput" @bind:after="Touch" placeholder="Van 0-2 naar 3-2" /></label>
                            </div>
                            <label>Intro (optioneel, zonder gaten) <input @bind="_explanation" @bind:event="oninput" @bind:after="Touch" placeholder="Achtste finale WK 2018 · België – Japan" /></label>
                            <p class="muted">
                                Zet elk gat tussen dubbele haken: <code>[[Jan Vertonghen / Vertonghen : speler]]</code> (eerst het antwoord, dan wat ook
                                goed is, na de dubbele punt de hint), of een getal: <code>[[#69 : minuut]]</code>, met een stap voor deelpunten:
                                <code>[[#115~5 : miljoen euro]]</code>. Een lege lijn begint een nieuwe alinea.
                                Tip: de tekst rond een gat mag het antwoord van een ander gat niet verraden.
                            </p>
                            <label>Artikel <textarea rows="14" @bind="_lines" @bind:event="oninput" @bind:after="Touch"></textarea></label>
                            <p class="muted">@article.Gaps.Count van de @QuestionRules.KrantGaps gaten · klok @QuestionRules.KrantSeconds seconden</p>
                            @foreach (var problem in article.Problems) { <p class="error">@problem</p> }
                            <KrantArticle Headline="@_text" Intro="@_explanation" Kind="@_krantKind" Reveal="true"
                                          Paragraphs="Preview(article)" />
                            break;

                        case QuestionType.Lijst:
                            var lijst = ParseList(_lines);
                            <p class="muted">
                                Een lijst als JSON: <code>question</code>, <code>rows</code> (in volgorde, elk met een <code>label</code> zoals een jaartal
                                en een <code>answer</code>, of zonder answer een <code>note</code> zoals "niet uitgereikt") en <code>names</code> (elke naam
                                één keer, met <code>aliases</code>). Een naam die in meerdere rijen staat, vult ze allemaal en telt één keer.
                            </p>
                            <label>Lijst (JSON) <textarea rows="20" style="font-family: var(--digits)" @bind="_lines" @bind:event="oninput" @bind:after="Touch"></textarea></label>
                            @if (lijst is null)
                            {
                                @if (!string.IsNullOrWhiteSpace(_lines)) { <p class="error">Geen geldige JSON.</p> }
                            }
                            else
                            {
                                <p class="muted">@lijst.Names.Count namen, @lijst.Rows.Count rijen · klok @QuestionRules.LijstSeconds seconden</p>
                                <LijstGrid Slots="@(lijst.Rows.Select(r => new LijstSlot(r.Label, r.Answer ?? r.Note, r.Answer is not null)).ToList())" />
                            }
                            break;

                        case QuestionType.Detective:
                            var zaak = ParseCase(_lines);
                            <p class="muted">
                                Een zaak als JSON: <code>title</code>, <code>intro</code>, <code>suspects</code> (@QuestionRules.DetectiveMinSuspects tot
                                @QuestionRules.DetectiveMaxSuspects, elk met <code>key</code>, <code>name</code>, <code>card</code>), <code>culprit</code> (een key),
                                <code>clues</code> (@QuestionRules.DetectiveMinClues tot @QuestionRules.DetectiveMaxClues, van vaag naar scherp, elk met
                                <code>text</code>, <code>excludes</code> en per uitgesloten verdachte een <code>explain</code>) en <code>solution</code>.
                                De eerste @QuestionRules.DetectiveOpenAtStart verklaringen staan open bij de start. "Speelde voor" = minstens één officiële
                                wedstrijd, een uitleenbeurt telt mee.
                            </p>
                            @if (string.IsNullOrWhiteSpace(_lines))
                            {
                                <button type="button" class="btn" @onclick="CaseTemplate">Begin met een leeg sjabloon</button>
                            }
                            <label>Zaak (JSON) <textarea rows="20" style="font-family: var(--digits)"@bind="_lines" @bind:event="oninput" @bind:after="Touch"></textarea></label>
                            @if (zaak is null)
                            {
                                @if (!string.IsNullOrWhiteSpace(_lines)) { <p class="error">Geen geldige JSON.</p> }
                            }
                            else
                            {
                                @* Wat de speler na elke verklaring nog overhoudt; de server controleert de regels bij het opslaan. *@
                                var left = zaak.Suspects.Select(s => s.Key).ToList();
                                <ol class="muted">
                                    @foreach (var c in zaak.Clues)
                                    {
                                        left = left.Except(c.Excludes ?? []).ToList();
                                        <li>@c.Text → sluit uit: @string.Join(", ", c.Excludes ?? []) · over: @string.Join(", ", left)</li>
                                    }
                                </ol>
                                @if (left.Count != 1 || left[0] != zaak.Culprit)
                                {
                                    <p class="error">Na alle verklaringen moet enkel de dader (@zaak.Culprit) overblijven.</p>
                                }
                            }
                            break;

                        case QuestionType.Kaart:
                            @* Alleen-lezen: de spelden pas je aan in Data/questions/kaart.json. Moeilijkheid, bronnen, thema's en status kunnen hier wel. *@
                            @if (_kaart is null)
                            {
                                <p class="note"><Icon Name="warning" /> Nieuwe kaarten voeg je toe in <code>Data/questions/kaart.json</code>.</p>
                            }
                            else
                            {
                                <p><b>@_kaart.Question</b></p>
                                <p class="muted">@(KaartProjection.Find(_kaart.Land)?.Naam ?? _kaart.Land) · @_kaart.Competition @_kaart.Season · @_kaart.Pins.Count spelden · @_kaart.Pins.Sum(p => p.Clubs.Count) clubs. De spelden pas je aan in <code>Data/questions/kaart.json</code>.</p>
                                <LandKaart Land="@_kaart.Land" Pins="KaartPreview()" />
                                <ul class="kaart-admin-list">
                                    @foreach (var p in _kaart.Pins)
                                    {
                                        <li><b>@string.Join(" en ", p.Clubs)</b> <small class="muted">@p.Stadium, @p.City (@p.Lat.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture), @p.Lon.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture))</small></li>
                                    }
                                </ul>
                            }
                            break;
                    }

                    <label>Moeilijkheid
                        <select @bind="_difficulty" @bind:after="Touch">
                            @foreach (var (value, label) in Difficulty.Levels) { <option value="@value">@Difficulty.Stars(value) @label</option> }
                        </select>
                    </label>
                </section>

                <section class="card stack">
                    <h2>Bronnen en thema's</h2>
                    @if (_sources.Count > 0)
                    {
                        <ul class="source-list">
                            @foreach (var s in _sources.ToList())
                            {
                                <li><a href="@s" target="_blank" rel="noopener">@s</a>
                                    <button class="linkish" @onclick="() => { _sources.Remove(s); Touch(); }">✕</button></li>
                            }
                        </ul>
                    }
                    <div class="add-source">
                        <input @bind="_newSource" @bind:event="oninput" placeholder="Plak een link (https://…)" />
                        <button class="btn" @onclick="AddSource" disabled="@(!Uri.TryCreate(_newSource.Trim(), UriKind.Absolute, out _))">Toevoegen</button>
                    </div>
                    <div class="tag-toggle">
                        @foreach (var (key, label) in PlayerTags.All)
                        {
                            var k = key;
                            <button class="@(_tags.Contains(k) ? "on" : "")" title="@label" @onclick="() => ToggleTag(k)">@AdminSpelers.TagChip(k)</button>
                        }
                    </div>
                    <label>Notitie <input @bind="_note" @bind:after="Touch" /></label>
                    @if (_type != QuestionType.Fiche)
                    {
                        @* Bij een spelersfiche staat de peildatum bij de fichevelden. *@
                        <label>Peildatum <small class="muted">(enkel als de vraag kan verouderen: een record, "stand na seizoen …", een actieve speler; leeg = tijdloos)</small>
                            <input type="date" @bind="_asOf" @bind:after="Touch" />
                        </label>
                    }
                    @if (QuestionRules.IsStale(_asOf, DateOnly.FromDateTime(DateTime.Today)))
                    {
                        <small class="note"><Icon Name="warning" /> Verouderd: ouder dan @QuestionRules.MaxAgeDays dagen, deze vraag speelt niet tot je ze nakijkt en de peildatum bijwerkt.</small>
                    }
                </section>
            </div>

            <aside class="editor-side">
                <section class="card stack sticky">
                    <div class="side-status">
                        <span class="pill @AdminSpelers.StatusCss(status)">@AdminSpelers.StatusLabel(status)</span>
                        @if (_dirty) { <span class="unsaved">● Niet opgeslagen</span> }
                    </div>
                    @if (_original is not null) { <small class="muted">@_original.TimesUsed× gevraagd</small> }
                    @if (_original?.InPlay is { } live)
                    {
                        <p class="in-play" role="status"><Icon Name="warning" /> Deze vraag zit nu in @live. Aanpassen mag, maar wie ze nog speelt, ziet je wijziging meteen.</p>
                    }
                    <ul class="checklist">
                        <li class="@(complete ? "ok" : "todo")">@(complete ? "✓ Inhoud volledig" : "✗ " + string.Join(" ", Missing()))</li>
                        <li class="@(_sources.Count > 0 ? "ok" : "todo")">@(_sources.Count > 0 ? "✓" : "✗") Minstens één bron</li>
                    </ul>
                    @if (_error is not null) { <p class="error">@_error</p> }
                    @if (_message is not null) { <p class="success">@_message</p> }
                    <button class="btn primary" @onclick="() => SaveAsync(status)" disabled="@(_busy || !complete)">Opslaan</button>
                    @if (status != PlayerStatus.Approved)
                    {
                        <button class="btn approve" @onclick="() => SaveAsync(PlayerStatus.Approved)" disabled="@(_busy || !complete || _sources.Count == 0)">Opslaan en goedkeuren</button>
                    }
                    @if (status != PlayerStatus.Rejected && Id != 0)
                    {
                        <button class="btn danger" @onclick="() => SaveAsync(PlayerStatus.Rejected)" disabled="@_busy">Afwijzen</button>
                    }
                </section>
            </aside>
        </div>
    }
</AdminGuard>

@code {
    [Parameter] public int Id { get; set; }

    private QuizItemEdit? _original;
    private QuestionType _type = QuestionType.Snelvuur;
    private string _text = "", _answer = "", _aliases = "", _explanation = "", _lines = "", _kind = "speler", _krantKind = "verslag", _newSource = "";
    private string? _note;
    private int _difficulty = Difficulty.Default, _correct, _year = 2010, _number = 10;
    // Spelersfiche
    private int _height = 180, _birthYear = 1990, _caps, _goals;
    private DateOnly? _asOf;
    private string _when = "", _fee = "", _from = "", _to = "", _extra = "", _position = "", _country = "", _club = "", _avatar = Avatars.All[0].Id;
    private List<string> _options = ["", "", "", ""];
    private List<string> _values = ["", "", "", ""];
    private string[] _positions = new string[11], _names = new string[11], _nameAliases = new string[11];
    private List<string> _sources = [];
    private HashSet<string> _tags = [];
    private bool _loaded, _busy, _dirty;
    private string? _error, _loadError, _message;

    private static readonly string[] DefaultPositions = ["K", "V", "V", "V", "V", "M", "M", "M", "A", "A", "A"];

    protected override async Task OnParametersSetAsync()
    {
        if (Auth.User?.IsAdmin != true) return;
        (_error, _message, _dirty, _loaded) = (null, null, false, false);
        _positions = [.. DefaultPositions];
        _names = Enumerable.Repeat("", 11).ToArray();
        _nameAliases = Enumerable.Repeat("", 11).ToArray();
        try
        {
            if (Id == 0)
            {
                var type = System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query)["type"];
                _type = Enum.TryParse<QuestionType>(type, out var t) && !QuestionTypes.Get(t).FromPlayers ? t : QuestionType.Snelvuur;
                _original = null;
            }
            else
            {
                var q = _original = await Api.GetQuizItemAsync(Id);
                _type = q.Type;
                (_difficulty, _note, _asOf) = (q.Difficulty, q.ReviewNote, q.AsOf);
                _sources = [.. q.Sources];
                _tags = [.. q.Tags];
                Load(q.Data);
            }
            _loaded = true;
        }
        catch (ApiException ex) { _loadError = ex.Message; }
    }

    private static readonly System.Text.Json.JsonSerializerOptions Json = new(System.Text.Json.JsonSerializerDefaults.Web);

    private void Load(string data)
    {
        switch (_type)
        {
            case QuestionType.Snelvuur:
                var s = System.Text.Json.JsonSerializer.Deserialize<SnelvuurData>(data, Json)!;
                (_text, _options, _correct) = (s.Question, [.. s.Options], s.Correct);
                break;
            case QuestionType.NietBij:
                var n = System.Text.Json.JsonSerializer.Deserialize<NietBijData>(data, Json)!;
                (_text, _options, _correct, _explanation) = (n.Prompt, [.. n.Options], n.Odd, n.Explanation);
                break;
            case QuestionType.Jaar:
                var j = System.Text.Json.JsonSerializer.Deserialize<JaarData>(data, Json)!;
                (_text, _year) = (j.Event, j.Year);
                break;
            case QuestionType.Carriere:
                var c = System.Text.Json.JsonSerializer.Deserialize<CarriereData>(data, Json)!;
                (_answer, _aliases, _lines) = (c.Answer, string.Join(", ", c.Aliases), string.Join("\n", c.Clubs));
                break;
            case QuestionType.Emoji:
                var e = System.Text.Json.JsonSerializer.Deserialize<EmojiData>(data, Json)!;
                (_text, _answer, _aliases, _kind, _explanation) = (e.Emojis, e.Answer, string.Join(", ", e.Aliases), e.Kind, e.Explanation);
                break;
            case QuestionType.Opstelling:
                var o = System.Text.Json.JsonSerializer.Deserialize<OpstellingData>(data, Json)!;
                (_text, _answer) = (o.Title, o.Team);
                for (var i = 0; i < Math.Min(11, o.Players.Count); i++)
                    (_positions[i], _names[i], _nameAliases[i]) = (o.Players[i].Position, o.Players[i].Name, string.Join(", ", o.Players[i].Aliases));
                break;
            case QuestionType.Wissel:
                var w = System.Text.Json.JsonSerializer.Deserialize<WisselData>(data, Json)!;
                (_answer, _aliases, _when, _fee, _from, _to, _extra) = (w.Answer, string.Join(", ", w.Aliases), w.When, w.Fee, w.From, w.To, w.Extra);
                break;
            case QuestionType.Rugnummer:
                var r = System.Text.Json.JsonSerializer.Deserialize<RugnummerData>(data, Json)!;
                (_answer, _aliases, _number, _position, _country, _club, _extra) = (r.Answer, string.Join(", ", r.Aliases), r.Number, r.Position, r.Country, r.Club, r.Extra);
                break;
            case QuestionType.Fiche:
                var f = System.Text.Json.JsonSerializer.Deserialize<FicheData>(data, Json)!;
                (_answer, _aliases, _height, _birthYear, _position) = (f.Answer, string.Join(", ", f.Aliases), f.Height, f.BirthYear, f.Position);
                (_caps, _goals, _country, _club, _asOf) = (f.Caps, f.Goals, f.Country, f.Club, f.AsOf);
                break;
            case QuestionType.Mannetje:
                var m = System.Text.Json.JsonSerializer.Deserialize<MannetjeData>(data, Json)!;
                (_answer, _aliases, _avatar, _lines) = (m.Answer, string.Join(", ", m.Aliases), m.Avatar, string.Join("\n", m.Clues));
                break;
            case QuestionType.Volgorde:
                var v = System.Text.Json.JsonSerializer.Deserialize<VolgordeData>(data, Json)!;
                _text = v.Question;
                _options = [.. Enumerable.Range(0, QuestionRules.VolgordeCards).Select(i => v.Items.ElementAtOrDefault(i)?.Label ?? "")];
                _values = [.. Enumerable.Range(0, QuestionRules.VolgordeCards).Select(i => v.Items.ElementAtOrDefault(i)?.Value ?? "")];
                break;
            case QuestionType.Krant:
                var k = System.Text.Json.JsonSerializer.Deserialize<KrantData>(data, Json)!;
                (_krantKind, _text, _explanation, _lines) = (k.Kind, k.Headline, k.Intro, k.Text);
                break;
            case QuestionType.Detective:
                _lines = Pretty(System.Text.Json.JsonSerializer.Deserialize<DetectiveData>(data, Json)!);
                break;
            case QuestionType.Lijst:
                _lines = System.Text.Json.JsonSerializer.Serialize(System.Text.Json.JsonSerializer.Deserialize<LijstData>(data, Json)!, PrettyJson);
                break;
            case QuestionType.Kaart:
                (_raw, _kaart) = (data, System.Text.Json.JsonSerializer.Deserialize<KaartData>(data, Json));
                break;
        }
    }

    private static readonly System.Text.Json.JsonSerializerOptions PrettyJson = new(Json) { WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    private static string Pretty(DetectiveData d) => System.Text.Json.JsonSerializer.Serialize(d, PrettyJson);

    /// <summary>Detectivedag: de zaak uit het tekstvak, of null als het (nog) geen geldige JSON is.</summary>
    private static DetectiveData? ParseCase(string json)
    {
        try { return System.Text.Json.JsonSerializer.Deserialize<DetectiveData>(json, Json) is { Suspects: not null, Clues: not null } d ? d : null; }
        catch (System.Text.Json.JsonException) { return null; }
    }

    /// <summary>Lijst: de lijst uit het tekstvak, of null als het (nog) geen geldige JSON is.</summary>
    private static LijstData? ParseList(string json)
    {
        try { return System.Text.Json.JsonSerializer.Deserialize<LijstData>(json, Json) is { Rows: not null, Names: not null } d ? d : null; }
        catch (System.Text.Json.JsonException) { return null; }
    }

    private void CaseTemplate()
    {
        _lines = Pretty(new DetectiveData("gestolen-trofee", "", "",
            Enumerable.Range(1, QuestionRules.DetectiveMinSuspects).Select(i => new DetectiveSuspect($"verdachte{i}", "", "")).ToList(),
            "verdachte1",
            Enumerable.Range(1, QuestionRules.DetectiveMinClues).Select(_ => new DetectiveClue("", [], new())).ToList(), ""));
        Touch();
    }

    /// <summary>De Krant: het artikel zoals na afloop, met elk antwoord ingevuld.</summary>
    private static List<List<KrantPiece>> Preview(KrantText.Article article) =>
        article.Paragraphs.Select(p => p.Select(s => s.Gap < 0
            ? new KrantPiece(s.Text)
            : new KrantPiece("", s.Gap, article.Gaps[s.Gap].Hint, article.Gaps[s.Gap].Number is not null,
                Answer: article.Gaps[s.Gap].Answer, Score: 1)).ToList()).ToList();

    /// <summary>Kaart: de inhoud zoals ze binnenkwam (alleen-lezen, gaat ongewijzigd terug bij opslaan).</summary>
    private string _raw = "{}";
    private KaartData? _kaart;

    /// <summary>Kaart: alle spelden met hun club(s), zoals na afloop van een kaartdag.</summary>
    private List<KaartPin> KaartPreview() =>
        _kaart?.Pins.Select(p => new KaartPin(p.Lat, p.Lon, KaartPinState.Juist, string.Join(" / ", p.Clubs))).ToList() ?? [];

    private static List<string> Split(string s, char sep) =>
        s.Split(sep, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private string Data() => _type switch
    {
        QuestionType.Snelvuur => Serialize(new SnelvuurData(_text.Trim(), _options.Select(o => o.Trim()).ToList(), _correct)),
        QuestionType.NietBij => Serialize(new NietBijData(_text.Trim(), _options.Select(o => o.Trim()).ToList(), _correct, _explanation.Trim())),
        QuestionType.Jaar => Serialize(new JaarData(_text.Trim(), _year)),
        QuestionType.Carriere => Serialize(new CarriereData(_answer.Trim(), Split(_aliases, ','), Split(_lines, '\n'))),
        QuestionType.Emoji => Serialize(new EmojiData(_text.Trim(), _answer.Trim(), Split(_aliases, ','), _kind, _explanation.Trim())),
        QuestionType.Opstelling => Serialize(new OpstellingData(_text.Trim(), _answer.Trim(),
            Enumerable.Range(0, 11).Select(i => new LineupPlayer(_names[i].Trim(), Split(_nameAliases[i], ','), _positions[i])).ToList())),
        QuestionType.Wissel => Serialize(new WisselData(_answer.Trim(), Split(_aliases, ','), _when.Trim(), _fee.Trim(), _from.Trim(), _to.Trim(), _extra.Trim())),
        QuestionType.Rugnummer => Serialize(new RugnummerData(_answer.Trim(), Split(_aliases, ','), _number, _position.Trim(), _country.Trim(), _club.Trim(), _extra.Trim())),
        QuestionType.Mannetje => Serialize(new MannetjeData(_answer.Trim(), Split(_aliases, ','), _avatar, Split(_lines, '\n'))),
        QuestionType.Fiche => Serialize(new FicheData(_answer.Trim(), Split(_aliases, ','), _height, _birthYear, _position.Trim(), _caps, _goals,
            _country.Trim(), _club.Trim(), _asOf)),
        QuestionType.Volgorde => Serialize(new VolgordeData(_text.Trim(),
            _options.Zip(_values, (label, value) => new VolgordeItem(label.Trim(), value.Trim())).ToList())),
        QuestionType.Krant => Serialize(new KrantData(_krantKind, _text.Trim(), _explanation.Trim(), _lines.Trim())),
        QuestionType.Detective => ParseCase(_lines) is { } d ? Serialize(d) : _lines,
        QuestionType.Kaart => _raw,
        QuestionType.Lijst => ParseList(_lines) is { } l ? Serialize(l) : _lines,
        _ => "{}",
    };

    private static string Serialize<T>(T value) => System.Text.Json.JsonSerializer.Serialize(value, Json);

    /// <summary>Wat er nog ontbreekt (de server controleert dit nog eens).</summary>
    private List<string> Missing()
    {
        var missing = new List<string>();
        switch (_type)
        {
            case QuestionType.Snelvuur or QuestionType.NietBij:
                if (string.IsNullOrWhiteSpace(_text)) missing.Add("Vraag ontbreekt.");
                if (_options.Any(string.IsNullOrWhiteSpace)) missing.Add("Vul alle 4 opties in.");
                break;
            case QuestionType.Jaar:
                if (string.IsNullOrWhiteSpace(_text)) missing.Add("Gebeurtenis ontbreekt.");
                if (_text.Contains(_year.ToString())) missing.Add("Het jaartal staat in de tekst.");
                break;
            case QuestionType.Carriere:
                if (string.IsNullOrWhiteSpace(_answer)) missing.Add("Speler ontbreekt.");
                if (Split(_lines, '\n').Count < 3) missing.Add("Minstens 3 clubs.");
                break;
            case QuestionType.Emoji:
                if (string.IsNullOrWhiteSpace(_text) || string.IsNullOrWhiteSpace(_answer)) missing.Add("Emoji's en antwoord invullen.");
                break;
            case QuestionType.Opstelling:
                if (string.IsNullOrWhiteSpace(_text)) missing.Add("Titel ontbreekt.");
                if (_names.Any(string.IsNullOrWhiteSpace)) missing.Add("Vul alle 11 spelers in.");
                break;
            case QuestionType.Wissel:
                if (new[] { _answer, _when, _fee, _from, _to, _extra }.Any(string.IsNullOrWhiteSpace)) missing.Add("Vul alle velden in.");
                break;
            case QuestionType.Rugnummer:
                if (new[] { _answer, _position, _country, _club, _extra }.Any(string.IsNullOrWhiteSpace)) missing.Add("Vul alle velden in.");
                if (_number is < 1 or > 99) missing.Add("Rugnummer tussen 1 en 99.");
                break;
            case QuestionType.Fiche:
                if (new[] { _answer, _position, _country, _club }.Any(string.IsNullOrWhiteSpace)) missing.Add("Vul alle velden in.");
                if (_height < QuestionRules.FicheMinHeight || _height > QuestionRules.FicheMaxHeight)
                    missing.Add($"Lengte tussen {QuestionRules.FicheMinHeight} en {QuestionRules.FicheMaxHeight} cm.");
                if (_birthYear < QuestionRules.FicheMinBirthYear || _birthYear > QuestionRules.FicheMaxBirthYear)
                    missing.Add($"Geboortejaar tussen {QuestionRules.FicheMinBirthYear} en {QuestionRules.FicheMaxBirthYear}.");
                if (_caps < 0 || _goals < 0) missing.Add("Interlands en goals kunnen niet negatief zijn.");
                break;
            case QuestionType.Mannetje:
                if (string.IsNullOrWhiteSpace(_answer)) missing.Add("Speler ontbreekt.");
                if (Split(_lines, '\n').Count < 2) missing.Add("Minstens 2 tips.");
                break;
            case QuestionType.Volgorde:
                if (string.IsNullOrWhiteSpace(_text)) missing.Add("Opdracht ontbreekt.");
                if (_options.Concat(_values).Any(string.IsNullOrWhiteSpace)) missing.Add($"Vul alle {QuestionRules.VolgordeCards} kaartjes en waarden in.");
                break;
            case QuestionType.Krant:
                if (string.IsNullOrWhiteSpace(_text)) missing.Add("Kop ontbreekt.");
                var gaps = KrantText.Parse(_lines);
                if (gaps.Problems.Count > 0) missing.Add("Een gat is ongeldig.");
                if (gaps.Gaps.Count != QuestionRules.KrantGaps)
                    missing.Add($"Precies {QuestionRules.KrantGaps} gaten nodig.");
                break;
            case QuestionType.Detective:
                if (ParseCase(_lines) is null) missing.Add("De zaak is geen geldige JSON.");
                break;
            case QuestionType.Kaart:
                if (_kaart is null) missing.Add("Voeg kaarten toe in kaart.json.");
                break;
            case QuestionType.Lijst:
                if (ParseList(_lines) is null) missing.Add("De lijst is geen geldige JSON.");
                break;
        }
        return missing;
    }

    private void Touch() => (_dirty, _message) = (true, null);

    private void SetCorrect(int i)
    {
        _correct = i;
        Touch();
    }

    private void ToggleTag(string key)
    {
        if (!_tags.Remove(key)) _tags.Add(key);
        Touch();
    }

    private void AddSource()
    {
        var url = _newSource.Trim();
        if (!Uri.TryCreate(url, UriKind.Absolute, out _)) return;
        if (!_sources.Contains(url)) _sources.Add(url);
        _newSource = "";
        Touch();
    }

    private ConfirmSheet _confirm = null!;

    private async Task SaveAsync(PlayerStatus status)
    {
        if (_original?.InPlay is { } live && !await _confirm.AskAsync("Vraag is in gebruik",
                $"Deze vraag zit nu in {live}. Wie ze nog speelt, ziet je wijziging meteen.", "Toch opslaan", danger: false))
            return;
        (_busy, _error, _message) = (true, null, null);
        try
        {
            var id = await Api.SaveQuizItemAsync(new QuizItemEdit(Id, _type, Data(), _difficulty, [.. _sources], [.. _tags], status, _note, null, null, 0, AsOf: _asOf));
            _dirty = false;
            _message = status == PlayerStatus.Approved ? "Opgeslagen en goedgekeurd." : "Opgeslagen.";
            if (Id == 0) Nav.NavigateTo($"admin/vragen/{id}");
            else _original = await Api.GetQuizItemAsync(id);
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
