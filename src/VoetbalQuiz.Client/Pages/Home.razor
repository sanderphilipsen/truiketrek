@page "/"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthState Auth
@inject GoldenBallState GoldenBall
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Truitje Trek – Voetbalquiz</PageTitle>

@* Geen topbar: bovenaan een begroeting volgens het uur en je avatar met je level; de avatar opent je profiel. *@
<div class="home-top">
    <h1 class="home-hello">@Greeting @Auth.User?.UserName</h1>
    <a href="meldingen" class="bell" aria-label="@(_unread > 0 ? $"Meldingen, {_unread} nieuw" : "Meldingen")">
        <Icon Name="bell" />
        @if (_unread > 0)
        {
            <span class="bell-dot" aria-hidden="true">@(_unread > 9 ? "9+" : _unread)</span>
        }
    </a>
    @if (Auth.User is { } me)
    {
        <a href="profiel" class="who" aria-label="Jouw spelersfiche: @me.UserName, level @me.Level">
            <Avatar Id="@me.AvatarId" User="@me.UserName" Size="40" Decorative="true" />
            <span class="lvl-dot" aria-hidden="true">@me.Level</span>
        </a>
    }
</div>

@* De uitreiking groot over Home, één keer per speler. Niet in een quiz, waar de klok loopt. *@
<GoldenBallCeremony />

@if (GoldenBall.Overview is { Announce: true, Holders.Count: > 0 } gb)
{
    @* De eerste dag van de maand: de Gouden Bal van vorige maand bovenaan, als compacte strook die openklapt. *@
    var mine = gb.Holders.Any(h => h.IsMe);
    <details class="gb-strip @(mine ? "me" : "")">
        <summary>
            <span class="gb-strip-ball" aria-hidden="true"><Icon Name="soccer-ball" /></span>
            <span class="gb-strip-text">
                <b>@gb.Holders[0].Title</b>
                <small>@(mine ? "Jij wint de Gouden Bal!" : string.Join(" & ", gb.Holders.Select(h => h.UserName)))</small>
            </span>
            <span class="gb-strip-chevron" aria-hidden="true">›</span>
        </summary>
        <div class="gb-winners">
            @foreach (var h in gb.Holders)
            {
                <a class="gb-winner" href="speler/@Uri.EscapeDataString(h.UserName)">
                    <Avatar Id="@h.AvatarId" User="@h.UserName" Size="64" />
                    <b>@(h.IsMe ? "Jij!" : h.UserName)</b>
                    <small>@h.Points maandpunten · @StarsText(GoldenBall.StarsOf(h.UserName))</small>
                </a>
            }
        </div>
        @if (mine)
        {
            <p>Proficiat! Een ster op je shirt.</p>
        }
    </details>
}

@foreach (var t in _myTables)
{
    @* Je speelt mee in een partijtje: meteen terug naar je wachtkamer of je lopende wedstrijd. *@
    var running = t.Status == MatchStatus.Running;
    <a class="tafel-banner @(running ? "live" : "")" href="online/@t.Id"
       aria-label="@(running ? $"Je wedstrijd is bezig: {t.Name}. Verder" : $"Je partijtje wacht, {t.Players} van {t.Seats} spelers: {t.Name}. Open")">
        <Icon Name="@(running ? "broadcast" : "users-three")" Class="sb-icon" />
        <span class="tafel-banner-text" aria-hidden="true">
            <b>@(running ? "Je wedstrijd is bezig" : "Je partijtje wacht")</b>
            <small>@t.Name</small>
        </span>
        @if (!running)
        {
            <span class="sb-digits" aria-hidden="true">@t.Players/@t.Seats</span>
        }
        <span class="tafel-banner-go" aria-hidden="true">@(running ? "Verder" : "Open") ›</span>
    </a>
}

@if (ShowIntro)
{
    @* Nieuwe spelers: één regel uitleg; "Meer" klapt de details open, "Begrepen" haalt het blok weg. *@
    <details class="card home-intro">
        <summary>
            <span class="home-intro-line">Hoe sneller je juist bent, hoe meer punten. De klok start zodra je een vraag opent.</span>
            <span class="sb-go" aria-hidden="true">Meer ›</span>
        </summary>
        <ul>
            <li><Icon Name="soccer-ball" Class="sb-icon" /> Elke dag nieuwe vragen. Hoe minder tips je nodig hebt, hoe meer punten.</li>
            <li><Icon Name="warning" Class="sb-icon" /> Een foute gok kost @GameRules.WrongGuessPenalty punten. Even nadenken loont dus.</li>
            <li><Icon Name="trophy" Class="sb-icon" /> De beste van de dag pakt de dagzege, en elke maand gaat er een Gouden Bal naar de top.</li>
        </ul>
        <button type="button" class="btn small" @onclick="HideIntroAsync">Begrepen</button>
    </details>
}

@if (!TopReady)
{
    @* Daily en specials verschijnen samen: zo schuift het kaartje "Nieuw vandaag" de daily nooit opzij nadat die al te zien was. *@
    <div class="card home-daily home-loading" aria-busy="true">
        <div class="skeleton-lines" aria-hidden="true">
            <span class="skeleton skeleton-line short"></span>
            <span class="skeleton skeleton-line"></span>
            <span class="skeleton skeleton-button"></span>
        </div>
        <span class="sr-only" role="status">Daily laden…</span>
    </div>
}
else
{
    @if (HeroSpecial is { } hero)
    {
        @* Startdag van een special: het kaartje "Nieuw vandaag" staat boven de daily. *@
        @SpecialCard(hero, isNew: true)
    }
    @DailyCard()
}

@* Meteen onder de daily: online spelen, zonder kop of uitleg. Open partijtjes (enkel als die er zijn) en de tegel
   "Nieuwe match", iets zwaarder dan de stroken eronder maar zonder geel. Home is de lobby. *@
<section class="home-online" aria-label="Online spelen">
    @* Jouw partijtjes staan als banner bovenaan; hier alle open partijtjes om aan mee te doen (er is geen aparte lobby meer). *@
    <OpenTables ShowMine="false" Compact="true" OnLoaded="l => _myTables = l.Mine" />
    <CreateTableForm UserName="@Auth.User?.UserName" Tile="true" />
</section>

@code {
    // De daily als scorebordtegel: je punten van vandaag, je plaats en je reeks, en één knop naar de volgende stap.
    // Welk vraagtype het is en hoever je bent, zie je pas als je speelt; dat houdt de tegel rustig.
    private RenderFragment DailyCard() => @<section class="card home-daily" aria-labelledby="daily-title">
    @if (_daily is null)
    {
        <h2 id="daily-title" class="sb-label">Daily</h2>
        <div class="block-error" role="alert">
            <p>@_dailyError</p>
            <button type="button" class="btn small" @onclick="RetryDailyAsync" disabled="@_retryingDaily">Opnieuw proberen</button>
        </div>
    }
    else
    {
        var answered = _daily.Questions.Count(q => q.Status == QuestionStatus.Answered);
        var started = _daily.Questions.Any(q => q.Status != QuestionStatus.NotStarted);
        var next = _daily.Questions.FirstOrDefault(q => q.Status != QuestionStatus.Answered);

        <div class="home-daily-head">
            <h2 id="daily-title" class="sb-label">Daily · vandaag</h2>
            @if (answered > 0)
            {
                <span class="sb-digits" role="img" aria-label="@_daily.TotalPoints punten vandaag">@_daily.TotalPoints</span>
            }
        </div>
        @* Je plaats (opent het klassement) en je reeks (opent de statistieken), elk met zijn getal in het label. *@
        <div class="home-daily-facts">
            <a class="home-fact" href="klassement" aria-label="@RankLabel">
                <Icon Name="trophy" Class="sb-icon" />
                <span aria-hidden="true">@RankText</span>
            </a>
            <a class="home-fact" href="statistieken" aria-label="@StreakLabel">
                <Icon Name="flame" Class="sb-icon" />
                <span aria-hidden="true">@StreakText</span>
            </a>
        </div>
        @* De enige gele knop op Home, tenzij de special na de daily de hoofdactie is. *@
        <a class="btn home-daily-play @(SpecialIsMain ? "" : "primary")" href="@(next is null ? "daily" : $"vraag/{next.Number}")">
            @(next is null ? "Bekijk je score" : started ? $"Verder met vraag {next.Number}" : "Start de daily")
            <span aria-hidden="true">›</span>
        </a>
    }
</section>;

    private DailyRank? TodayRank => _rank is { } r && _daily is { } d && r.Date == d.Date ? r : null;
    private string RankText => TodayRank is { Rank: { } p } r ? $"{p}{DutchDates.OrdinalSuffix(p)} van {r.Players}" : "nog geen plaats";
    private string RankLabel => TodayRank is { Rank: { } p } r
        ? $"Klassement: je staat {p}{DutchDates.OrdinalSuffix(p)} van {r.Players} vandaag"
        : "Klassement: nog geen plaats vandaag";

    private int Streak => _rank?.Streak ?? 0;
    private string StreakText => Streak switch { 0 => "start je reeks", 1 => "1 dag op rij", var s => $"{s} dagen op rij" };
    private string StreakLabel => Streak switch
    {
        0 => "Statistieken: nog geen reeks",
        1 => "Statistieken: 1 dag op rij gespeeld",
        var s => $"Statistieken: {s} dagen op rij gespeeld",
    };
}

@if (_specialsError is not null)
{
    <div class="block-error home-special-error" role="alert">
        <p>@_specialsError</p>
        <button type="button" class="btn small" @onclick="RetrySpecialsAsync" disabled="@_retryingSpecials">Opnieuw proberen</button>
    </div>
}
else if (TopReady && ActiveSpecial is { } active && active.Id != HeroSpecial?.Id)
{
    @* Er loopt hooguit één special tegelijk: een kaart over de volle breedte, zonder eigen kop. *@
    @SpecialCard(active, isNew: false)
}

@* Daaronder brede stroken, allemaal in dezelfde vorm: klassement, academie, prijzenkast, instellingen, VAR, persconferentie (FAQ), bestuurskamer. *@
<a class="card sb-strip" href="klassement">
    <Icon Name="trophy" Class="sb-icon" />
    <span class="sb-label">Klassement</span>
    <span class="sb-go" aria-hidden="true">›</span>
</a>
<a class="card sb-strip" href="academie">
    <Icon Name="graduation-cap" Class="sb-icon" />
    <span class="sb-label">Academie</span>
    <span class="sb-go" aria-hidden="true">›</span>
</a>
<a class="card sb-strip" href="badges" aria-label="@BadgesLabel">
    <Icon Name="medal" Class="sb-icon" />
    <span class="sb-label" aria-hidden="true">Prijzenkast</span>
    <span class="sb-digits" aria-hidden="true">@(_badges is { } b ? $"{b.Earned}/{b.Total}" : "–")</span>
    <span class="sb-go" aria-hidden="true">›</span>
</a>
<a class="card sb-strip" href="profiel?tab=account">
    <Icon Name="sliders-horizontal" Class="sb-icon" />
    <span class="sb-label">Instellingen</span>
    <span class="sb-go" aria-hidden="true">›</span>
</a>
@* Voetbalnamen met de gewone naam eronder, zodat ze duidelijk blijven. *@
<a class="card sb-strip" href="feedback" aria-label="Naar de VAR: bug of idee melden">
    <Icon Name="bug" Class="sb-icon" />
    <span class="sb-strip-text" aria-hidden="true">
        <span class="sb-label">Naar de VAR</span>
        <small>Bug of idee melden</small>
    </span>
    <span class="sb-go" aria-hidden="true">›</span>
</a>
<a class="card sb-strip" href="faq" aria-label="Persconferentie: veelgestelde vragen">
    <Icon Name="chat-circle" Class="sb-icon" />
    <span class="sb-strip-text" aria-hidden="true">
        <span class="sb-label">Persconferentie</span>
        <small>Veelgestelde vragen</small>
    </span>
    <span class="sb-go" aria-hidden="true">›</span>
</a>
@if (Auth.User?.IsAdmin == true)
{
    <a class="card sb-strip" href="admin" aria-label="Bestuurskamer: admin">
        <Icon Name="gear-six" Class="sb-icon" />
        <span class="sb-strip-text" aria-hidden="true">
            <span class="sb-label">Bestuurskamer</span>
            <small>Admin</small>
        </span>
        <span class="sb-go" aria-hidden="true">›</span>
    </a>
}

@if (TopReady && UpcomingSpecials.FirstOrDefault() is { } soon)
{
    @* Helemaal onderaan: de eerstvolgende special als één rustige regel; nog niets om op te tikken. *@
    <p class="home-soon-line">
        <span class="sb-label">Binnenkort</span>
        <span><b>@soon.Name</b> · @StartsInText(soon)</span>
    </p>
}

@code {
    private const string IntroHiddenKey = "tt-intro-hidden";

    private DailyOverview? _daily;
    private string? _dailyError;
    private bool _retryingDaily;
    private List<SpecialSummary>? _specials;
    private string? _specialsError;
    private bool _retryingSpecials;
    private DailyRank? _rank;
    private Dictionary<int, List<LeaderboardEntry>> _specialTop = [];
    private List<MatchSummary> _myTables = [];
    private bool _introHidden = true; // pas tonen als zeker is dat de speler ze niet weggeklikt heeft
    private int _unread;

    protected override async Task OnInitializedAsync()
    {
        GoldenBall.Changed += Redraw;
        // Elk blok laadt apart: een fout of trage server raakt enkel dat blok.
        await Task.WhenAll(
            LoadDailyAsync(),
            LoadSpecialsAsync(),
            LoadRankAsync(),
            LoadBadgesAsync(),
            LoadUnreadAsync(),
            LoadIntroAsync(),
            RefreshUserAsync(),
            GoldenBall.EnsureLoadedAsync()); // nieuwe dag: misschien een nieuwe Gouden Bal
    }

    /// <summary>Volgens de klok van het toestel: 's ochtends (vanaf 5 uur), 's middags (vanaf 12 uur), anders 's avonds.</summary>
    private static string Greeting => DateTime.Now.Hour switch
    {
        >= 5 and < 12 => "Goedemorgen",
        >= 12 and < 18 => "Goedemiddag",
        _ => "Goedenavond",
    };

    private async Task LoadDailyAsync()
    {
        try
        {
            _daily = await Api.GetDailyAsync();
            _dailyError = null;
            if (_daily.Questions.Count > 0 && _daily.Questions.All(q => q.Status == QuestionStatus.Answered))
                await RememberIntroHiddenAsync(); // eerste daily gespeeld: de uitleg is niet meer nodig
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _dailyError = ex is ApiException api ? api.Message : "De daily kon niet geladen worden. Controleer je verbinding.";
        }
        StateHasChanged();
    }

    private async Task LoadSpecialsAsync()
    {
        try
        {
            _specials = await Api.GetSpecialsAsync();
            _specialsError = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _specialsError = ex is ApiException api ? api.Message : "De specials konden niet geladen worden.";
        }
        StateHasChanged();
        await LoadSpecialTopAsync();
    }

    private async Task LoadSpecialTopAsync()
    {
        if (ActiveSpecial is not { } sp) return;
        try { _specialTop[sp.Id] = (await Api.GetSpecialLeaderboardAsync(sp.Id)).Entries; }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { }
        StateHasChanged();
    }

    // Verdiende en alle badges voor de strook onderaan; een extraatje (zonder getal blijft de strook gewoon klikbaar).
    private (int Earned, int Total)? _badges;

    private async Task LoadBadgesAsync()
    {
        if (Auth.User is not { } me) return;
        try
        {
            var badges = (await Api.GetPlayerProfileAsync(me.UserName)).Badges;
            _badges = (badges.Count(b => b.Earned), badges.Count);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _badges = null; }
        StateHasChanged();
    }

    private async Task LoadUnreadAsync()
    {
        try { _unread = (await Api.GetNotificationCountAsync()).Unread; }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _unread = 0; }
        StateHasChanged();
    }

    private string BadgesLabel => _badges is { } b ? $"Prijzenkast: {b.Earned} van {b.Total} badges verdiend" : "Prijzenkast";

    /// <summary>De plaats is een extraatje: lukt het niet, dan tonen we ze gewoon niet.</summary>
    private async Task LoadRankAsync()
    {
        try { _rank = await Api.VisitDailyRankAsync(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _rank = null; }
        StateHasChanged();
    }

    private async Task RefreshUserAsync()
    {
        try { await Auth.RefreshAsync(); } // level kan gestegen zijn
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { }
        StateHasChanged();
    }

    private async Task RetryDailyAsync()
    {
        _retryingDaily = true;
        await LoadDailyAsync();
        if (_rank is null) await LoadRankAsync();
        _retryingDaily = false;
    }

    private async Task RetrySpecialsAsync()
    {
        _retryingSpecials = true;
        _specialsError = null;
        _specials = null;
        await LoadSpecialsAsync();
        _retryingSpecials = false;
    }

    // ---------- "Zo werkt het" ----------

    /// <summary>
    /// Enkel voor nieuwe spelers (level 1, want één volledige daily brengt je al naar level 2), zolang de uitleg
    /// niet weggeklikt is en de daily van vandaag nog niet klaar is.
    /// </summary>
    private bool ShowIntro => !_introHidden && Auth.User is { } user && Levels.IsNewcomer(user.Level)
                              && _daily?.Questions.All(q => q.Status == QuestionStatus.Answered) != true;

    private async Task LoadIntroAsync()
    {
        try { _introHidden = await JS.InvokeAsync<string?>("localStorage.getItem", IntroHiddenKey) == "1"; }
        catch (Exception) { _introHidden = false; } // privévenster of geblokkeerde opslag: dan toch tonen
    }

    private async Task HideIntroAsync()
    {
        _introHidden = true;
        await RememberIntroHiddenAsync();
    }

    private async Task RememberIntroHiddenAsync()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", IntroHiddenKey, "1"); }
        catch (Exception) { } // niet bewaard: dan verschijnt ze een volgende keer opnieuw, niet erg
    }

    // ---------- Specials ----------

    /// <summary>Vandaag gestart en nog niet uitgespeeld: de blikvanger bovenaan (de server bepaalt de Belgische dag).</summary>
    private SpecialSummary? HeroSpecial => _specials?.FirstOrDefault(s => s.IsActive && s.StartsToday && !Finished(s));

    /// <summary>De lopende special: er loopt er hooguit één tegelijk.</summary>
    private SpecialSummary? ActiveSpecial => _specials?.FirstOrDefault(s => s.IsActive);

    /// <summary>De lopende special als je hem nog niet uitspeelde: de volgende stap na de daily.</summary>
    private SpecialSummary? NextSpecial => ActiveSpecial is { Finished: false } s ? s : null;

    /// <summary>Daily en specials zijn binnen (of gefaald): pas dan tonen we het bovenste deel, zodat niets meer verspringt.</summary>
    private bool TopReady => (_daily is not null || _dailyError is not null) && (_specials is not null || _specialsError is not null);

    /// <summary>De daily is klaar en de special staat nog open: dan is "Speel" in het special-kaartje de gele hoofdknop.</summary>
    private bool SpecialIsMain => NextSpecial is not null && _daily is { Questions.Count: > 0 } d
                                  && d.Questions.All(q => q.Status == QuestionStatus.Answered);

    /// <summary>
    /// Het special-kaartje met een knop "Speel": bovenaan op de startdag ("Nieuw vandaag"), anders onder de daily.
    /// De knop is donkergroen, of geel als hij de hoofdactie is (zie <see cref="SpecialIsMain"/>).
    /// </summary>
    private RenderFragment SpecialCard(SpecialSummary sp, bool isNew) =>
        @<section class="home-special @(isNew ? "is-new" : "")" aria-labelledby="special-title-@sp.Id">
            @if (sp.Affiche is { } affiche)
            {
                <a class="affiche-link" href="special/@sp.Id" tabindex="-1" aria-hidden="true"><AfficheBanner Affiche="affiche" /></a>
            }
            @* Bovenaan links de naam met daaronder de stand, rechts meteen de top 3; onderaan een brede knop zoals bij de daily. *@
            <div class="card special-card home-special-card @(sp.Affiche is null ? "" : "with-affiche") @(sp.Finished ? "done" : "")">
                <div class="home-special-head">
                    <div class="home-special-text">
                        <h2 id="special-title-@sp.Id" class="home-special-name">@sp.Name</h2>
                        @if (isNew && sp.Answered == 0)
                        {
                            @* Startdag: zegt waarom de special boven de daily staat, in de plaats van "Nog x dagen". *@
                            <small class="home-special-new">Nieuw vandaag</small>
                        }
                        else
                        {
                            <small class="home-special-meta @(sp.Finished ? "is-done" : "")">@SpecialMeta(sp)</small>
                        }
                    </div>
                    @if (_specialTop.TryGetValue(sp.Id, out var top) && top.Count == 0 && !sp.Finished)
                    {
                        <small class="home-special-first">Nog niemand gespeeld. Pak jij goud?</small>
                    }
                    else
                    {
                        <MiniPodium Entries="@top" Href="@($"special/{sp.Id}")" />
                    }
                </div>
                @if (sp.Finished)
                {
                    <a class="btn home-special-play done" href="special/@sp.Id">Bekijk je resultaat</a>
                }
                else
                {
                    <a class="btn home-special-play @(SpecialIsMain ? "primary" : "")" href="special/@sp.Id">@(sp.Answered > 0 ? "Verder met de special" : "Start de special")</a>
                }
            </div>
        </section>;

    /// <summary>Binnenkort: enkel de eerstvolgende special.</summary>
    private List<SpecialSummary> UpcomingSpecials =>
        _specials?.Where(s => s.IsUpcoming).OrderBy(s => s.StartDate).Take(1).ToList() ?? [];

    private static string StartsInText(SpecialSummary s) => s.StartsIn switch
    {
        <= 1 => "morgen",
        var d => $"over {d} dagen",
    };

    private static bool Finished(SpecialSummary s) => s.Finished;

    private static string SpecialMeta(SpecialSummary s) =>
        Finished(s) ? $"✓ {s.MyPoints} punten"
        : s.Answered > 0 ? $"{s.Answered}/{s.QuestionCount} gespeeld"
        : s.DaysLeft switch { 0 => "Laatste dag", 1 => "Nog 1 dag", var d => $"Nog {d} dagen" };

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => GoldenBall.Changed -= Redraw;

    private static string StarsText(int stars) => stars == 1 ? "1 ster" : $"{stars} sterren";
}
