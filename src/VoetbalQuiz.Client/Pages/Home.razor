@page "/"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthState Auth
@inject GoldenBallState GoldenBall
@implements IDisposable

<PageTitle>Truitje Trek – Voetbalquiz</PageTitle>

<section class="home-hello">
    <Avatar Id="@Auth.User?.AvatarId" User="@Auth.User?.UserName" Size="56" />
    <div>
        @* Een lange naam (tot 20 tekens) mag breken, maar het zwaaiende handje blijft bij de naam. *@
        <h1>Hoi @Auth.User?.UserName&nbsp;<span aria-hidden="true">👋</span></h1>
        <span class="lvl">Level @Auth.User?.Level</span>
    </div>
</section>

@foreach (var t in _myTables)
{
    @* Je speelt mee in een partijtje: meteen terug naar je lobby of je lopende wedstrijd. *@
    <a class="tafel-banner" href="online/@t.Id">
        <span class="tafel-banner-icon" aria-hidden="true">@(t.Status == MatchStatus.Running ? "🔴" : "⚔️")</span>
        <span class="tafel-banner-text">
            <b>@(t.Status == MatchStatus.Running ? "Je wedstrijd is bezig" : $"Je partijtje wacht ({t.Players}/{t.Seats})")</b>
            <small>@t.Name</small>
        </span>
        <span class="tafel-banner-go">@(t.Status == MatchStatus.Running ? "Verder" : "Open") ›</span>
    </a>
}

@if (GoldenBall.Overview is { Announce: true, Holders.Count: > 0 } gb)
{
    @* Eerste dag van de maand: de Gouden Bal van vorige maand voor iedereen op het dashboard. *@
    <section class="golden-ball-card @(gb.Holders.Any(h => h.IsMe) ? "me" : "")">
        <div class="gb-ball" aria-hidden="true">⚽</div>
        <div class="gb-title">@gb.Holders[0].Title</div>
        <div class="gb-winners">
            @foreach (var h in gb.Holders)
            {
                <a class="gb-winner" href="speler/@Uri.EscapeDataString(h.UserName)">
                    <Avatar Id="@h.AvatarId" User="@h.UserName" Size="76" />
                    <b>@(h.IsMe ? "Jij!" : h.UserName)</b>
                    <small>@h.Points maandpunten · @StarsText(GoldenBall.StarsOf(h.UserName))</small>
                </a>
            }
        </div>
        @if (gb.Holders.Any(h => h.IsMe))
        {
            <p>Proficiat! Een ster op je shirt.</p>
        }
    </section>
}

@foreach (var sp in _specials.Where(s => s.IsActive))
{
    @if (sp.Affiche is { } affiche)
    {
        <a class="affiche-link" href="special/@sp.Id"><AfficheBanner Affiche="affiche" /></a>
    }
    <a class="card special-card @(sp.Affiche is null ? "" : "with-affiche")" href="special/@sp.Id">
        <span class="special-icon">@sp.Icon</span>
        <div>
            <b>@sp.Name</b>
            <small>@(sp.Answered == 0 ? "Vandaag te spelen" : sp.Answered < GameRules.QuestionsPerDay ? $"{sp.Answered}/{GameRules.QuestionsPerDay} gespeeld" : $"{sp.MyPoints} punten")</small>
            <DifficultyStars Value="sp.Difficulty" />
        </div>
        <span class="btn small primary">@(sp.Answered == 0 ? "Spelen" : "Open")</span>
    </a>
}

<section class="card home-daily">
    <div class="home-card-head">
        <div>
            <div class="date">@(_daily is null ? "" : DutchDates.DayMonth(_daily.Date))</div>
            <h2>Daily challenge</h2>
            @if (_daily is not null)
            {
                <div class="type-banner small">@QuestionTypes.DayLabel(_daily)</div>
                <DifficultyStars Value="_daily.Difficulty" />
            }
        </div>
        @if (_daily is not null)
        {
            <div class="home-score"><b>@_daily.TotalPoints</b><small>punten</small></div>
        }
    </div>

    @if (_daily is null)
    {
        <p class="muted">@if (_error is null) { <Spinner Small="true" /> } else { @_error }</p>
    }
    else
    {
        var answered = _daily.Questions.Count(q => q.Status == QuestionStatus.Answered);
        var next = _daily.Questions.FirstOrDefault(q => q.Status != QuestionStatus.Answered);

        <div class="progress-dots">
            @foreach (var q in _daily.Questions)
            {
                <span class="dot @(q.Correct == true ? "ok" : q.Correct == false ? "fail" : "")"></span>
            }
        </div>

        @if (next is null)
        {
            <p class="done">Klaar voor vandaag.</p>
            <a class="btn" href="daily">Bekijk je dag</a>
        }
        else
        {
            <a class="btn primary big" href="vraag/@next.Number">
                @(answered == 0 ? "Start de daily" : $"Verder met vraag {next.Number}")
            </a>
            <a class="card-link" href="daily">Overzicht ›</a>
        }
    }
</section>

<section class="card">
    <div class="home-card-head">
        <h2>Online spelen</h2>
        <a class="card-link" href="online">Lobby ›</a>
    </div>
    <CreateTableForm UserName="@Auth.User?.UserName" Collapsible="true" />
</section>

@* Jouw partijtjes staan als banner bovenaan; hier enkel de open partijtjes om aan mee te doen. *@
<OpenTables ShowMine="false" OnLoaded="l => _myTables = l.Mine" />

@if (_specials.Any(s => s.IsUpcoming))
{
    <h2 class="section-title">Binnenkort</h2>
    <div class="tables">
        @foreach (var sp in _specials.Where(s => s.IsUpcoming))
        {
            <div class="table-card">
                <span class="table-icon">@sp.Icon</span>
                <div class="table-info"><b>@sp.Name</b><small>@Special.Period(sp)</small></div>
            </div>
        }
    </div>
}

@code {
    private DailyOverview? _daily;
    private List<SpecialSummary> _specials = [];
    private List<MatchSummary> _myTables = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        GoldenBall.Changed += Redraw;
        try
        {
            _daily = await Api.GetDailyAsync();
            _specials = await Api.GetSpecialsAsync();
            await Auth.RefreshAsync(); // level kan gestegen zijn
            await GoldenBall.EnsureLoadedAsync(); // nieuwe dag: misschien een nieuwe Gouden Bal
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => GoldenBall.Changed -= Redraw;

    private static string StarsText(int stars) => stars == 1 ? "1 ster" : $"{stars} sterren";
}
