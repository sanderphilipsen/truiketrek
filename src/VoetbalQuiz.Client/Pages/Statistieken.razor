@page "/statistieken"
@attribute [Authorize]
@inject ApiClient Api
@inject GoldenBallState GoldenBall

<PageTitle>Statistieken – Truitje Trek</PageTitle>
<PageHeader Title="Statistieken" />

<div class="mode-switch">
    <button class="@(_online ? "" : "active")" aria-pressed="@(_online ? "false" : "true")" @onclick="() => _online = false">Daily</button>
    <button class="@(_online ? "active" : "")" aria-pressed="@(_online ? "true" : "false")" @onclick="ShowOnlineAsync">Online</button>
</div>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_online)
{
    @if (_onlineStats is null)
    {
        <div class="center-msg"><Spinner /></div>
    }
    else
    {
        var o = _onlineStats.Me;
        <h2 class="section-title">Jouw cijfers</h2>
        <div class="my-stats">
            <div><b>@o.Played</b><small>wedstrijden</small></div>
            <div><b>@o.Wins</b><small>gewonnen</small></div>
            <div><b>@o.Rating</b><small>rating</small></div>
            <div><b>@(o.Played == 0 ? 0 : (int)Math.Round(100.0 * o.Wins / o.Played))%</b><small>winst</small></div>
        </div>

        <h2 class="section-title">Eregalerij</h2>
        <HallOfFame Cards="_onlineStats.HallOfFame" EmptyText="Nog geen wedstrijden gespeeld." />
    }
}
else if (_stats is null)
{
    <div class="center-msg"><Spinner /></div>
}
else
{
    var me = _stats.Me;

    <h2 class="section-title">Jouw cijfers</h2>
    <div class="my-stats">
        <div><b>@me.DaysPlayed</b><small>@(me.DaysPlayed == 1 ? "dag" : "dagen") gespeeld</small></div>
        <div><b>@me.BestDay</b><small>beste dag</small></div>
        <div><b>@me.CorrectPercent%</b><small>juist geraden</small></div>
        <div><b>@me.CurrentStreak</b><small>@(me.CurrentStreak == 1 ? "dag" : "dagen") op rij</small></div>
    </div>

    <h2 class="section-title">Eregalerij</h2>
    <HallOfFame Cards="_stats.HallOfFame" EmptyText="Nog geen records." />

    @if (GoldenBall.Overview is { History.Count: > 0 } gb)
    {
        <h2 class="section-title">Gouden Ballen</h2>
        <ol class="board">
            @foreach (var m in gb.History)
            {
                <li class="@(m.IsMe ? "me" : "")">
                    <span class="rank">⚽</span>
                    <Avatar Id="@m.AvatarId" User="@m.UserName" Size="38" />
                    <span class="player"><b>@m.UserName</b><small class="cap">@DutchDates.MonthYear(m.Year, m.Month)</small></span>
                    <span class="pts">@m.Points</span>
                </li>
            }
        </ol>
    }

    @if (_stats.Hardest.Count > 0)
    {
        <h2 class="section-title">Moeilijkste spelers</h2>
        <ol class="board">
            @foreach (var h in _stats.Hardest)
            {
                <li>
                    <span class="rank">🤯</span>
                    <span class="player"><b>@h.PlayerName</b><small>@h.Attempts keer gevraagd</small></span>
                    <span class="pts">@h.CorrectPercent%</span>
                </li>
            }
        </ol>
    }
}

@code {
    private StatsOverview? _stats;
    private OnlineStats? _onlineStats;
    private bool _online;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _stats = await Api.GetStatsAsync();
            await GoldenBall.EnsureLoadedAsync();
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task ShowOnlineAsync()
    {
        _online = true;
        try { _onlineStats ??= await Api.GetOnlineStatsAsync(); }
        catch (ApiException ex) { _error = ex.Message; }
    }
}
