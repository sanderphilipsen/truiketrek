@page "/online"
@attribute [Authorize]

<PageTitle>Online – Truitje Trek</PageTitle>

<section class="card">
    <h1>Online spelen</h1>
    <p class="muted">Speel live tegen je vrienden.</p>
    <CreateTableForm UserName="@_me" Collapsible="true" />
</section>

<OpenTables ShowRecent="true" />

@code {
    private string? _me;

    [CascadingParameter] private Task<AuthenticationState>? AuthTask { get; set; }

    protected override async Task OnInitializedAsync() =>
        _me = AuthTask is null ? null : (await AuthTask).User.Identity?.Name;
}
