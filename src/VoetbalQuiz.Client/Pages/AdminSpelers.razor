@page "/admin/spelers"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthState Auth
@inject AdminState State
@inject NavigationManager Nav

<PageTitle>Spelers – Admin</PageTitle>

<AdminGuard>
    <div class="toolbar">
        <div class="segmented">
            <button class="@(State.Status is null ? "on" : "")" @onclick="() => FilterAsync(null)">Alle <small>@Total</small></button>
            <button class="@(State.Status == PlayerStatus.Review ? "on" : "")" @onclick="() => FilterAsync(PlayerStatus.Review)">Te keuren <small>@_counts?.Review</small></button>
            <button class="@(State.Status == PlayerStatus.Approved ? "on" : "")" @onclick="() => FilterAsync(PlayerStatus.Approved)">Goedgekeurd <small>@_counts?.Approved</small></button>
            <button class="@(State.Status == PlayerStatus.Rejected ? "on" : "")" @onclick="() => FilterAsync(PlayerStatus.Rejected)">Afgewezen <small>@_counts?.Rejected</small></button>
        </div>
        <a class="btn primary" href="admin/spelers/0">+ Speler toevoegen</a>
    </div>

    <div class="toolbar">
        <input class="grow" type="search" value="@State.Search" placeholder="🔍 Zoek op naam…"
               @oninput="e => SearchAsync(e.Value?.ToString())" />
        <select value="@State.Tag" @onchange="e => TagAsync(e.Value?.ToString())">
            <option value="">Alle thema's</option>
            @foreach (var (key, label) in PlayerTags.All)
            {
                <option value="@key">@label</option>
            }
        </select>
        <select value="@State.Sort" @onchange="SortChanged">
            <option value="name">Sorteer: naam</option>
            <option value="used">Sorteer: laatst gevraagd</option>
            <option value="checked">Sorteer: laatst gecontroleerd</option>
            <option value="country">Sorteer: land</option>
        </select>
    </div>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
    else if (_players is null)
    {
        <div class="center-msg">Laden…</div>
    }
    else if (_players.Count == 0)
    {
        <div class="card center">
            <p class="muted">
                @(State.Status == PlayerStatus.Review && string.IsNullOrEmpty(State.Search)
                    ? "Er zijn geen spelers te keuren. Alles is nagekeken! 👍"
                    : "Geen spelers gevonden met deze filters.")
            </p>
            <button class="btn" @onclick="ResetAsync">Toon alle spelers</button>
        </div>
    }
    else
    {
        var sorted = Sorted().ToList();
        State.LastListIds = sorted.Select(p => p.Id).ToList();

        <p class="list-count">@sorted.Count spelers</p>
        <div class="player-table">
            <div class="pt-row pt-head">
                <span>Speler</span><span>Status</span><span>Land · competitie</span><span>Thema's</span><span>Gevraagd</span>
            </div>
            @foreach (var p in sorted)
            {
                <a class="pt-row" href="admin/spelers/@p.Id">
                    <span class="pt-name">
                        <b>@p.Name</b>
                        @if (p.ReviewNote is not null) { <small class="note">⚠️ @p.ReviewNote</small> }
                    </span>
                    <span><span class="pill @StatusCss(p.Status)">@StatusLabel(p.Status)</span></span>
                    <span class="pt-meta">@p.Country · @p.Competition@(p.Era == "classic" ? " · klassieker" : "")</span>
                    <span class="pt-tags">
                        @foreach (var t in p.Tags) { <span class="chip">@ShortTag(t)</span> }
                    </span>
                    <span class="pt-meta">@(p.LastUsed is { } d ? $"{p.TimesUsed}× · {d:dd/MM}" : "nog nooit")</span>
                </a>
            }
        </div>
    }
</AdminGuard>

@code {
    private PlayerCounts? _counts;
    private List<PlayerListItem>? _players;
    private string? _error;
    private CancellationTokenSource? _searchDelay;

    private int? Total => _counts is null ? null : _counts.Review + _counts.Approved + _counts.Rejected;

    protected override Task OnInitializedAsync() => Auth.User?.IsAdmin == true ? LoadAsync() : Task.CompletedTask;

    private async Task LoadAsync()
    {
        try
        {
            _counts = await Api.GetPlayerCountsAsync();
            _players = await Api.GetAdminPlayersAsync(State.Status, State.Search, State.Tag);
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task FilterAsync(PlayerStatus? status)
    {
        State.Status = status;
        await LoadAsync();
    }

    private async Task TagAsync(string? tag)
    {
        State.Tag = tag ?? "";
        await LoadAsync();
    }

    private async Task ResetAsync()
    {
        (State.Status, State.Search, State.Tag) = (null, "", "");
        await LoadAsync();
    }

    /// <summary>Zoeken pas na een korte pauze in het typen, niet bij elke letter.</summary>
    private async Task SearchAsync(string? text)
    {
        State.Search = text ?? "";
        _searchDelay?.Cancel();
        _searchDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, _searchDelay.Token);
            await LoadAsync();
        }
        catch (TaskCanceledException) { }
    }

    private void SortChanged(ChangeEventArgs e) => State.Sort = e.Value?.ToString() ?? "name";

    private IEnumerable<PlayerListItem> Sorted() => State.Sort switch
    {
        "used" => _players!.OrderByDescending(p => p.LastUsed ?? DateOnly.MinValue).ThenBy(p => p.Name),
        "checked" => _players!.OrderByDescending(p => p.CheckedAt ?? DateOnly.MinValue).ThenBy(p => p.Name),
        "country" => _players!.OrderBy(p => p.Country).ThenBy(p => p.Name),
        _ => _players!.OrderBy(p => p.Name),
    };

    public static string StatusLabel(PlayerStatus s) => s switch
    {
        PlayerStatus.Approved => "Goedgekeurd",
        PlayerStatus.Rejected => "Afgewezen",
        _ => "Te keuren",
    };

    public static string StatusCss(PlayerStatus s) => s switch
    {
        PlayerStatus.Approved => "active",
        PlayerStatus.Rejected => "rejected",
        _ => "review",
    };

    private static string ShortTag(string key) => key switch
    {
        "champions-league" => "⭐ CL",
        "gouden-schoen" => "👟 Gouden Schoen",
        "rode-duivels" => "🇧🇪 Rode Duivel",
        "kerst" => "🎄 Kerst",
        "nieuwjaar" => "🎆 Nieuwjaar",
        "halloween" => "🎃 Halloween",
        "sinterklaas" => "🎁 Sinterklaas",
        _ => key,
    };

    public static string TagChip(string key) => ShortTag(key);
}
