@page "/vraag/{Number:int}"
@page "/special/{SpecialId:int}/vraag/{Number:int}"
@page "/academie/poging/{RunId:int}/vraag/{Number:int}"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Vraag @Number – Truitje Trek</PageTitle>
<PitchFx Mood="@PitchMood" Teams="_affiche" />
<Sfeer Name="@_theme" />
<ConfirmSheet @ref="_confirm" />

<PageHeader Title="@($"Vraag {Number} / {_total}")" Label="@(_state is null ? null : Info.Name)" BackHref="@OverviewUrl" Up="true" />
@if (RunId is not null)
{
    <p class="training-label"><Icon Name="graduation-cap" /> @TrainingRules.Label</p>
}
@if (_state?.Kamer is { } kamer)
{
    @* Halloween Special: in welke kamer van het Spookhuis deze vraag speelt. *@
    <p class="kamer-chip"><span aria-hidden="true">@kamer.Emoji</span> <span class="kamer-label">Kamer:</span> @kamer.Name</p>
}

@* Altijd aanwezig: schermlezers horen zo het resultaat ("GOAL! Ronaldo, 80 punten") zodra de vraag afgelopen is. *@
<p class="sr-only" role="status">@ResultAnnouncement</p>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
    <a class="btn" href="@OverviewUrl" @onclick="() => Go(OverviewUrl)" @onclick:preventDefault="true">Terug naar overzicht</a>
}
else if (_howTo is { } howTo)
{
    @* Een type dat je op dit toestel nog niet speelde: eerst de uitleg, de klok start pas na "Start". *@
    <section class="card howto" aria-labelledby="howto-title">
        <h2 id="howto-title" class="sb-label">Zo werkt het</h2>
        @foreach (var type in howTo)
        {
            var info = QuestionTypes.Get(type);
            <div class="howto-type">
                <Icon Name="@info.Icon" Class="sb-icon" />
                <div>
                    <b>@info.Name</b>
                    <p>@info.HowTo</p>
                </div>
            </div>
        }
        <p class="muted howto-note">De klok start pas als je op Start tikt.</p>
        <button type="button" class="btn primary big" @onclick="StartAfterHowToAsync">Start <span aria-hidden="true">›</span></button>
    </section>
}
else if (_state is null)
{
    @* Laden in de vorm van het vraagscherm (de klok en de opgave), zodat er niets verspringt als de vraag er is. *@
    <div class="stake question-loading" aria-busy="true">
        <div class="stake-row" aria-hidden="true">
            <span class="skeleton sk-points"></span>
            <span class="skeleton sk-clock"></span>
        </div>
        <div class="timebar" aria-hidden="true"></div>
    </div>
    <div class="card question-loading-body" aria-hidden="true">
        <div class="skeleton-lines">
            <span class="skeleton skeleton-line short"></span>
            <span class="skeleton skeleton-line"></span>
            <span class="skeleton skeleton-line"></span>
        </div>
    </div>
    <span class="sr-only" role="status">Vraag laden…</span>
}
else if (_state.Result is { } result)
{
    @* ---------- Na afloop ---------- *@
    @* Groen bij juist of minstens de helft van de punten; daaronder neutraal (zoals Commentary.Partial), zonder punten rood. *@
    var mood = ResultMood(result, _state.View?.MaxPoints ?? 100);
    <div class="result @mood">
        <div class="result-icon"><Icon Name="@(result.Correct ? "check-circle" : mood == "ok" ? "thumbs-up" : mood == "partial" ? "check" : "x-circle")" /></div>
        <div class="result-shout">@Commentary.ForResult(result, _state.View?.MaxPoints ?? 100, Number)</div>
        <div class="result-name">@QuestionAnswer.Title(_state.Type, result)</div>
        <div class="result-points @(result.Points == 0 ? "zero" : "")">+@result.Points punten</div>
        @if (result.WrongGuesses > 0)
        {
            <div class="muted">@result.WrongGuesses foute @(result.WrongGuesses == 1 ? "poging" : "pogingen")</div>
        }
        @if (_leftScreen)
        {
            <div class="muted"><Icon Name="warning" /> Je verliet de app: daarom stopte de vraag.</div>
        }
        @if (result.Explanation is not null)
        {
            <p class="explanation @(_state.Type is QuestionType.Emoji ? "" : "plain")">@result.Explanation</p>
        }
    </div>

    @* De hoofdactie meteen onder het resultaat, zodat ze zonder scrollen in beeld en onder de duim staat; de tips volgen erna. *@
    @if (Number < _total)
    {
        <a class="btn primary big daily-next" href="@QuestionUrl(Number + 1)" @onclick="() => Go(QuestionUrl(Number + 1))" @onclick:preventDefault="true">Volgende vraag ›</a>
    }
    else
    {
        <a class="btn primary big daily-next" href="@OverviewUrl" @onclick="() => Go(OverviewUrl)" @onclick:preventDefault="true">Bekijk je score</a>
    }

    <QuestionAnswer Type="_state.Type" Result="result" View="_state.View" />
}
else
{
    @* ---------- Tijdens de vraag ---------- *@
    <div class="stake">
        <div class="stake-row">
            <div>
                <span class="stake-points">@QuestionDisplay.PointsNow(_state.Type, _state.View, LocalElapsed, _state.WrongGuesses, _state.TimeLimit)</span>
                <span class="stake-label">@QuestionDisplay.PointsLabel(_state.Type)</span>
            </div>
            @if (_state.Type == QuestionType.Kaart)
            {
                @* Bij de kaart staat "Ik stop" bovenaan: onderaan zit het vaste paneel met de keuzelijsten. *@
                <button class="linkish stake-stop" @onclick="GiveUpAsync" disabled="@_busy">Ik stop</button>
            }
            <div class="clock @(SecondsLeft <= 3 ? "urgent" : "")" role="timer">@Math.Ceiling(SecondsLeft)s</div>
            <span class="sr-only" aria-live="polite">@QuestionDisplay.ClockAnnouncement(SecondsLeft)</span>
        </div>
        <div class="timebar"><div style="width:@QuestionDisplay.Percent(LocalElapsed / _state.TimeLimit)"></div></div>
    </div>

    <QuestionPlay @key="Number" Type="_state.Type" View="_state.View" Hints="_state.Hints" Busy="_busy" SecondsLeft="SecondsLeft" Send="PlayAsync"
                  GiveUp="@(_state.Type == QuestionType.Krant ? GiveUpAsync : null)" />

    @if (_state.Type != QuestionType.Kaart)
    {
        @* Bij de kaart staat "Ik stop" bovenaan (in de stake): onderaan zit het vaste paneel met de keuzelijsten. *@
        <div class="actions">
            <button class="linkish" @onclick="GiveUpAsync" disabled="@_busy">
                @(_state.Type is QuestionType.Opstelling or QuestionType.Krant or QuestionType.Lijst ? "Ik ben klaar"
                    : _state.Type == QuestionType.Counter ? "Ik stop" : _state.Type == QuestionType.Detective ? "Ik geef de zaak op" : "Ik pas")
            </button>
        </div>
    }
    <p class="center light-text leave-note"><Icon Name="warning" /> Blijf in de app: wie ze verlaat, stopt de vraag.</p>
}

@code {
    [Parameter] public int Number { get; set; }

    /// <summary>Ingevuld als je een special speelt; anders is het de daily.</summary>
    [Parameter] public int? SpecialId { get; set; }

    /// <summary>Ingevuld als je een oude daily opnieuw speelt in de academie.</summary>
    [Parameter] public int? RunId { get; set; }

    private string OverviewUrl => RunId is { } run ? $"academie/poging/{run}" : SpecialId is { } id ? $"special/{id}" : "daily";
    private string QuestionUrl(int n) => RunId is { } run ? $"academie/poging/{run}/vraag/{n}"
        : SpecialId is { } id ? $"special/{id}/vraag/{n}" : $"vraag/{n}";
    // Binnen een quiz vervangen we de stap in de geschiedenis: zo is de hele daily één stap en loopt
    // de terugknop van de gsm na afloop niet alle vragen opnieuw af.
    private void Go(string url) => Nav.NavigateTo(url, replace: true);
    private string QuizApi => RunId is { } run ? ApiClient.TrainingRun(run) : ApiClient.Quiz(SpecialId);

    private QuestionState? _state;
    private int _total = GameRules.QuestionsPerDay;
    private string? _error;
    private bool _busy;

    // Lokale klok, gelijkgezet met de server bij elk antwoord van de API.
    private DateTime _syncedAt;
    private double _syncedElapsed;
    private DateTime _lastRefresh;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    /// <summary>"ok" (juist of minstens de helft van de punten), "partial" (wat punten, minder dan de helft) of "fail".</summary>
    private static string ResultMood(AnswerResult r, int maxPoints) =>
        r.Correct || r.Points > 0 && r.Points >= Commentary.AlmostShare * maxPoints ? "ok" : r.Points > 0 ? "partial" : "fail";

    private QuestionTypeInfo Info => QuestionTypes.Get(_state?.Type ?? QuestionType.WieBenIk);
    private double LocalElapsed => _syncedElapsed + (DateTime.UtcNow - _syncedAt).TotalSeconds;
    private double SecondsLeft => Math.Max(0, (_state?.TimeLimit ?? 30) - LocalElapsed);

    // Het veld op de achtergrond: de bal hupt tijdens de vraag; daarna een goal, de paal of over de zijlijn.
    private string? PitchMood => _state switch
    {
        null => null,
        { Result: { } r } => PitchFx.ForResult(r.Correct, r.Points),
        _ => "question",
    };

    // De clubkleuren van een special met een affiche (bv. Anderlecht – Club Brugge), en het thema voor de sfeer (Halloween).
    private Affiche? _affiche;
    private string? _theme;
    private int? _afficheFor;

    private string ResultAnnouncement => _state?.Result is { } r
        ? $"{Commentary.ForResult(r, _state.View?.MaxPoints ?? 100, Number)} {QuestionAnswer.Title(_state.Type, r)}. Plus {r.Points} punten."
        : "";

    // Het overzicht (aantal vragen, types) halen we één keer per quiz: bij "Volgende vraag" enkel nog de vraag zelf.
    private string? _overviewFor;

    /// <summary>De types die we eerst uitleggen, vóór de klok start; null = meteen spelen.</summary>
    private List<QuestionType>? _howTo;
    private const string HowToSeenKey = "tt-howto-seen";

    protected override async Task OnParametersSetAsync()
    {
        // Bij "Volgende vraag" hergebruikt Blazor deze component met een nieuw nummer.
        (_state, _error, _howTo) = (null, null, null);
        _leftScreen = false;
        if (_overviewFor != QuizApi)
        {
            _overviewFor = QuizApi;
            DailyOverview? overview = null;
            var afficheTask = LoadAfficheAsync();
            try { overview = await Api.GetOverviewAsync(QuizApi); _total = overview.Questions.Count; } catch (ApiException) { }
            await afficheTask;
            // Enkel vóór een vraag die nog niet liep: bij een lopende vraag tikt de klok op de server al.
            if (overview?.Questions.FirstOrDefault(q => q.Number == Number) is { Status: QuestionStatus.NotStarted })
            {
                var unseen = await UnseenTypesAsync(QuestionTypes.DayTypes(overview));
                if (unseen.Count > 0)
                {
                    _howTo = unseen;
                    return;
                }
            }
        }
        await StartQuestionAsync();
    }

    private async Task LoadAfficheAsync()
    {
        if (SpecialId == _afficheFor) return;
        _afficheFor = SpecialId;
        try
        {
            var special = SpecialId is { } id ? (await Api.GetSpecialsAsync()).FirstOrDefault(s => s.Id == id) : null;
            (_affiche, _theme) = (special?.Affiche, special?.Theme);
        }
        catch (ApiException) { (_affiche, _theme) = (null, null); }
    }

    private async Task StartQuestionAsync()
    {
        await RunAsync(() => Api.StartAsync(QuizApi, Number));
        StartTimer();
    }

    private async Task StartAfterHowToAsync()
    {
        var shown = _howTo ?? [];
        _howTo = null;
        await RememberSeenAsync(shown);
        await StartQuestionAsync();
    }

    /// <summary>De types die op dit toestel nog nooit uitgelegd werden (een geblokkeerde opslag telt als "nog niet").</summary>
    private async Task<List<QuestionType>> UnseenTypesAsync(IEnumerable<QuestionType> types)
    {
        var seen = await SeenTypesAsync();
        return types.Where(t => !seen.Contains(t.ToString())).ToList();
    }

    private async Task<HashSet<string>> SeenTypesAsync()
    {
        try { return (await JS.InvokeAsync<string?>("localStorage.getItem", HowToSeenKey) ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet(); }
        catch (Exception) { return []; }
    }

    private async Task RememberSeenAsync(IEnumerable<QuestionType> types)
    {
        var seen = await SeenTypesAsync();
        seen.UnionWith(types.Select(t => t.ToString()));
        try { await JS.InvokeVoidAsync("localStorage.setItem", HowToSeenKey, string.Join(',', seen)); }
        catch (Exception) { } // niet bewaard: dan verschijnt de uitleg een volgende keer opnieuw, niet erg
    }

    private DotNetObjectReference<Question>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("truitje.watchLeave", _self); } catch (JSException) { }
    }

    /// <summary>Wie tijdens een vraag de app verlaat (opzoeken!), stopt de vraag: zoals "Ik pas", met de deelpunten tot dan.</summary>
    private bool _leftScreen;

    [JSInvokable]
    public async Task LeftScreen()
    {
        if (_state is not { Status: QuestionStatus.InProgress, Result: null }) return;
        _leftScreen = true;
        await RunAsync(() => Api.GiveUpAsync(QuizApi, Number), busy: true);
    }

    private void StartTimer()
    {
        _cts.Cancel();
        _cts = new CancellationTokenSource();
        _timer?.Dispose();
        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        _ = TickAsync(_timer, _cts.Token);
    }

    private async Task TickAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (_state is not { Status: QuestionStatus.InProgress }) continue;

                // Tijd voor een nieuwe tip/club, of is de tijd om? Dan vragen we de server de echte toestand.
                var needsRefresh = QuestionDisplay.MoreHintsDue(_state.Type, _state.View, _state.Hints.Count, LocalElapsed, _state.TimeLimit)
                                   || LocalElapsed > _state.TimeLimit + GameRules.LatencyGraceSeconds;

                if (needsRefresh && !_busy && DateTime.UtcNow - _lastRefresh > TimeSpan.FromMilliseconds(500))
                {
                    _lastRefresh = DateTime.UtcNow;
                    await RunAsync(() => Api.GetQuestionAsync(QuizApi, Number));
                }
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task<QuestionPlay.Feedback?> PlayAsync(string guess)
    {
        await RunAsync(() => Api.GuessAsync(QuizApi, Number, guess), busy: true);
        return _state is null ? null : new(_state.LastWrongGuess, _state.View, _state.Result is not null);
    }

    private ConfirmSheet _confirm = null!;

    private async Task GiveUpAsync()
    {
        // Een artikel van De Zondag is 250 punten: per ongeluk stoppen kost veel, dus eerst vragen.
        if (_state?.Type == QuestionType.Krant && !await _confirm.AskAsync("Klaar met de krant?",
                "Open gaten tellen dan niet meer mee. Je kan het artikel niet opnieuw spelen.", "Ja, ik ben klaar", danger: false))
            return;
        if (_state?.Type == QuestionType.Lijst && !await _confirm.AskAsync("Klaar met de lijst?",
                "Wat je nu gevonden hebt, telt. Je kan de lijst niet opnieuw spelen.", "Ja, ik ben klaar", danger: false))
            return;
        if (_state?.Type == QuestionType.Detective && !await _confirm.AskAsync("Zaak opgeven?",
                "Je krijgt dan 0 punten en ziet meteen wie de dader was. Je kan de zaak niet opnieuw spelen.", "Ja, geef op"))
            return;
        await RunAsync(() => Api.GiveUpAsync(QuizApi, Number), busy: true);
    }

    private async Task RunAsync(Func<Task<QuestionState>> call, bool busy = false)
    {
        if (busy) _busy = true;
        try
        {
            var state = await call();
            _syncedAt = DateTime.UtcNow;
            _syncedElapsed = state.ElapsedSeconds;
            // De Krant: na afloop terug naar boven, naar de score (je zat ergens midden in het artikel).
            var scrollUp = _state is { Result: null, Type: QuestionType.Krant or QuestionType.Detective } && state.Result is not null;
            _state = state;
            if (scrollUp) await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _timer?.Dispose();
        _ = JS.InvokeVoidAsync("truitje.unwatchLeave").AsTask().ContinueWith(_ => _self?.Dispose());
    }
}
