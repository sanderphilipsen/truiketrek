@page "/vraag/{Number:int}"
@page "/special/{SpecialId:int}/vraag/{Number:int}"
@page "/academie/poging/{RunId:int}/vraag/{Number:int}"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api

<PageTitle>Vraag @Number – Truitje Trek</PageTitle>
<PitchFx Mood="@PitchMood" Teams="_affiche" />

<PageHeader Title="@($"Vraag {Number} / {_total}")" Label="@(_state is null ? null : Info.Name)" BackHref="@OverviewUrl" Up="true" />
@if (RunId is not null)
{
    <p class="training-label">🎓 @TrainingRules.Label</p>
}

@* Altijd aanwezig: schermlezers horen zo het resultaat ("GOAL! Ronaldo, 80 punten") zodra de vraag afgelopen is. *@
<p class="sr-only" role="status">@ResultAnnouncement</p>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
    <a class="btn" href="@OverviewUrl">Terug naar overzicht</a>
}
else if (_state is null)
{
    <div class="center-msg"><Spinner /></div>
}
else if (_state.Result is { } result)
{
    @* ---------- Na afloop ---------- *@
    <div class="result @(result.Correct || result.Points > 0 ? "ok" : "fail")">
        <div class="result-icon">@(result.Correct ? "⚽" : result.Points > 0 ? "👍" : "❌")</div>
        <div class="result-shout">@Commentary.ForResult(result, _state.View?.MaxPoints ?? 100, Number)</div>
        <div class="result-name">@QuestionAnswer.Title(_state.Type, result)</div>
        <div class="result-points @(result.Points == 0 ? "zero" : "")">+@result.Points punten</div>
        @if (result.WrongGuesses > 0)
        {
            <div class="muted">@result.WrongGuesses foute @(result.WrongGuesses == 1 ? "poging" : "pogingen")</div>
        }
        @if (result.Explanation is not null)
        {
            <p class="explanation @(_state.Type is QuestionType.Emoji ? "" : "plain")">@result.Explanation</p>
        }
    </div>

    @* De hoofdactie meteen onder het resultaat, zodat ze zonder scrollen in beeld en onder de duim staat; de tips volgen erna. *@
    @if (Number < _total)
    {
        <a class="btn primary big daily-next" href="@QuestionUrl(Number + 1)">Volgende vraag ›</a>
    }
    else
    {
        <a class="btn primary big daily-next" href="@OverviewUrl">Bekijk je score</a>
    }

    <QuestionAnswer Type="_state.Type" Result="result" View="_state.View" />
}
else
{
    @* ---------- Tijdens de vraag ---------- *@
    <div class="stake">
        <div class="stake-row">
            <div>
                <span class="stake-points">@QuestionDisplay.PointsNow(_state.Type, _state.View, LocalElapsed, _state.WrongGuesses, _state.TimeLimit)</span>
                <span class="stake-label">@QuestionDisplay.PointsLabel(_state.Type)</span>
            </div>
            <div class="clock @(SecondsLeft <= 3 ? "urgent" : "")" role="timer">@Math.Ceiling(SecondsLeft)s</div>
            <span class="sr-only" aria-live="polite">@QuestionDisplay.ClockAnnouncement(SecondsLeft)</span>
        </div>
        <div class="timebar"><div style="width:@QuestionDisplay.Percent(LocalElapsed / _state.TimeLimit)"></div></div>
    </div>

    <QuestionPlay @key="Number" Type="_state.Type" View="_state.View" Hints="_state.Hints" Busy="_busy" SecondsLeft="SecondsLeft" Send="PlayAsync" />

    <div class="actions">
        <button class="linkish" @onclick="GiveUpAsync" disabled="@_busy">
            @(_state.Type == QuestionType.Opstelling ? "Ik ben klaar" : _state.Type == QuestionType.Counter ? "Ik stop" : "Ik pas")
        </button>
    </div>
}

@code {
    [Parameter] public int Number { get; set; }

    /// <summary>Ingevuld als je een special speelt; anders is het de daily.</summary>
    [Parameter] public int? SpecialId { get; set; }

    /// <summary>Ingevuld als je een oude daily opnieuw speelt in de academie.</summary>
    [Parameter] public int? RunId { get; set; }

    private string OverviewUrl => RunId is { } run ? $"academie/poging/{run}" : SpecialId is { } id ? $"special/{id}" : "daily";
    private string QuestionUrl(int n) => RunId is { } run ? $"academie/poging/{run}/vraag/{n}"
        : SpecialId is { } id ? $"special/{id}/vraag/{n}" : $"vraag/{n}";
    private string QuizApi => RunId is { } run ? ApiClient.TrainingRun(run) : ApiClient.Quiz(SpecialId);

    private QuestionState? _state;
    private int _total = GameRules.QuestionsPerDay;
    private string? _error;
    private bool _busy;

    // Lokale klok, gelijkgezet met de server bij elk antwoord van de API.
    private DateTime _syncedAt;
    private double _syncedElapsed;
    private DateTime _lastRefresh;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    private QuestionTypeInfo Info => QuestionTypes.Get(_state?.Type ?? QuestionType.WieBenIk);
    private double LocalElapsed => _syncedElapsed + (DateTime.UtcNow - _syncedAt).TotalSeconds;
    private double SecondsLeft => Math.Max(0, (_state?.TimeLimit ?? 30) - LocalElapsed);

    // Het veld op de achtergrond: de bal hupt tijdens de vraag; daarna een goal, de paal of over de zijlijn.
    private string? PitchMood => _state switch
    {
        null => null,
        { Result: { } r } => PitchFx.ForResult(r.Correct, r.Points),
        _ => "question",
    };

    // De clubkleuren van een special met een affiche (bv. Anderlecht – Club Brugge).
    private Affiche? _affiche;
    private int? _afficheFor;

    private string ResultAnnouncement => _state?.Result is { } r
        ? $"{Commentary.ForResult(r, _state.View?.MaxPoints ?? 100, Number)} {QuestionAnswer.Title(_state.Type, r)}. Plus {r.Points} punten."
        : "";

    protected override async Task OnParametersSetAsync()
    {
        // Bij "Volgende vraag" hergebruikt Blazor deze component met een nieuw nummer.
        (_state, _error) = (null, null);
        try { _total = (await Api.GetOverviewAsync(QuizApi)).Questions.Count; } catch (ApiException) { }
        if (SpecialId != _afficheFor)
        {
            _afficheFor = SpecialId;
            try { _affiche = SpecialId is { } id ? (await Api.GetSpecialsAsync()).FirstOrDefault(s => s.Id == id)?.Affiche : null; }
            catch (ApiException) { _affiche = null; }
        }
        await RunAsync(() => Api.StartAsync(QuizApi, Number));
        StartTimer();
    }

    private void StartTimer()
    {
        _cts.Cancel();
        _cts = new CancellationTokenSource();
        _timer?.Dispose();
        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        _ = TickAsync(_timer, _cts.Token);
    }

    private async Task TickAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (_state is not { Status: QuestionStatus.InProgress }) continue;

                // Tijd voor een nieuwe tip/club, of is de tijd om? Dan vragen we de server de echte toestand.
                var needsRefresh = QuestionDisplay.MoreHintsDue(_state.Type, _state.View, _state.Hints.Count, LocalElapsed, _state.TimeLimit)
                                   || LocalElapsed > _state.TimeLimit + GameRules.LatencyGraceSeconds;

                if (needsRefresh && !_busy && DateTime.UtcNow - _lastRefresh > TimeSpan.FromMilliseconds(500))
                {
                    _lastRefresh = DateTime.UtcNow;
                    await RunAsync(() => Api.GetQuestionAsync(QuizApi, Number));
                }
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task<QuestionPlay.Feedback?> PlayAsync(string guess)
    {
        await RunAsync(() => Api.GuessAsync(QuizApi, Number, guess), busy: true);
        return _state is null ? null : new(_state.LastWrongGuess, _state.View, _state.Result is not null);
    }

    private Task GiveUpAsync() => RunAsync(() => Api.GiveUpAsync(QuizApi, Number), busy: true);

    private async Task RunAsync(Func<Task<QuestionState>> call, bool busy = false)
    {
        if (busy) _busy = true;
        try
        {
            var state = await call();
            _syncedAt = DateTime.UtcNow;
            _syncedElapsed = state.ElapsedSeconds;
            _state = state;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _timer?.Dispose();
    }
}
