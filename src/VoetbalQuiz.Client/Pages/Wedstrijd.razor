@page "/online/{Id:int}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ApiClient Api
@inject RealtimeClient Realtime
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_state?.Name ?? "Wedstrijd") – Truitje Trek</PageTitle>
<PitchFx Mood="@PitchMood()" />

@* Weggaan tijdens een wedstrijd = het partijtje verlaten (en je punten kwijt): eerst bevestigen. *@
<NavigationLock OnBeforeInternalNavigation="OnLeavingPageAsync" ConfirmExternalNavigation="@InGame" />
<ConfirmSheet @ref="_confirm" />

<div class="question-head">
    <a href="" class="back">@(InGame ? "‹ Verlaten" : "‹ Home")</a>
    @if (_state is { Phase: MatchPhase.Question or MatchPhase.Reveal or MatchPhase.Countdown })
    {
        <h1 class="question-title">
            @if (_state.Phase != MatchPhase.Countdown)
            {
                <span class="type-tag">@QuestionTypes.Get(_state.Type).Icon @QuestionTypes.Get(_state.Type).Name</span>
            }
            <span class="q-count">Vraag <b>@Math.Max(1, _state.CurrentNumber)</b> / @_state.TotalQuestions</span>
        </h1>
    }
</div>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}

@if (_state is null)
{
    <div class="center-msg"><Spinner /></div>
}
else
{
    switch (_state.Phase)
    {
        case MatchPhase.Lobby:
            @* De kleedkamer: wie er al is, hoeveel maten er nog nodig zijn en altijd precies één gele hoofdknop.
               Alleen: uitnodigen. Vanaf twee spelers: de organisator geeft de aftrap. *@
            var host = _state.Players.FirstOrDefault(p => p.IsHost);
            var free = _state.Seats - _state.Players.Count;
            var enough = _state.Players.Count >= MatchRules.MinSeats;
            <section class="card kleedkamer" aria-labelledby="kleedkamer-title">
                <p class="kleedkamer-kicker">Kleedkamer</p>
                <h1 id="kleedkamer-title" class="kleedkamer-title">@_state.Name</h1>
                <p class="kleedkamer-meta">
                    <MatchMeta Types="_state.Types" Questions="_state.TotalQuestions" Derby="@(_state.Derby is not null)" />
                </p>

                @* Bij meer dan vier plaatsen kleinere truitjes, zodat uitnodigen of starten op een smal scherm in beeld blijft. *@
                <ul class="kleedkamer-seats @(_state.Seats > 4 ? "many" : "")" aria-label="Plaatsen: @_state.Players.Count van @_state.Seats bezet">
                    @foreach (var p in _state.Players)
                    {
                        @* Nieuwe spelers krijgen een nieuw element (via @key), dus de inloop-animatie speelt enkel bij wie net aanschuift. *@
                        <li @key="@("p:" + p.UserName)" class="kleedkamer-seat taken @(p.IsMe ? "me" : "")">
                            <span class="kleedkamer-avatar">
                                <Avatar Id="@p.AvatarId" User="@p.UserName" Size="@(_state.Seats > 4 ? 40 : 52)" />
                                @if (p.IsHost)
                                {
                                    <span class="kleedkamer-captain" aria-hidden="true">C</span>
                                }
                            </span>
                            <b>@p.UserName</b>
                            <small>@(p.IsHost ? "organisator" : $"Lv {p.Level}")</small>
                        </li>
                    }
                    @for (var i = 0; i < free; i++)
                    {
                        <li @key="@("f:" + i)" class="kleedkamer-seat free">
                            <span class="kleedkamer-avatar"><span class="kleedkamer-plus" aria-hidden="true">+</span></span>
                            <small>Vrij</small>
                        </li>
                    }
                </ul>

                <p class="kleedkamer-status @(enough ? "ready" : "")" role="status" aria-live="polite">@LobbyStatus(free)</p>

                @if (_state.IsHost)
                {
                    @if (!enough)
                    {
                        <TafelDelen Id="Id" Name="@_state.Name" Primary="true" />
                    }
                    else
                    {
                        <button type="button" class="btn primary big kleedkamer-start" @onclick="StartAsync" disabled="@_busy">
                            @(_busy ? "Aftrap…" : "Start de wedstrijd")
                        </button>
                        @if (free > 0)
                        {
                            <TafelDelen Id="Id" Name="@_state.Name" />
                        }
                    }
                }
                else if (_state.IAmIn)
                {
                    <div class="kleedkamer-wait">
                        <span class="kleedkamer-wait-ball" aria-hidden="true">⚽</span>
                        <span>Wachten op de aftrap door <b>@(host?.UserName ?? "de organisator")</b></span>
                    </div>
                    @if (free > 0)
                    {
                        <TafelDelen Id="Id" Name="@_state.Name" />
                    }
                }
                else if (free > 0)
                {
                    <button type="button" class="btn primary big" @onclick="JoinAsync" disabled="@_busy">Aanschuiven</button>
                }
                else
                {
                    <p class="kleedkamer-full">Dit partijtje is volzet. Op Home vind je de andere open partijtjes.</p>
                }

                @if (_state.Derby is not null)
                {
                    <details class="derby-intro">
                        <summary><span><b>🔥 Derby:</b> iedereen krijgt een geheim wapen</span></summary>
                        <span>Bij de aftrap krijgt iedereen één geheim wapen, één keer in te zetten:</span>
                        <ul>
                            @foreach (var w in DerbyRules.All)
                            {
                                @if (w.Weapon == DerbyWeapon.Trump && !_state.Types.Any(DerbyRules.TrumpWorksOn))
                                {
                                    <li class="muted">@w.Icon <s>@w.Name</s>: zit niet in deze derby, want er zijn geen vragen met antwoordopties of een jaartal.</li>
                                }
                                else
                                {
                                    <li>@w.Icon <b>@w.Name</b>: @w.HowTo</li>
                                }
                            }
                        </ul>
                        <small class="muted">Op de eerste en de laatste vraag geldt wapenstilstand.</small>
                    </details>
                }

                @if (_state.IAmIn)
                {
                    <button type="button" class="btn kleedkamer-leave" @onclick="LeaveAsync" disabled="@_busy">
                        @(_state.IsHost ? "Partijtje opheffen" : "Partijtje verlaten")
                    </button>
                }
            </section>
            break;

        case MatchPhase.Countdown:
            @if (_state.Derby?.Events.FirstOrDefault(e => e.Weapon == DerbyWeapon.Wissel) is { } swap)
            {
                <div class="sub-board" role="status">
                    <div class="sub-title">🔁 WISSEL</div>
                    <div class="sub-numbers">
                        <span class="out">@_state.CurrentNumber</span>
                        <span class="in">@_state.CurrentNumber</span>
                    </div>
                    <div class="sub-text">@(swap.ByMe ? "Jij wisselt" : $"{swap.By} wisselt") de vraag. Nieuwe vraag over @Math.Max(1, Math.Ceiling(-LocalElapsed)) s</div>
                </div>
            }
            else if (_state.CurrentNumber <= 1 && _state.Derby?.MyWeapon is { } weapon)
            {
                <div class="countdown">
                    <div>Jouw wapen voor deze derby</div>
                    <div class="weapon-reveal">
                        <span class="wr-icon">@DerbyRules.Get(weapon).Icon</span>
                        <b>@DerbyRules.Get(weapon).Name</b>
                        <small>@DerbyRules.Get(weapon).HowTo</small>
                    </div>
                    <div class="countdown-number small">@Math.Max(1, Math.Ceiling(-LocalElapsed))</div>
                </div>
            }
            else
            {
                <div class="countdown">
                    <div>Klaar?</div>
                    <div class="countdown-number">@Math.Max(1, Math.Ceiling(-LocalElapsed))</div>
                </div>
            }
            <PlayerStrip Players="_state.Players" Marks="Marks" Unpickable="Unpickable" Picking="_picking" OnPick="PickAsync" />
            @if (_state.Derby is { } countdownDerby)
            {
                <DerbyBar Derby="countdownDerby" Phase="_state.Phase" IAmIn="_state.IAmIn" Busy="_busy" Picking="_picking"
                          OnUse="UseWeaponAsync" OnCancel="() => _picking = false" />
            }
            break;

        case MatchPhase.Question:
            <PlayerStrip Players="_state.Players" ShowAnswered="true" Marks="Marks" Unpickable="Unpickable" Picking="_picking" OnPick="PickAsync" />
            @if (_state.Derby is { } derby)
            {
                <DerbyBar Derby="derby" Phase="_state.Phase" IAmIn="_state.IAmIn" Busy="_busy" Picking="_picking"
                          OnUse="UseWeaponAsync" OnCancel="() => _picking = false" />
            }

            <div class="stake">
                <div class="stake-row">
                    <div>
                        <span class="stake-points">@(_state.MyDone ? "✓" : QuestionDisplay.PointsNow(_state.Type, _state.View, LocalElapsed, _state.MyWrongGuesses, _state.TimeLimit))</span>
                        <span class="stake-label">@(_state.MyDone ? "klaar" : $"{QuestionDisplay.PointsLabel(_state.Type)} + positiebonus")</span>
                    </div>
                    <div class="clock @(SecondsLeft <= 5 ? "urgent" : "")" role="timer">@Math.Ceiling(SecondsLeft)s</div>
                    <span class="sr-only" aria-live="polite">@QuestionDisplay.ClockAnnouncement(SecondsLeft)</span>
                </div>
                <div class="timebar"><div style="width:@QuestionDisplay.Percent(LocalElapsed / _state.TimeLimit)"></div></div>
            </div>

            @* Altijd aanwezig, zodat schermlezers je resultaat voorlezen zodra het verschijnt. *@
            <div role="status" aria-live="polite">
                @if (_state.MyCorrect)
                {
                    <div class="result ok small">✅ Juist! Wachten op de anderen…</div>
                }
                else if (_state.MyDone && _state.MyPoints > 0)
                {
                    <div class="result ok small">👍 +@_state.MyPoints punten. Wachten op de anderen…</div>
                }
                else if (_state.MyDone)
                {
                    <div class="result fail small">@(IsChoice(_state.Type) ? "❌ Mis!" : "Je paste.") Wachten op de anderen…</div>
                }
            </div>

            <QuestionPlay @key="_state.CurrentNumber" Type="_state.Type" View="_state.View" Hints="_state.Hints" Busy="_busy"
                          ReadOnly="@(!_state.IAmIn || _state.MyDone)" Send="PlayAsync" />

            @if (_state.IAmIn && !_state.MyDone)
            {
                <div class="actions">
                    <button class="linkish" @onclick="GiveUpAsync" disabled="@_busy">
                        @(_state.Type == QuestionType.Opstelling ? "Ik ben klaar" : _state.Type == QuestionType.Counter ? "Ik stop" : "Ik pas")
                    </button>
                </div>
            }
            break;

        case MatchPhase.Reveal:
            @* Het tussenscherm duurt maar enkele seconden: jouw resultaat, je plaats en de aftelling staan bovenaan,
               de lange tiplijst klapt in onderaan. *@
            var mine = _state.Reveal.FirstOrDefault(r => r.IsMe);
            var revealLeft = Math.Max(0, MatchRules.RevealSeconds - LocalElapsed);
            <div class="result reveal-head @(mine is not null ? "ok" : "fail")">
                <div class="muted">Het was…</div>
                <div class="result-name">@_state.RevealedPlayer</div>
                @if (_state.IAmIn)
                {
                    <div class="reveal-me" role="status">
                        <span>@(mine is null ? "Jij: geen punten" : $"Jij +{mine.Points}")</span>
                        @if (MyPlace is { } place)
                        {
                            <span>Plaats @place van @_state.Players.Count</span>
                        }
                    </div>
                }
                @if (_state.Result?.Explanation is { } explanation && _state.Type is QuestionType.Emoji or QuestionType.NietBij)
                {
                    <p class="explanation">@explanation</p>
                }
                <div class="reveal-next">
                    @(_state.CurrentNumber < _state.TotalQuestions
                        ? $"Volgende vraag over {Math.Ceiling(revealLeft)} s"
                        : "Eindstand komt eraan…")
                </div>
                <div class="timebar" aria-hidden="true"><div style="width:@QuestionDisplay.Percent(revealLeft / MatchRules.RevealSeconds)"></div></div>
            </div>

            @if (_state.Derby?.TrumpOfficial is { } official)
            {
                <div class="trump-verdict">
                    <div>📢 <b>Officieel:</b> @official</div>
                    <div class="muted">Eigenlijk: @_state.Derby.TrumpActual</div>
                </div>
            }

            @if (_state.Derby is { } revealDerby)
            {
                @if (_picking)
                {
                    <PlayerStrip Players="_state.Players" Unpickable="Unpickable" Picking="true" OnPick="PickAsync" />
                }
                <DerbyBar Derby="revealDerby" Phase="_state.Phase" IAmIn="_state.IAmIn" Busy="_busy" Picking="_picking"
                          OnUse="UseWeaponAsync" OnCancel="() => _picking = false" />
            }

            @if (_state.Reveal.Count == 0)
            {
                <div class="card center muted">Niemand scoorde.</div>
            }
            else
            {
                <ol class="board">
                    @foreach (var r in _state.Reveal)
                    {
                        <li class="@(r.IsMe ? "me" : "")">
                            <span class="rank">@Medal(r.Position)</span>
                            <Avatar Id="@r.AvatarId" User="@r.UserName" Size="36" />
                            <span class="player"><b>@r.UserName</b>@if (r.Bonus > 0) {<small>+@r.Bonus positiebonus</small>}</span>
                            <span class="pts">+@r.Points</span>
                        </li>
                    }
                </ol>
            }

            <h2 class="section-title">Tussenstand</h2>
            <Standings Players="_state.Players" />

            @if (_state.Result is { } result)
            {
                <details class="reveal-tips">
                    <summary>@AnswerLabel(_state.Type)</summary>
                    <QuestionAnswer Type="_state.Type" Result="result" View="_state.View" />
                </details>
            }
            break;

        case MatchPhase.Finished:
            var winner = _state.Players.FirstOrDefault(p => p.Rank == 1);
            <section class="card center podium-card">
                <div class="trophy">🏆</div>
                <h1>@(winner?.IsMe == true ? "Jij wint!" : $"{winner?.UserName} wint!")</h1>
                <div class="muted">@_state.Name</div>
                @if (_state.Players.Count(p => !p.Left) < MatchRules.StayersForWin)
                {
                    <small class="muted">Iedereen anders vertrok: dit telt niet als zege voor je rating, reeks of badges.</small>
                }
            </section>
            <Standings Players="_state.Players" />
            @if (_state.Derby?.Report is { Count: > 0 } report)
            {
                <h2 class="section-title">🔥 Derby-rapport</h2>
                <ol class="board derby-report">
                    @foreach (var r in report)
                    {
                        <li class="@(r.IsMe ? "me" : "") @(r.Question is null ? "left" : "")">
                            <span class="rank">@DerbyRules.Get(r.Weapon).Icon</span>
                            <Avatar Id="@r.AvatarId" User="@r.UserName" Size="36" />
                            <span class="player"><b>@r.UserName</b><small>@ReportLine(r)</small></span>
                            @if (r.Effect != 0)
                            {
                                @* Wat je zelf won (gok, diefstal) of verloor (gok) met +/−; wat je anderen kostte met −. *@
                                var gain = r.Weapon is DerbyWeapon.Gokchinees or DerbyWeapon.PropereHanden;
                                <span class="pts">@(gain && r.Effect > 0 ? "+" : "−")@Math.Abs(r.Effect)</span>
                            }
                        </li>
                    }
                </ol>
            }
            <a class="btn primary big" href="">Terug naar Home</a>
            @* Eerst even de eindstand laten zien. *@
            <RewardPopup DelayMs="2500" Kicker="@(winner?.IsMe == true ? "Wat een zege!" : "Wedstrijd gespeeld!")" />
            break;

        case MatchPhase.Cancelled:
            <div class="card center">
                <h1>Partijtje opgeheven</h1>
                <p class="muted">Deze wedstrijd gaat niet (meer) door.</p>
                <a class="btn primary" href="">Naar Home</a>
            </div>
            break;
    }

    @if (_state.Derby is { } effects)
    {
        <DerbyEffects Derby="effects" Phase="_state.Phase" Drift="@((DateTime.UtcNow - _syncedAt).TotalSeconds)" />
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private MatchState? _state;
    private string? _error;
    private bool _busy;

    // Lokale klok, gelijkgezet met de server bij elke nieuwe toestand.
    private DateTime _syncedAt;
    private double _syncedElapsed;
    private DateTime _lastRefresh;
    private PeriodicTimer? _timer;
    private readonly CancellationTokenSource _cts = new();

    private double LocalElapsed => _syncedElapsed + (DateTime.UtcNow - _syncedAt).TotalSeconds;
    private double SecondsLeft => Math.Max(0, (_state?.TimeLimit ?? GameRules.TimeLimitSeconds) - LocalElapsed);

    /// <summary>Types waar je één keer kiest: een foute keuze is meteen "mis".</summary>
    // Het veld op de achtergrond: de bal hupt tijdens het aftellen en de vraag. Zodra jij klaar bent volgt je reactie
    // (goal, paal of over de zijlijn); die blijft staan tijdens de tussenstand, zodat ze niet opnieuw afspeelt.
    private string? _resultMood;

    private string? PitchMood()
    {
        switch (_state?.Phase)
        {
            case MatchPhase.Countdown:
                _resultMood = null;
                return "question";
            case MatchPhase.Question:
                if (!_state.IAmIn) return "question";
                if (!_state.MyDone) { _resultMood = null; return "question"; }
                return _resultMood ??= PitchFx.ForResult(_state.MyCorrect, _state.MyPoints);
            case MatchPhase.Reveal:
                if (!_state.IAmIn) return null;
                return _resultMood ??= _state.Reveal.Any(r => r.IsMe) ? "goal" : "out";
            default:
                return null;
        }
    }

    private static bool IsChoice(QuestionType type) => type is QuestionType.Snelvuur or QuestionType.NietBij or QuestionType.Jaar;

    protected override async Task OnInitializedAsync()
    {
        Realtime.MatchChanged += OnMatchChanged;
        await LoadAsync();
        try { await Realtime.WatchMatchAsync(Id); }
        catch { _error = "Live verbinding mislukt. Ververs de pagina."; }

        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(200));
        _ = TickAsync(_timer, _cts.Token);
    }

    private async Task OnMatchChanged(int id)
    {
        if (id != Id) return;
        await LoadAsync();
    }

    private async Task LoadAsync() => await ApplyAsync(() => Api.GetMatchAsync(Id));

    private async Task ApplyAsync(Func<Task<MatchState>> call, bool busy = false)
    {
        if (busy) _busy = true;
        try
        {
            var state = await call();
            TrackArrival(_state, state);
            _syncedAt = DateTime.UtcNow;
            _syncedElapsed = state.PhaseElapsedSeconds;
            _state = state;
            // Een doelwit kiezen hoort enkel bij een rode kaart of gokchinees die nog niet gebruikt is.
            if (state.Derby is not { MyWeapon: { } w, MyWeaponUsed: false } || !DerbyRules.NeedsTarget(w)) _picking = false;
            _error = null;
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Hertekent de klok en haalt nieuwe tips op als hun tijd gekomen is.</summary>
    private async Task TickAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (_state is null) continue;

                var due = _state.Phase switch
                {
                    MatchPhase.Countdown => LocalElapsed >= 0,
                    MatchPhase.Question => QuestionDisplay.MoreHintsDue(_state.Type, _state.View, _state.Hints.Count, LocalElapsed, _state.TimeLimit)
                                           || LocalElapsed > _state.TimeLimit + 1,
                    MatchPhase.Reveal => LocalElapsed > MatchRules.RevealSeconds + 1,
                    _ => false,
                };
                // Normaal komt er een seintje van de server; dit is het vangnet.
                if (due && !_busy && DateTime.UtcNow - _lastRefresh > TimeSpan.FromMilliseconds(700))
                {
                    _lastRefresh = DateTime.UtcNow;
                    await LoadAsync();
                }
                else if (_state.Phase is MatchPhase.Countdown or MatchPhase.Question or MatchPhase.Reveal)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task<QuestionPlay.Feedback?> PlayAsync(string guess)
    {
        await ApplyAsync(() => Api.MatchGuessAsync(Id, guess), busy: true);
        return _state is null ? null : new(_state.MyLastWrongGuess, _state.View, _state.MyDone);
    }

    private Task GiveUpAsync() => ApplyAsync(() => Api.MatchGiveUpAsync(Id), busy: true);

    // ---------- Derby ----------

    /// <summary>Rode kaart of gokchinees: eerst een tegenstander kiezen in de spelersrij.</summary>
    private bool _picking;

    /// <summary>Per speler de kaartjes bij zijn avatar: 🟥 rood, 💰 omgekocht.</summary>
    private IReadOnlyDictionary<string, string> Marks =>
        (_state?.Derby?.Events ?? [])
            .Where(e => e.Since >= 0 && e.Target is not null && e.Weapon is DerbyWeapon.RodeKaart or DerbyWeapon.PropereHanden)
            .GroupBy(e => e.Target!)
            .ToDictionary(g => g.Key, g => string.Concat(g.Select(e => DerbyRules.Get(e.Weapon).Icon)));

    /// <summary>Wie je niet meer kan kiezen: die heeft dit wapen al tegen zich bij deze vraag.</summary>
    private IReadOnlyCollection<string> Unpickable =>
        _state?.Derby is { MyWeapon: { } weapon } derby
            ? derby.Events.Where(e => e.Weapon == weapon && e.Target is not null).Select(e => e.Target!).ToList()
            : [];

    private async Task UseWeaponAsync()
    {
        if (_state?.Derby?.MyWeapon is { } weapon && DerbyRules.NeedsTarget(weapon))
        {
            _picking = !_picking;
            return;
        }
        await ApplyAsync(() => Api.UseWeaponAsync(Id, null), busy: true);
    }

    private async Task PickAsync(string target)
    {
        _picking = false;
        await ApplyAsync(() => Api.UseWeaponAsync(Id, target), busy: true);
    }

    private static string ReportLine(DerbyReportLine r) => r.Question is not { } q
        ? $"{DerbyRules.Get(r.Weapon).Name}: niet ingezet"
        : r.Weapon switch
        {
            DerbyWeapon.RodeKaart => $"Rood voor {r.Target} bij vraag {q}",
            DerbyWeapon.Trump => $"Trump booster bij vraag {q}",
            DerbyWeapon.BengaalsVuur => $"Bengaals vuur bij vraag {q}",
            DerbyWeapon.Gokchinees => $"Gokte dubbel of niks bij vraag {q}" + (r.Effect < 0 ? " en verloor" : r.Effect > 0 ? " en won" : ""),
            DerbyWeapon.PropereHanden => $"Stal van {r.Target} bij vraag {q}",
            DerbyWeapon.Verlenging => $"Verlenging bij vraag {q}",
            _ => $"Wissel bij vraag {q}",
        };
    private Task StartAsync() => ApplyAsync(() => Api.StartMatchAsync(Id), busy: true);
    private Task JoinAsync() => ApplyAsync(() => Api.JoinMatchAsync(Id), busy: true);

    private ConfirmSheet _confirm = null!;
    private bool _left;

    /// <summary>Je speelt mee aan een lopende wedstrijd: weggaan kost je punten.</summary>
    private bool InGame => !_left && _state is { Status: MatchStatus.Running, IAmIn: true };

    private async Task OnLeavingPageAsync(LocationChangingContext context)
    {
        if (!InGame) return;
        var sure = await _confirm.AskAsync("Wedstrijd verlaten?",
            "Als je de wedstrijd verlaat, verlies je al je punten en eindig je onderaan.", "Toch verlaten");
        if (!sure)
        {
            context.PreventNavigation();
            return;
        }
        try
        {
            await Api.LeaveMatchAsync(Id);
            _left = true;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            context.PreventNavigation();
        }
    }

    private async Task LeaveAsync()
    {
        if (_state is null) return;
        var sure = _state.IsHost
            ? await _confirm.AskAsync("Partijtje opheffen?", "Het verdwijnt uit de open partijtjes en wie al aangeschoven is, moet een ander zoeken.", "Opheffen")
            : await _confirm.AskAsync("Partijtje verlaten?", "Je plaats komt vrij voor iemand anders.", "Verlaten");
        if (!sure) return;
        try
        {
            await Api.LeaveMatchAsync(Id);
            Nav.NavigateTo("");
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    // ---------- Kleedkamer ----------

    /// <summary>Wie net aanschoof (voor de live-melding); weg zodra iemand vertrekt of de wedstrijd begint.</summary>
    private string? _arrival;

    private void TrackArrival(MatchState? old, MatchState state)
    {
        if (old is not { Phase: MatchPhase.Lobby } || state.Phase != MatchPhase.Lobby)
        {
            _arrival = null;
            return;
        }
        var arrived = state.Players.FirstOrDefault(p => !p.IsMe && old.Players.All(o => o.UserName != p.UserName));
        if (arrived is not null) _arrival = arrived.UserName;
        else if (state.Players.Count < old.Players.Count) _arrival = null;
    }

    private string LobbyStatus(int free)
    {
        var count = _state?.Players.Count ?? 0;
        var missing = MatchRules.MinSeats - count;
        var core = missing > 0
            ? $"Nog {missing} {(missing == 1 ? "maat" : "maten")} nodig voor de aftrap"
            : free == 0
                ? "Volzet! Klaar voor de aftrap."
                : $"Klaar voor de aftrap · nog {free} {(free == 1 ? "plaats" : "plaatsen")} vrij";
        return _arrival is null ? core : $"{_arrival} schoof aan! {core}";
    }

    /// <summary>Jouw plaats in de tussenstand (gedeeld bij gelijke score), zoals Standings ze toont.</summary>
    private int? MyPlace => _state?.Players.FirstOrDefault(p => p.IsMe) is { } me
        ? me.Rank ?? 1 + _state.Players.Count(p => !p.Left && p.Score > me.Score)
        : null;

    /// <summary>Opschrift van het ingeklapte antwoord onder de tussenstand.</summary>
    private static string AnswerLabel(QuestionType type) => type switch
    {
        QuestionType.Snelvuur or QuestionType.NietBij => "Bekijk de antwoorden",
        QuestionType.Jaar => "Bekijk het juiste jaar",
        QuestionType.Emoji => "Bekijk de emoji",
        QuestionType.Opstelling => "Bekijk de volledige opstelling",
        _ => "Bekijk alle tips",
    };

    /// <summary>Position 0: deelpunten zonder juist antwoord (jaar, opstelling, counter).</summary>
    private static string Medal(int rank) => rank switch { 0 => "👍", 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => rank.ToString() };

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _timer?.Dispose();
        Realtime.MatchChanged -= OnMatchChanged;
        try { await Realtime.UnwatchMatchAsync(Id); } catch { /* verbinding al weg */ }
    }
}
