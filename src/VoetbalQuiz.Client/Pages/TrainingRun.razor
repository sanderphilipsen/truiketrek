@page "/academie/poging/{RunId:int}"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Academie – Truitje Trek</PageTitle>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
    <a class="btn" href="academie">Terug naar de academie</a>
}
else if (_overview is null || _summary is null)
{
    <div class="center-msg"><Spinner /></div>
}
else
{
    var answered = _overview.Questions.Count(q => q.Status == QuestionStatus.Answered);
    var next = _overview.Questions.FirstOrDefault(q => q.Status != QuestionStatus.Answered);

    var sp = _summary.Special;

    <PageHeader Title="@(sp?.Name ?? "Academie")" Up="true"
                Label="@(sp is not null ? $"Special · {Training.SpecialDates(sp)}" : DutchDates.DayMonth(_overview.Date))"
                BackHref="@(sp is not null ? $"academie/special/{sp.Id}" : $"academie/{_overview.Date:yyyy-MM-dd}")" />

    <section class="card hero">
        <div class="type-banner"><TypesLabel Types="QuestionTypes.DayTypes(_overview)" /></div>
        <div class="score-big">@_overview.TotalPoints <small>punten</small></div>
        <div class="muted">@answered / @_overview.Questions.Count gespeeld</div>

        @if (next is not null)
        {
            <a class="btn primary big" href="academie/poging/@RunId/vraag/@next.Number" @onclick="() => Play(next.Number)" @onclick:preventDefault="true">
                @(answered == 0 ? "Start" : $"Verder met vraag {next.Number}")
            </a>
        }
        else
        {
            var where = sp is null ? DutchDates.DayMonth(_summary.Date) : $"de {sp.Name}";
            var board = sp is null ? $"academie/{_summary.Date:yyyy-MM-dd}/klassement" : $"academie/special/{sp.Id}/klassement";
            @if (_summary.CountsForBoard)
            {
                @* Je eerste keer op een dag die je niet echt speelde: zo sta je (nagespeeld) in het klassement van die dag. *@
                var place = new RealResult(_summary.Points, _summary.Correct, _summary.WouldBeRank, _summary.Players);
                <p class="training-result" aria-live="polite">
                    Je staat in het klassement van @where, <b>@Training.Between(place)</b>.
                </p>
                <p class="muted">Nagespeeld: telt niet voor de dagwinnaar, het maandklassement of XP.</p>
            }
            else
            {
                <p class="training-result" aria-live="polite">
                    Daarmee was je <b>@_summary.WouldBeRank@DutchDates.OrdinalSuffix(_summary.WouldBeRank) van @_summary.Players</b>
                    geweest @(sp is null ? $"op {DutchDates.DayMonth(_summary.Date)}" : $"in de {sp.Name}").
                </p>
                @if (_summary.Real is { } real)
                {
                    var diff = _summary.Points - real.Points;
                    <p class="muted">Echt: @real.Points · Nu: @_summary.Points (@(diff >= 0 ? "+" : "")@diff)</p>
                }
            }
            <a class="sb-go training-board-link" href="@board">Bekijk het klassement ›</a>

            @if (NextMissed is { } nextDay)
            {
                <button class="btn primary big" @onclick="() => StartNextAsync(nextDay)" disabled="@_starting">
                    Volgende gemiste dag <span aria-hidden="true">›</span>
                    <small class="training-next-day">@Training.Title(nextDay)</small>
                </button>
                <button class="btn big" @onclick="AgainAsync" disabled="@_starting">Opnieuw spelen</button>
            }
            else
            {
                <button class="btn primary big" @onclick="AgainAsync" disabled="@_starting">Opnieuw spelen</button>
            }
            <a class="btn big" href="@CalendarPath">Terug naar de kalender</a>
        }
        @if (next is not null || !_summary.CountsForBoard)
        {
            <p class="muted training-note">@TrainingRules.Label</p>
        }
    </section>

    @if (next is null)
    {
        <h2 class="section-title">Jouw scores op deze @(sp is null ? "daily" : "special")</h2>
        <TrainingScores Real="_summary.Real" Runs="_summary.Runs" Questions="_summary.Questions" Current="RunId" />
    }

    <h2 class="section-title">Vragen</h2>
    <ol class="question-list">
        @foreach (var q in _overview.Questions)
        {
            <li class="@CssFor(q)">
                <span class="num">@q.Number</span>
                <span class="name">@(q.PlayerName ?? (q.Status == QuestionStatus.NotStarted ? "?" : "bezig…"))</span>
                @if (q.Correct is not null) { var mark = QuestionDisplay.Mark(q); <span class="mark" role="img" aria-label="@mark.Label">@mark.Symbol</span> }
                <span class="pts">@(q.Points is { } p ? $"{p}" : "")</span>
            </li>
        }
    </ol>
}

@code {
    // Vervangen, niet toevoegen: zie Daily.
    private void Play(int n) => Nav.NavigateTo($"academie/poging/{RunId}/vraag/{n}", replace: true);

    [Parameter] public int RunId { get; set; }

    private DailyOverview? _overview;
    private TrainingSummary? _summary;
    private TrainingSuggestion? _suggestion;
    private string? _error;
    private bool _starting;

    /// <summary>De aanrader van de academie, als dat een gemiste dag is (geen revanche, en niet deze dag zelf).</summary>
    private TrainingDay? NextMissed => _suggestion is { Revenge: false, Day: var day }
                                       && !(day.Date == _summary?.Date && day.Special?.Id == _summary?.Special?.Id) ? day : null;

    /// <summary>Terug naar de maand van deze dag, waar de net gespeelde dag even oplicht.</summary>
    private string CalendarPath => _summary is { Special: null } s ? $"academie?net={s.Date:yyyy-MM-dd}"
        : _summary is { } t ? Training.MonthPath(t.Date.Year, t.Date.Month) : "academie";

    protected override async Task OnParametersSetAsync()
    {
        (_overview, _summary, _suggestion, _error) = (null, null, null, null);
        try
        {
            _overview = await Api.GetOverviewAsync(ApiClient.TrainingRun(RunId));
            _summary = await Api.GetTrainingSummaryAsync(RunId);
            if (_summary.Finished) _suggestion = (await Api.GetTrainingArchiveAsync()).Suggestion;
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task StartNextAsync(TrainingDay day)
    {
        _starting = true;
        try
        {
            var run = day.Special is { } sp ? await Api.StartTrainingSpecialRunAsync(sp.Id) : await Api.StartTrainingRunAsync(day.Date);
            Nav.NavigateTo($"academie/poging/{run.Id}/vraag/1", replace: true);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _starting = false;
        }
    }

    private async Task AgainAsync()
    {
        _starting = true;
        try
        {
            var run = await Api.StartTrainingAgainAsync(RunId);
            Nav.NavigateTo($"academie/poging/{run.Id}/vraag/1", replace: true);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _starting = false;
        }
    }

    private static string CssFor(QuestionSummary q) => QuestionDisplay.ListCss(q);
}
