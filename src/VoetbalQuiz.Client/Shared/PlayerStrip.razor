@* Compacte rij met alle spelers in het partijtje, hun score en of ze al geantwoord hebben.
   Derby: kaartjes bij wie rood kreeg of omgekocht is, en bij het kiezen van een doelwit worden de tegenstanders aantikbaar. *@
<div class="player-strip @(Picking ? "picking" : "")">
    @foreach (var p in Players.Where(p => !p.Left))
    {
        var player = p;
        var pickable = Picking && !p.IsMe && Unpickable?.Contains(p.UserName) != true;
        @if (pickable)
        {
            <button type="button" class="strip-player pickable" @onclick="() => OnPick.InvokeAsync(player.UserName)"
                    aria-label="Kies @p.UserName">
                @Content(p)
            </button>
        }
        else
        {
            <div class="strip-player @(p.IsMe ? "me" : "")">@Content(p)</div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public List<MatchPlayerState> Players { get; set; } = [];
    [Parameter] public bool ShowAnswered { get; set; }

    /// <summary>Derby: per speler de iconen van de wapens tegen hem (rode kaart, propere handen), bij zijn avatar.</summary>
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<string>>? Marks { get; set; }

    /// <summary>Derby: een doelwit kiezen voor de rode kaart of de gokchinees.</summary>
    [Parameter] public bool Picking { get; set; }
    [Parameter] public IReadOnlyCollection<string>? Unpickable { get; set; }
    [Parameter] public EventCallback<string> OnPick { get; set; }

    private RenderFragment Content(MatchPlayerState p) =>
        @<text>
            <div class="strip-avatar">
                <Avatar Id="@p.AvatarId" User="@p.UserName" Size="40" />
                @if (ShowAnswered && p.AnsweredCurrent) { <span class="check">✓</span> }
                @if (Marks?.GetValueOrDefault(p.UserName) is { } marks) { <span class="strip-card">@foreach (var m in marks) { <Icon Name="@m" /> }</span> }
            </div>
            <small>@p.UserName</small>
            <b>@p.Score</b>
        </text>;
}
