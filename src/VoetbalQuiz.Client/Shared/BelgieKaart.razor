 1.7 1.4 4.2 4.5 4.9 .2 2.9M176.2 46.9l1.9-1.4 1.4-2.9-4-2-.6-6.1-2.1-2.9 2.8 .1 5.3 2.5 4.4 .2 1.8-.9 .5-2.6-3.5-5.3 .9-3.8-1.1-1.2 5-2.9 7.9-2.3 1.2 .2 .8 1.3-1.2 5.8 1.9 1.3 4-.4 4.5 .7 2.3-1.2 7.4-8.9 3.1-1.6 4.7 1.8 1 1.3 .2 2.2-1 4.4 .7 2.6-4.2-1.9-1.1 .2-.5 1.8 2 .9 6.7 .2 5.4 2.1 2.1-.5 2.4-2.3 3.7-5.4 1.6-4.1 1.4-.4 3.2 2.2 1.8 3.5-1.4 4.9-.3 3.3 .6 1.4 3.3 3.6 1.9 5.6 1.7 .9 5.4-.2 1.7 2.1 .1 5.4 1.6 .4M269.1 47.7l11.3 .5 7.9-4.4 2.1 .2 2.2 1.4 1.8 2.3 1 6.3 2.1 1.9 5.4 1.6 3.3 2.6 6.8-.7 1.6 1 3.3 3.7 4.5-.6 1.1 2.7-1.3 1.3-.4 1.7 2.2 2.3-1.8 1-2.1 0 .7 2.2-1.3 3.1-.7 1-1.1-1-.8 .5-.7 3.4 1.3 1.8-1.5 3.6-3.8 6 2.2-.6 1.8 .6-2.7 5.3-1.7 2.2-2.2 .9-6.9 7.6 .2 3.4 1.5 2.2M314.2 121.6l.9-.6 .9 .3 3 2.9 8.3-.2M193.7 117.7l-7.8 4.1-2 .5-2.1-.4-2.7-1.7-2.5-5.4-1.7 .9-3.6-1.9 1.2-2.3 2.4-.4 .6-2.6-1-1.7 1.8-3.5 3.5-1.8 4.1 .7 2.5-2.4 1.6 1.2 1.5 2.6 0 1.4-1.5 1.6 3.8 2.4 1.5 4.8-2 .2-.8 1.4 3.2 2.3" />
        @{ var labels = PlaatsLabels(); }
        <g class="kaart-spelden">
            @for (var i = 0; i < Pins.Count; i++)
            {
                var pin = Pins[i];
                if (pin.State == KaartPinState.Wacht) continue;
                var (x, y) = Project(pin.Lat, pin.Lon);
                <g @key="i" class="kaart-pin kaart-pin-@pin.State.ToString().ToLowerInvariant()" transform="translate(@Fmt(x) @Fmt(y))">
                    @switch (pin.State)
                    {
                        case KaartPinState.Huidig:
                            <circle class="kaart-pin-ring" r="5" />
                            <g class="kaart-pin-vorm">
                                <path class="kaart-pin-kop" d="M0 0C-2-5.8-10-10.8-10-18.5a10 10 0 0 1 20 0c0 7.7-8 12.7-10 18.5z" />
                                <circle class="kaart-pin-oog" cy="-18.5" r="3.8" />
                            </g>
                            break;
                        case KaartPinState.Juist:
                            <g class="kaart-pin-vorm">
                                <circle class="kaart-pin-bol" r="6" />
                                <path class="kaart-pin-teken" d="M-2.8 .2l1.9 1.9 3.8-4" />
                            </g>
                            break;
                        case KaartPinState.Deels:
                            <g class="kaart-pin-vorm">
                                <circle class="kaart-pin-bol" r="6" />
                                @* half juist: de helft van de bol gevuld *@
                                <path class="kaart-pin-half" d="M0-3.6a3.6 3.6 0 0 1 0 7.2z" />
                            </g>
                            break;
                        default:
                            <g class="kaart-pin-vorm">
                                <circle class="kaart-pin-bol" r="6" />
                                <path class="kaart-pin-teken" d="M-2.2-2.2l4.4 4.4m0-4.4l-4.4 4.4" />
                            </g>
                            break;
                    }
                </g>
            }
        </g>
        <g class="kaart-labels" aria-hidden="true">
            @foreach (var l in labels)
            {
                @* <text> direct in een codeblok is voor Razor een speciale tag; binnen <g> is het gewone markup. *@
                <g @key="l.Index"><text x="@Fmt(l.X)" y="@Fmt(l.Y)" text-anchor="@l.Anchor">@l.Tekst</text></g>
            }
        </g>
    </svg>
</div>

@code {
    /// <summary>Alle spelden van de kaart, in de volgorde van de vraag. Spelden in <see cref="KaartPinState.Wacht"/> worden niet getoond.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KaartPin> Pins { get; set; } = [];

    /// <summary>
    /// Hoeveel clubnamen er tegelijk bij de beantwoorde spelden staan: de laatst beantwoorde eerst (volgorde van <see cref="Pins"/>).
    /// Standaard 3, zodat drukke zones (Brussel, Antwerpen, Brugge) leesbaar blijven. 0 = geen labels, null = alle labels.
    /// Een oudere naam die nergens vrij past (andere naam of speld in de weg) valt weg; de laatst beantwoorde staat er altijd.
    /// </summary>
    [Parameter] public int? MaxLabels { get; set; } = 3;

    /// <summary>Eigen omschrijving voor schermlezers; standaard een samenvatting van de spelden.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Extra CSS-klasse op de buitenste div.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Toon de clubnaam (<see cref="KaartPin.Label"/>) ook bij de huidige speld, vóór het antwoord: in deel 2 van de
    /// kaartdag staat de club erbij en zoek je het stadion. Dat label komt altijd eerst.
    /// </summary>
    [Parameter] public bool LabelHuidig { get; set; }

    /// <summary>Breedte en hoogte van de viewBox.</summary>
    public const double Breedte = KaartProjection.Width, Hoogte = KaartProjection.Height;

    /// <summary>
    /// Lengte- en breedtegraad naar x/y in de viewBox van de kaart (0 0 381 326). De projectie en de randen staan in
    /// <see cref="KaartProjection"/>, zodat de controle op kaart.json dezelfde grenzen gebruikt.
    /// </summary>
    public static (double X, double Y) Project(double lat, double lon) => KaartProjection.Project(lat, lon);

    static string Fmt(double v) => Math.Round(v, 1).ToString("0.#", CultureInfo.InvariantCulture);

    string StandaardAriaLabel()
    {
        int juist = 0, deels = 0, fout = 0, huidig = -1;
        for (var i = 0; i < Pins.Count; i++)
        {
            switch (Pins[i].State)
            {
                case KaartPinState.Juist: juist++; break;
                case KaartPinState.Deels: deels++; break;
                case KaartPinState.Fout: fout++; break;
                case KaartPinState.Huidig: huidig = i; break;
            }
        }
        var tekst = "Kaart van België met provinciegrenzen.";
        if (huidig >= 0) tekst += $" Speld {huidig + 1} van {Pins.Count} staat klaar.";
        if (juist + deels + fout > 0)
        {
            tekst += $" {juist} juist";
            if (deels > 0) tekst += $", {deels} half juist";
            tekst += $", {fout} fout.";
        }
        return tekst;
    }

    record struct Label(int Index, double X, double Y, string Anchor, string Tekst);

    const double LabelGrootte = 12;   // moet gelijk zijn aan font-size in kaart.css
    const double TekenBreedte = 6.8;  // geschatte breedte per letter bij 600-gewicht

    /// <summary>
    /// Kiest welke clubnamen er staan (de laatste <see cref="MaxLabels"/> beantwoorde spelden) en waar:
    /// rechts, links, boven of onder de speld, de eerste plaats die binnen de kaart valt en geen ander label of speld raakt.
    /// </summary>
    List<Label> PlaatsLabels()
    {
        var result = new List<Label>();
        if (MaxLabels == 0) return result;

        var kandidaten = new List<int>();
        if (LabelHuidig)
            for (var i = 0; i < Pins.Count; i++)
                if (Pins[i].State == KaartPinState.Huidig && !string.IsNullOrWhiteSpace(Pins[i].Label)) kandidaten.Add(i);
        for (var i = Pins.Count - 1; i >= 0; i--)
        {
            var p = Pins[i];
            if (p.State is KaartPinState.Juist or KaartPinState.Deels or KaartPinState.Fout && !string.IsNullOrWhiteSpace(p.Label))
            {
                kandidaten.Add(i);
            }
        }
        if (kandidaten.Count == 0) return result;

        // Obstakels: alle zichtbare spelden (de huidige speld is groter).
        var bezet = new List<(double L, double T, double R, double B)>();
        foreach (var p in Pins)
        {
            if (p.State == KaartPinState.Wacht) continue;
            var (x, y) = Project(p.Lat, p.Lon);
            bezet.Add(p.State == KaartPinState.Huidig ? (x - 11, y - 30, x + 11, y + 3) : (x - 6, y - 6, x + 6, y + 6));
        }

        foreach (var i in kandidaten)
        {
            if (MaxLabels is { } max && result.Count >= max) break;
            var p = Pins[i];
            var (x, y) = Project(p.Lat, p.Lon);
            var tekst = p.Label!.Trim();
            var w = tekst.Length * TekenBreedte;
            var h = LabelGrootte;
            // (ankerpunt x, basislijn y, text-anchor, kader)
            var opties = new (double X, double Y, string A, (double L, double T, double R, double B) K)[]
            {
                (x + 9, y + 4, "start", (x + 8, y - 7, x + 9 + w, y + 6)),            // rechts
                (x - 9, y + 4, "end", (x - 9 - w, y - 7, x - 8, y + 6)),              // links
                (x, y - 10, "middle", (x - w / 2, y - 10 - h, x + w / 2, y - 7)),     // boven
                (x, y + 18, "middle", (x - w / 2, y + 7, x + w / 2, y + 21)),         // onder
                (x + 6, y - 8, "start", (x + 5, y - 8 - h, x + 6 + w, y - 5)),        // rechtsboven
                (x + 6, y + 16, "start", (x + 5, y + 5, x + 6 + w, y + 19)),          // rechtsonder
                (x - 6, y - 8, "end", (x - 6 - w, y - 8 - h, x - 5, y - 5)),          // linksboven
                (x - 6, y + 16, "end", (x - 6 - w, y + 5, x - 5, y + 19)),            // linksonder
            };
            var gekozen = -1;
            var binnen = -1;
            for (var o = 0; o < opties.Length; o++)
            {
                var k = opties[o].K;
                if (k.L < 1 || k.T < 1 || k.R > Breedte - 1 || k.B > Hoogte - 1) continue;
                if (binnen < 0) binnen = o;
                if (!bezet.Any(b => b.L < k.R && k.L < b.R && b.T < k.B && k.T < b.B)) { gekozen = o; break; }
            }
            // Past een oudere naam nergens vrij, dan valt hij weg; de laatst beantwoorde staat er altijd.
            if (gekozen < 0 && result.Count > 0) continue;
            if (gekozen < 0) gekozen = binnen >= 0 ? binnen : (x > Breedte / 2 ? 1 : 0);
            var c = opties[gekozen];
            bezet.Add(c.K);
            result.Add(new Label(i, c.X, c.Y, c.A, tekst));
        }
        return result;
    }
}
