@* Het dag- en maandklassement; getoond als sheet over Home (/klassement). *@
@inject ApiClient Api

<div class="tabs">
    <button class="@(_monthly ? "" : "active")" aria-pressed="@(_monthly ? "false" : "true")" @onclick="() => ShowAsync(false)">Vandaag</button>
    <button class="@(_monthly ? "active" : "")" aria-pressed="@(_monthly ? "true" : "false")" @onclick="() => ShowAsync(true)">Maand</button>
</div>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (!_monthly)
{
    @* ---------- Dagklassement: enkel de daily van vandaag ---------- *@
    @if (_today is null)
    {
        <div class="center-msg"><Spinner /></div>
    }
    else if (_today.Entries.Count == 0)
    {
        <div class="card center muted">Nog niemand gespeeld vandaag.</div>
    }
    else
    {
        <LeaderboardList Entries="@_today.Entries.Select(e => new LeaderboardList.Row(e.Rank, e.UserName, e.AvatarId, e.Points, e.IsMe)).ToList()" />
    }
}
else
{
    @* ---------- Maandklassement: enkel het totaal (daily + specials + online + bonussen) ---------- *@
    <div class="month-nav">
        <button class="linkish" aria-label="Vorige maand" @onclick="() => MoveMonthAsync(-1)">‹</button>
        <span>@DutchDates.MonthYear(_year, _month)</span>
        <button class="linkish" aria-label="Volgende maand" @onclick="() => MoveMonthAsync(1)" disabled="@IsCurrentMonth">›</button>
    </div>

    @if (_ranking is null)
    {
        <div class="center-msg"><Spinner /></div>
    }
    else if (_ranking.Entries.Count == 0)
    {
        <div class="card center muted">Nog niemand gespeeld deze maand.</div>
    }
    else
    {
        <LeaderboardList Entries="@_ranking.Entries.Select(e => new LeaderboardList.Row(e.Rank, e.UserName, e.AvatarId, e.Total, e.IsMe)).ToList()" />
    }
}

@code {
    private bool _monthly;
    private int _year = QuizDay.Today().Year, _month = QuizDay.Today().Month;
    private Leaderboard? _today;
    private MonthRanking? _ranking;
    private string? _error;

    private bool IsCurrentMonth => _year == QuizDay.Today().Year && _month == QuizDay.Today().Month;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ShowAsync(bool monthly)
    {
        _monthly = monthly;
        await LoadAsync();
    }

    private async Task MoveMonthAsync(int delta)
    {
        var d = new DateTime(_year, _month, 1).AddMonths(delta);
        (_year, _month) = (d.Year, d.Month);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            if (_monthly)
            {
                _ranking = null;
                _ranking = await Api.GetMonthRankingAsync(_year, _month);
            }
            else
            {
                _today = null;
                _today = await Api.GetTodayLeaderboardAsync();
            }
        }
        catch (ApiException ex) { _error = ex.Message; }
    }
}
