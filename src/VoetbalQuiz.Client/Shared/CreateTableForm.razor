@* Een online match klaarzetten. Een knop opent een bottom sheet over de lobby (of Home) met:
   een grappige, aanpasbare voorstelnaam, de spelvorm(en) als chips (twee of meer = mix), het aantal plaatsen
   met een stepper, het aantal vragen en de derby-schakelaar. Onderaan, altijd in duimbereik: een live samenvatting
   en "Zet de match klaar". De server beslist zoals voorheen (CreateMatchRequest is ongewijzigd). *@
@inject ApiClient Api
@inject NavigationManager Nav

<button type="button" class="btn big tafel-new @(Primary ? "primary" : "")" @ref="_trigger"
        aria-haspopup="dialog" aria-expanded="@(_open ? "true" : "false")" @onclick="Open">
    <Icon Name="plus" /> Nieuwe match
</button>

@if (_open)
{
    <div class="sheet-backdrop" @onclick="Close"></div>
    <form class="sheet" role="dialog" aria-modal="true" aria-labelledby="tafel-sheet-title"
          @onsubmit="CreateAsync" @onkeydown="OnKeyDown">
        <div class="sheet-head">
            <span class="sheet-grip" aria-hidden="true"></span>
            <h2 id="tafel-sheet-title" tabindex="-1" @ref="_title">Nieuwe match</h2>
            <button type="button" class="sheet-close" aria-label="Sluiten" @onclick="Close">✕</button>
        </div>

        <div class="sheet-body">
            <div class="tafel-field">
                <label class="field-label" for="tafel-name">Naam</label>
                <div class="tafel-name">
                    <input id="tafel-name" value="@_name" maxlength="@NameMax" autocomplete="off"
                           placeholder="Partijtje van @UserName" @oninput="OnNameInput" />
                    <button type="button" class="tafel-reroll" aria-label="Andere naam voorstellen" title="Andere naam" @onclick="Reroll">🎲</button>
                </div>
            </div>

            <div class="tafel-field" role="group" aria-labelledby="tafel-types-label">
                <div class="tafel-field-head">
                    <span class="field-label" id="tafel-types-label">Spelvorm</span>
                    <small class="tafel-hint">Kies er meer voor een mix</small>
                </div>
                @if (_active is null)
                {
                    @if (_error is null)
                    {
                        <p class="muted"><Spinner Small="true" /></p>
                    }
                }
                else
                {
                    <div class="tafel-types">
                        @foreach (var t in QuestionTypes.All.Where(t => _active.Contains(t.Type)))
                        {
                            var type = t.Type;
                            var on = _chosen.Contains(type);
                            <button type="button" class="tafel-type @(on ? "active" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => Toggle(type)">
                                <span class="tafel-type-icon" aria-hidden="true">@t.Icon</span>
                                <span class="tafel-type-name">@t.Name</span>
                                <span class="tafel-type-check" aria-hidden="true">@(on ? "✓" : "")</span>
                            </button>
                        }
                    </div>
                    <small class="tafel-type-summary @(_chosen.Count == 0 ? "warn" : "")">@TypeSummary</small>
                }
            </div>

            <div class="tafel-row">
                <span class="field-label" id="tafel-seats-label">Plaatsen</span>
                <div class="tafel-stepper" role="group" aria-labelledby="tafel-seats-label">
                    <button type="button" aria-label="Eén plaats minder" disabled="@(_seats <= MatchRules.MinSeats)" @onclick="() => _seats--">−</button>
                    <output aria-live="polite">@_seats</output>
                    <button type="button" aria-label="Eén plaats meer" disabled="@(_seats >= MatchRules.MaxSeats)" @onclick="() => _seats++">+</button>
                </div>
            </div>

            <div class="tafel-field" role="group" aria-labelledby="tafel-count-label">
                <span class="field-label" id="tafel-count-label">Vragen</span>
                <div class="tafel-count">
                    @foreach (var n in MatchRules.QuestionChoices)
                    {
                        var count = n;
                        <button type="button" class="@(Questions == count ? "active" : "")" aria-pressed="@(Questions == count ? "true" : "false")"
                                disabled="@(count < MinQuestions)" title="@(count < MinQuestions ? "Minstens één vraag per gekozen spelvorm" : null)"
                                @onclick="() => _questions = count">@count</button>
                    }
                </div>
            </div>

            <button type="button" class="derby-toggle @(_derby ? "active" : "")" aria-pressed="@(_derby ? "true" : "false")" @onclick="ToggleDerby">
                <span class="derby-flame" aria-hidden="true">🔥</span>
                <span class="derby-text">
                    <b>Derby</b>
                    <small>Elk een geheim wapen @string.Join(" ", DerbyRules.All.Select(w => w.Icon))</small>
                    @if (_derby && _chosen.Count > 0 && !_chosen.Any(DerbyRules.TrumpWorksOn))
                    {
                        <small class="derby-note">🟨 Trump booster enkel bij Snelvuur, Wie hoort er niet bij of Raad het jaar.</small>
                    }
                </span>
                <span class="switch" aria-hidden="true"></span>
            </button>
        </div>

        <div class="sheet-foot">
            @if (_error is not null) { <p class="error" role="alert">@_error</p> }
            <p class="tafel-summary @(_chosen.Count == 0 ? "warn" : "")" aria-live="polite">@FootSummary</p>
            <button type="submit" class="btn primary big tafel-submit" disabled="@(_busy || _active is null || _chosen.Count == 0)">
                @if (_busy)
                {
                    <Spinner Small="true" /> <span>Even geduld…</span>
                }
                else
                {
                    <span>Zet de match klaar</span>
                }
            </button>
        </div>
    </form>
}

@code {
    [Parameter] public string? UserName { get; set; }

    /// <summary>De knop als gele hoofdactie (lobby zonder open partijtjes); anders een gewone knop.</summary>
    [Parameter] public bool Primary { get; set; }

    private const int NameMax = 40;

    private ElementReference _trigger, _title;
    private bool _open, _focusTitle, _focusTrigger;

    private string _name = "";
    /// <summary>Zelf een naam getypt: dan stellen we niets nieuws meer voor bij een andere spelvorm of derby.</summary>
    private bool _nameTouched;
    private int _seats = 4;
    private bool _busy;
    private string? _error;

    /// <summary>De types die aan staan (enkel die kan je kiezen).</summary>
    private List<QuestionType>? _active;
    private List<QuestionType> _chosen = [];
    private bool _derby;

    private int _questions = MatchRules.DefaultQuestions;

    /// <summary>Wat er echt gespeeld wordt: minstens één vraag per gekozen type, dus zo nodig de eerste keuze die groot genoeg is.</summary>
    private int Questions => _questions >= MinQuestions ? _questions
        : MatchRules.QuestionChoices.FirstOrDefault(n => n >= MinQuestions, MatchRules.MaxQuestions);
    private int MinQuestions => MatchRules.MinQuestionsFor(_chosen.Count);

    private string TypeSummary => _chosen.Count switch
    {
        0 => "Kies minstens één spelvorm.",
        1 => QuestionTypes.Get(_chosen[0]).HowTo,
        _ => $"Mix van {_chosen.Count} spelvormen, door elkaar.",
    };

    private string FootSummary => _chosen.Count == 0
        ? "Kies eerst een spelvorm."
        : $"{QuestionTypes.Label(_chosen)} · {Questions} vragen · {_seats} plaatsen{(_derby ? " · 🔥 Derby" : "")}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _active = await Api.GetMatchTypesAsync();
            var first = _active.Contains(QuestionType.WieBenIk) ? QuestionType.WieBenIk : _active.FirstOrDefault();
            _chosen = _active.Count > 0 ? [first] : [];
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus naar de titel van de sheet bij openen, en terug naar de knop bij sluiten.
        if (_focusTitle) { _focusTitle = false; await _title.FocusAsync(); }
        if (_focusTrigger) { _focusTrigger = false; await _trigger.FocusAsync(); }
    }

    private void Open()
    {
        _open = true;
        _error = null;
        if (!_nameTouched) _name = SuggestName();
        _focusTitle = true;
    }

    private void Close()
    {
        if (_busy) return;
        _open = false;
        _focusTrigger = true;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    private void Toggle(QuestionType type)
    {
        if (!_chosen.Remove(type)) _chosen.Add(type);
        if (!_nameTouched) _name = SuggestName();
    }

    private void ToggleDerby()
    {
        _derby = !_derby;
        if (!_nameTouched) _name = SuggestName();
    }

    private void OnNameInput(ChangeEventArgs e)
    {
        _name = e.Value?.ToString() ?? "";
        _nameTouched = true;
    }

    private void Reroll()
    {
        _name = SuggestName();
        _nameTouched = false;
    }

    /// <summary>Een grappige voorstelnaam, afhankelijk van derby en spelvorm; nooit twee keer na elkaar dezelfde.</summary>
    private string SuggestName()
    {
        var u = string.IsNullOrWhiteSpace(UserName) ? "de ploeg" : UserName;
        string[] themed = _derby
            ? [$"Derby van {u}", $"{u}'s heksenketel", $"Kolkende kuip van {u}", $"Vuurwerk bij {u}", $"Clásico bij {u}"]
            : _chosen.Count > 1
                ? [$"Allegaartje van {u}", $"{u}'s mixed zone", $"Bonte avond bij {u}", $"Van alles wat bij {u}"]
                : _chosen.FirstOrDefault() switch
                {
                    QuestionType.Snelvuur => [$"Snelvuur bij {u}", $"{u}'s sprintje", $"Rap rap bij {u}"],
                    QuestionType.NietBij => [$"Vreemde eend bij {u}", $"{u}'s buitenbeentjes"],
                    QuestionType.Emoji => [$"{u}'s emojifeestje", $"Smileys bij {u}"],
                    QuestionType.Jaar => [$"{u}'s tijdmachine", $"Jaartallen bij {u}"],
                    QuestionType.Carriere or QuestionType.Wissel => [$"{u}'s transfermarkt", $"Mercato bij {u}"],
                    QuestionType.Opstelling => [$"{u}'s basiself", $"Tactiekbord van {u}"],
                    _ => [$"Wie is wie bij {u}?", $"{u}'s raadseluurtje"],
                };
        string[] generic = _derby ? [] : [$"Partijtje van {u}", $"{u}'s kleedkamer", $"Zondagsvoetbal bij {u}", $"Matchke van {u}", $"Café {u}"];
        var pool = themed.Concat(generic).Select(n => n.Length > NameMax ? n[..NameMax] : n).Where(n => n != _name).ToArray();
        return pool[Random.Shared.Next(pool.Length)];
    }

    private async Task CreateAsync()
    {
        if (_chosen.Count == 0 || _busy) return;
        _busy = true;
        _error = null;
        try
        {
            var id = await Api.CreateMatchAsync(new CreateMatchRequest(_name.Trim(), _seats, [.. _chosen], _derby, Questions));
            Nav.NavigateTo($"online/{id}");
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
