@* Een online partijtje aanmaken: naam (optioneel), aantal plaatsen, het vraagtype (één type of een mix van de types die aan staan) en het aantal vragen. *@
@inject ApiClient Api
@inject NavigationManager Nav

@if (Collapsible && !_open)
{
    @* Meedoen is vaker nodig dan aanmaken: het lange formulier klapt pas open als je erom vraagt. *@
    <button type="button" class="btn big tafel-new" aria-expanded="false" @onclick="() => _open = true">＋ Nieuw partijtje</button>
}
else
{
<form class="stack @(Card ? "card tafel-form" : "")" @onsubmit="CreateAsync">
    <label><span>Naam <span class="optional">(optioneel)</span></span>
        <input @bind="_name" maxlength="40" placeholder="Partijtje van @UserName" />
    </label>
    <div>
        <div class="field-label">Aantal plaatsen</div>
        <div class="seat-picker">
            @for (var n = MatchRules.MinSeats; n <= MatchRules.MaxSeats; n++)
            {
                var seats = n;
                <button type="button" class="@(_seats == seats ? "active" : "")" aria-pressed="@(_seats == seats ? "true" : "false")" @onclick="() => _seats = seats">@seats</button>
            }
        </div>
    </div>
    <div>
        <div class="field-label">Vraagtype</div>
        @if (_active is null)
        {
            <p class="muted"><Spinner Small="true" /></p>
        }
        else
        {
            <div class="type-picker">
                @foreach (var t in QuestionTypes.All.Where(t => _active.Contains(t.Type)))
                {
                    var type = t.Type;
                    <button type="button" class="@(_chosen.Contains(type) ? "active" : "")" title="@t.HowTo"
                            aria-pressed="@(_chosen.Contains(type) ? "true" : "false")" @onclick="() => Pick(type)">
                        <span class="tp-icon">@t.Icon</span> @t.Name
                    </button>
                }
                @if (_active.Count > 1)
                {
                    <button type="button" class="mix @(_mix ? "active" : "")" aria-pressed="@(_mix ? "true" : "false")" @onclick="ToggleMix">
                        <span class="tp-icon">🎲</span> Mix
                    </button>
                }
            </div>
            <small class="type-summary @(MixIncomplete ? "warn" : "")">@Summary</small>
        }
    </div>
    <div>
        <div class="field-label">Aantal vragen</div>
        <div class="seat-picker">
            @foreach (var n in MatchRules.QuestionChoices)
            {
                var count = n;
                <button type="button" class="@(Questions == count ? "active" : "")" aria-pressed="@(Questions == count ? "true" : "false")"
                        disabled="@(count < MinQuestions)" title="@(count < MinQuestions ? "Minstens één vraag per gekozen type" : null)"
                        @onclick="() => _questions = count">@count</button>
            }
        </div>
    </div>
    <button type="button" class="derby-toggle @(_derby ? "active" : "")" aria-pressed="@(_derby ? "true" : "false")" @onclick="() => _derby = !_derby">
        <span class="derby-flame">🔥</span>
        <span class="derby-text">
            <b>Derby</b>
            <small>Elk een geheim wapen @string.Join(" ", DerbyRules.All.Select(w => w.Icon))</small>
            @if (_derby && !_chosen.Any(DerbyRules.TrumpWorksOn))
            {
                <small class="derby-note">🟨 Trump booster enkel bij Snelvuur, Wie hoort er niet bij of Raad het jaar.</small>
            }
        </span>
        <span class="switch" aria-hidden="true"></span>
    </button>
    @if (_error is not null) { <p class="error" role="alert">@_error</p> }
    <button class="btn primary tafel-submit" disabled="@(_busy || _active is null || _chosen.Count == 0 || MixIncomplete)">Partijtje aanmaken</button>
</form>
}

@code {
    [Parameter] public string? UserName { get; set; }

    /// <summary>Formulier standaard ingeklapt achter de knop "Nieuw partijtje".</summary>
    [Parameter] public bool Collapsible { get; set; }

    /// <summary>Het formulier in een eigen witte kaart (Home: het staat daar op het groene veld).</summary>
    [Parameter] public bool Card { get; set; }

    private bool _open;

    private string _name = "";
    private int _seats = 4;
    private bool _busy;
    private string? _error;

    /// <summary>De types die aan staan (enkel die kan je kiezen).</summary>
    private List<QuestionType>? _active;
    private List<QuestionType> _chosen = [];
    private bool _mix;
    private bool _derby;

    private bool MixIncomplete => _mix && _chosen.Count < 2;

    private string Summary => _chosen.Count switch
    {
        0 => "Kies een vraagtype.",
        _ when MixIncomplete => "Kies minstens twee types voor een mix.",
        1 => QuestionTypes.Get(_chosen[0]).HowTo,
        _ => QuestionTypes.Label(_chosen),
    };

    private int _questions = MatchRules.DefaultQuestions;

    /// <summary>Wat er echt gespeeld wordt: minstens één vraag per gekozen type, dus zo nodig de eerste keuze die groot genoeg is.</summary>
    private int Questions => _questions >= MinQuestions ? _questions
        : MatchRules.QuestionChoices.FirstOrDefault(n => n >= MinQuestions, MatchRules.MaxQuestions);
    private int MinQuestions => MatchRules.MinQuestionsFor(_chosen.Count);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _active = await Api.GetMatchTypesAsync();
            var first = _active.Contains(QuestionType.WieBenIk) ? QuestionType.WieBenIk : _active.FirstOrDefault();
            _chosen = _active.Count > 0 ? [first] : [];
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    /// <summary>Zonder mix kies je één type; met mix zet je types aan of uit.</summary>
    private void Pick(QuestionType type)
    {
        if (!_mix) _chosen = [type];
        else if (_chosen.Contains(type)) _chosen.Remove(type);
        else _chosen.Add(type);
    }

    private void ToggleMix()
    {
        _mix = !_mix;
        if (!_mix && _chosen.Count > 1) _chosen = [_chosen[0]];
    }

    private async Task CreateAsync()
    {
        if (_chosen.Count == 0 || MixIncomplete) return;
        _busy = true;
        _error = null;
        try
        {
            var id = await Api.CreateMatchAsync(new CreateMatchRequest(_name, _seats, [.. _chosen], _derby, Questions));
            Nav.NavigateTo($"online/{id}");
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
