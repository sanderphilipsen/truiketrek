@* Een pagina als bottom sheet over Home (bv. /klassement): Home blijft eronder staan, het veld loopt door.
   Sluiten met ✕, de achtergrond, Escape of de terugknop van de gsm; het adres hoort bij de sheet, zodat links blijven werken. *@
@inject NavigationManager Nav

<div class="sheet-backdrop" @onclick="Close"></div>
<section class="sheet page-sheet" role="dialog" aria-modal="true" aria-labelledby="page-sheet-title" @onkeydown="OnKeyDown">
    <div class="sheet-head">
        <span class="sheet-grip" aria-hidden="true"></span>
        <h2 id="page-sheet-title" tabindex="-1" @ref="_title">@Title</h2>
        <button type="button" class="sheet-close" aria-label="Sluiten" @onclick="Close">✕</button>
    </div>
    <div class="sheet-body">
        @ChildContent
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference _title;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await _title.FocusAsync();
    }

    // Terug naar Home zonder een extra stap in de geschiedenis: de terugknop gaat dan niet opnieuw naar de sheet.
    private void Close() => Nav.NavigateTo("", replace: true);

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }
}
