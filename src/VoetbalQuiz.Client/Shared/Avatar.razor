@* Tekent een avatar als SVG uit zijn onderdelen (zie AvatarDef). Met User erbij ook de sterren en gouden rand van de Gouden Bal. *@
@implements IDisposable
@inject GoldenBallState GoldenBall
@{
    var a = Def ?? Avatars.Get(Id);
    var hair = a.HairHex;
    var stars = Math.Min(GoldenBall.StarsOf(User), GoldenBallRules.MaxStarsShown);
    var golden = GoldenBall.IsHolder(User);
}
<svg class="avatar @(golden ? "golden" : "")" width="@Size" height="@Size" viewBox="0 0 100 100" role="img" aria-label="@Label(a.Name, stars, golden)">
    <defs>
        <clipPath id="clip-@_uid"><circle cx="50" cy="50" r="50" /></clipPath>
        <clipPath id="shirt-@_uid"><path d="@ShirtPath" /></clipPath>
        @if (golden)
        {
            <linearGradient id="gold-@_uid" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#fff2a8" /><stop offset=".45" stop-color="#f5c400" /><stop offset="1" stop-color="#a87a00" />
            </linearGradient>
        }
    </defs>
    <g clip-path="url(#clip-@_uid)">
        <rect width="100" height="100" fill="@a.AccentHex" opacity=".25" />
        <rect width="100" height="100" fill="#ffffff" opacity=".35" />

        @* Haar achter het hoofd *@
        @switch (a.Style)
        {
            case HairStyle.Afro:
                <circle cx="50" cy="36" r="25" fill="@hair" />
                break;
            case HairStyle.BigAfro:
                <circle cx="50" cy="34" r="31" fill="@hair" />
                break;
            case HairStyle.Long:
                <path d="M27 38 Q27 14 50 14 Q73 14 73 38 L76 70 L24 70 Z" fill="@hair" />
                break;
            case HairStyle.Dreads:
                <g stroke="@hair" stroke-width="5" stroke-linecap="round">
                    <path d="M30 34 L26 66 M35 30 L32 68 M65 30 L68 68 M70 34 L74 66" />
                </g>
                break;
        }

        @* Shirt met patroon *@
        <path d="@ShirtPath" fill="@a.ShirtHex" />
        <g clip-path="url(#shirt-@_uid)" fill="@a.AccentHex">
            @switch (a.Pattern)
            {
                case ShirtPattern.Stripes:
                    <rect x="26" y="66" width="7" height="40" /><rect x="46.5" y="66" width="7" height="40" /><rect x="67" y="66" width="7" height="40" />
                    break;
                case ShirtPattern.Hoops:
                    <rect x="0" y="76" width="100" height="6" /><rect x="0" y="88" width="100" height="6" />
                    break;
                case ShirtPattern.Halves:
                    <rect x="50" y="60" width="50" height="45" />
                    break;
                case ShirtPattern.Sash:
                    <path d="M20 66 L34 66 L84 106 L70 106 Z" />
                    break;
            }
        </g>
        <path d="M40 68 L50 78 L60 68" fill="none" stroke="@a.AccentHex" stroke-width="3" />
        @if (a.Number > 0)
        {
            @* <text> is in Razor een gereserveerde tag, daarom als markup (alle waarden komen uit vaste paletten). *@
            @((MarkupString)$"<text x=\"50\" y=\"95\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"800\" font-family=\"system-ui, sans-serif\" fill=\"{NumberColor(a)}\" stroke=\"{a.ShirtHex}\" stroke-width=\".6\">{a.Number}</text>")
        }

        @* Sterren van de Gouden Bal, boven het clublogo: drie per rij *@
        @for (var i = 0; i < stars; i++)
        {
            <path d="@StarPath(61 + i % 3 * 6, 76 + i / 3 * 6)" fill="#f5c400" stroke="#7a5a00" stroke-width=".5" stroke-linejoin="round" />
        }

        @* Nek en hoofd *@
        <rect x="43" y="56" width="14" height="14" rx="4" fill="@a.SkinHex" />
        <ellipse cx="50" cy="42" rx="19" ry="21" fill="@a.SkinHex" />
        <ellipse cx="31" cy="44" rx="3" ry="5" fill="@a.SkinHex" />
        <ellipse cx="69" cy="44" rx="3" ry="5" fill="@a.SkinHex" />

        @* Haar bovenop *@
        @switch (a.Style)
        {
            case HairStyle.Buzz:
                <path d="M31 38 Q31 20 50 20 Q69 20 69 38 Q60 30 50 30 Q40 30 31 38 Z" fill="@hair" opacity=".75" />
                break;
            case HairStyle.Short:
                <path d="M30 40 Q28 18 50 17 Q72 18 70 40 Q66 28 52 28 Q38 27 30 40 Z" fill="@hair" />
                break;
            case HairStyle.Slick:
                <path d="M30 38 Q28 16 52 15 Q74 16 70 36 Q64 24 48 26 Q37 27 30 38 Z" fill="@hair" />
                <path d="M40 18 Q58 12 70 24" fill="none" stroke="@hair" stroke-width="5" stroke-linecap="round" />
                break;
            case HairStyle.Curly:
                <g fill="@hair">
                    <circle cx="35" cy="28" r="7" /><circle cx="44" cy="22" r="7" /><circle cx="55" cy="21" r="7" />
                    <circle cx="65" cy="27" r="7" /><circle cx="31" cy="36" r="5" /><circle cx="69" cy="36" r="5" />
                </g>
                break;
            case HairStyle.Afro:
            case HairStyle.BigAfro:
            case HairStyle.Long:
            case HairStyle.Dreads:
                <path d="M31 36 Q32 21 50 21 Q68 21 69 36 Q60 28 50 28 Q40 28 31 36 Z" fill="@hair" />
                break;
            case HairStyle.Bun:
                <circle cx="50" cy="14" r="7" fill="@hair" />
                <path d="M30 40 Q28 18 50 18 Q72 18 70 40 Q66 28 50 27 Q36 28 30 40 Z" fill="@hair" />
                break;
            case HairStyle.Mohawk:
                <path d="M33 36 Q33 26 50 25 Q67 26 67 36 Q58 31 50 31 Q42 31 33 36 Z" fill="@hair" opacity=".5" />
                <path d="M44 31 Q43 12 50 9 Q57 12 56 31 Z" fill="@hair" />
                break;
        }

        @if (a.HeadbandHex is { } band)
        {
            <path d="M31 31 Q50 23 69 31 L69 36 Q50 28 31 36 Z" fill="@band" />
        }

        @* Gezicht *@
        <circle cx="43" cy="43" r="2.2" fill="#2b211c" />
        <circle cx="57" cy="43" r="2.2" fill="#2b211c" />
        <path d="M39 37 L46 36 M54 36 L61 37" stroke="@Brow(a)" stroke-width="1.8" stroke-linecap="round" />

        @switch (a.Facial)
        {
            case FacialHair.Stubble:
                <path d="M32 46 Q34 64 50 64 Q66 64 68 46 Q64 56 50 56 Q36 56 32 46 Z" fill="@hair" opacity=".3" />
                break;
            case FacialHair.Moustache:
                <path d="M42 51 Q50 47 58 51 Q54 53 50 51.5 Q46 53 42 51 Z" fill="@hair" />
                break;
            case FacialHair.Goatee:
                <path d="M43 51 Q50 48 57 51 Q54 52.5 50 51.5 Q46 52.5 43 51 Z" fill="@hair" />
                <path d="M45 57 Q50 64 55 57 Q50 59 45 57 Z" fill="@hair" />
                break;
            case FacialHair.Beard:
                <path d="M32 46 Q34 64 50 64 Q66 64 68 46 Q64 56 50 56 Q36 56 32 46 Z" fill="@hair" opacity=".9" />
                break;
        }
        <path d="M44 54 Q50 58 56 54" fill="none" stroke="#7a3b2e" stroke-width="2" stroke-linecap="round" />

        @* Oorbel aan het oor rechts in beeld *@
        @switch (a.Earring)
        {
            case Earring.GoldStud:
                <circle cx="69.5" cy="49" r="1.8" fill="#f5c400" stroke="#b38f00" stroke-width=".5" />
                break;
            case Earring.SilverStud:
                <circle cx="69.5" cy="49" r="1.8" fill="#e6e9ec" stroke="#8a9299" stroke-width=".5" />
                break;
            case Earring.Diamond:
                <path d="M69.5 46.6 L71.6 49 L69.5 51.4 L67.4 49 Z" fill="#bfe8ff" stroke="#5aa9d6" stroke-width=".5" />
                break;
            case Earring.GoldHoop:
                <circle cx="69.5" cy="51.5" r="2.8" fill="none" stroke="#f5c400" stroke-width="1.3" />
                break;
            case Earring.SilverHoop:
                <circle cx="69.5" cy="51.5" r="2.8" fill="none" stroke="#c5cbd1" stroke-width="1.3" />
                break;
        }

        @switch (a.Glasses)
        {
            case Glasses.Round:
                <g fill="none" stroke="#2b211c" stroke-width="1.6">
                    <circle cx="43" cy="43" r="5.5" /><circle cx="57" cy="43" r="5.5" /><path d="M48.5 43 L51.5 43" />
                </g>
                break;
            case Glasses.Square:
                <g fill="none" stroke="#2b211c" stroke-width="1.8">
                    <rect x="37" y="38.5" width="11" height="9" rx="1.5" /><rect x="52" y="38.5" width="11" height="9" rx="1.5" /><path d="M48 42 L52 42" />
                </g>
                break;
            case Glasses.Sunglasses:
                <g fill="#1f1a17">
                    <rect x="36.5" y="39" width="12" height="8" rx="3" /><rect x="51.5" y="39" width="12" height="8" rx="3" />
                    <rect x="48" y="40.5" width="4" height="1.6" />
                </g>
                break;
            case Glasses.Sport:
                <path d="M33 40 Q50 35 67 40 L66 47 Q50 43 34 47 Z" fill="#2f6fd6" opacity=".85" stroke="#1f1a17" stroke-width="1" />
                break;
        }
    </g>
    @if (golden)
    {
        @* Gouden rand: de Gouden Bal van vorige maand *@
        <circle cx="50" cy="50" r="47.5" fill="none" stroke="url(#gold-@_uid)" stroke-width="5" />
        <circle cx="50" cy="50" r="44.8" fill="none" stroke="#7a5a00" stroke-width=".6" opacity=".6" />
    }
</svg>

@code {
    /// <summary>Id van een voetballer of een zelfgemaakte avatar ("c1:…").</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Rechtstreeks een avatar tekenen (gebruikt door de avatar-bouwer).</summary>
    [Parameter] public AvatarDef? Def { get; set; }

    /// <summary>Gebruikersnaam van wie deze avatar heeft: toont diens sterren en gouden rand. Leeg bij voetballers in de quiz.</summary>
    [Parameter] public string? User { get; set; }

    [Parameter] public int Size { get; set; } = 40;

    private const string ShirtPath = "M8 100 Q10 74 34 68 L66 68 Q90 74 92 100 Z";

    // Elke avatar op de pagina heeft eigen clipPath-ids nodig.
    private readonly string _uid = Guid.NewGuid().ToString("N")[..8];

    protected override void OnInitialized() => GoldenBall.Changed += Redraw;

    public void Dispose() => GoldenBall.Changed -= Redraw;

    private void Redraw()
    {
        if (User is not null) InvokeAsync(StateHasChanged);
    }

    private static string Label(string name, int stars, bool golden) =>
        name + (stars > 0 ? $", {stars} × Gouden Bal" : "") + (golden ? ", Gouden Bal van vorige maand" : "");

    /// <summary>Een vijfpuntige ster rond (x, y).</summary>
    private static string StarPath(double x, double y, double r = 2.7)
    {
        var points = Enumerable.Range(0, 10).Select(i =>
        {
            var radius = i % 2 == 0 ? r : r * .45;
            var angle = Math.PI / 5 * i - Math.PI / 2;
            return FormattableString.Invariant($"{x + radius * Math.Cos(angle):0.##} {y + radius * Math.Sin(angle):0.##}");
        });
        return "M" + string.Join(" L", points) + " Z";
    }

    /// <summary>Bij een kaal hoofd tonen we de wenkbrauwen donker in plaats van in de (onzichtbare) haarkleur.</summary>
    private static string Brow(AvatarDef a) => a.Style == HairStyle.Bald ? "#3b2614" : a.HairHex;

    /// <summary>Het rugnummer leesbaar houden op een gestreept of gedeeld shirt.</summary>
    private static string NumberColor(AvatarDef a) =>
        a.Pattern is ShirtPattern.Plain or ShirtPattern.Sash ? a.AccentHex : (a.Shirt == 2 || a.Accent == 2 ? "#1f1a17" : "#ffffff");
}
