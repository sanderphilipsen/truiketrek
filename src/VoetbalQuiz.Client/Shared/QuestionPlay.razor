@* Een vraag tijdens het spelen, voor elk vraagtype: de opgave, de invoer (typen, kiezen of een jaartal) en de tips.
   Gebruikt door de daily (Question.razor) en de online partijtjes (Wedstrijd.razor). Geef een @key per vraag mee. *@

@switch (Type)
{
    case QuestionType.Snelvuur:
    case QuestionType.NietBij:
        <p class="prompt big">@View?.Prompt</p>
        <div class="choices">
            @for (var i = 0; i < (View?.Options?.Count ?? 0); i++)
            {
                var index = i;
                <button class="choice" @onclick="() => SendAsync(index.ToString())" disabled="@(Busy || ReadOnly)">@View!.Options![i]</button>
            }
        </div>
        break;

    case QuestionType.Jaar:
        <p class="prompt big">@View?.Prompt</p>
        @if (!ReadOnly)
        {
            <div class="year-picker">
                <button class="btn" @onclick="() => SetYear(_year - 1)">−</button>
                @* Typen, schuiven en −/+ werken allemaal; ze blijven met elkaar in sync. *@
                @* Tik je in het veld, dan is het jaartal meteen geselecteerd en typ je er zo overheen. *@
                <input class="year-value" type="text" inputmode="numeric" maxlength="4" value="@_yearText" enterkeyhint="send"
                       onfocus="this.select()" @oninput="YearTyped" @onkeydown="YearKey" aria-label="Jaartal" />
                <button class="btn" @onclick="() => SetYear(_year + 1)">+</button>
            </div>
            <input type="range" class="year-slider" min="@QuestionRules.MinYear" max="@QuestionRules.MaxYear" value="@_year"
                   @oninput="e => SetYear(int.Parse(e.Value!.ToString()!))" />
            <div class="year-scale"><span>@QuestionRules.MinYear</span><span>@QuestionRules.MaxYear</span></div>
            <button class="btn primary big" @onclick="ConfirmYearAsync" disabled="@(Busy || !YearValid)">
                @(YearValid ? $"Bevestig {_year}" : $"Kies een jaar tussen {QuestionRules.MinYear} en {QuestionRules.MaxYear}")
            </button>
        }
        break;

    case QuestionType.Volgorde:
        <p class="prompt big">@View?.Prompt</p>
        <div class="order-cards">
            @for (var i = 0; i < (View?.Options?.Count ?? 0); i++)
            {
                var index = i;
                var place = _order.IndexOf(index);
                <button class="order-card @(place >= 0 ? "order-card-on" : "")" @onclick="() => ToggleCard(index)" disabled="@(Busy || ReadOnly || _orderSent)"
                        aria-label="@CardLabel(index)">
                    <span class="order-num" aria-hidden="true">@(place >= 0 ? (place + 1).ToString() : "")</span>
                    <span>@View!.Options![index]</span>
                </button>
            }
        </div>
        @if (!ReadOnly)
        {
            var total = View?.Options?.Count ?? 0;
            <button class="btn primary big" @onclick="SendOrderAsync" disabled="@(Busy || _orderSent || _order.Count < total)">
                @(_order.Count < total ? $"Tik nog {total - _order.Count} kaartje{(total - _order.Count == 1 ? "" : "s")} aan" : "Klaar")
            </button>
            <p class="center light-text">Nog eens tikken haalt een kaartje terug weg.</p>
        }
        break;

    case QuestionType.Krant:
        <KrantArticle Headline="@View?.Prompt" Intro="@View?.Note" Kind="@View?.ArticleKind" Paragraphs="View?.Article ?? []"
                      Selected="SelectedGap?.Gap" OnSelect="@(ReadOnly ? null : SelectGapAsync)" />
        @if (!ReadOnly && SelectedGap is { } open)
        {
            @* Vast onderaan in beeld: de reactie op je laatste antwoord, het invoerveld en "Klaar", ook midden in een lang artikel. *@
            <div class="krant-dock">
                <div class="play-feedback" role="status" aria-live="polite">
                    @if (_goal is not null)
                    {
                        <div class="goal" @key="_goal"><Icon Name="soccer-ball" /> @_goal</div>
                    }
                    @if (_notInLineup is not null)
                    {
                        <div class="wrong" @key="_wrongKey"><Icon Name="x-circle" /> @Commentary.Pick(Commentary.Wrong, _wrongKey) “@_notInLineup” past niet in dit gat</div>
                    }
                    @if (open.IsNumber && _goal is null && _notInLineup is null)
                    {
                        <div class="light-text">Een getal gok je één keer: hoe dichter, hoe meer punten.</div>
                    }
                </div>
                <form class="answer" @onsubmit="TypeGapAsync">
                    <input @ref="_input" @bind="_guess" @bind:event="oninput" placeholder="@open.Hint…" aria-label="Gat @(open.Gap + 1): @open.Hint"
                           inputmode="@(open.IsNumber ? "numeric" : "text")" autocomplete="off" autocapitalize="words" spellcheck="false" enterkeyhint="send" />
                    <button class="btn primary" disabled="@Busy">OK</button>
                    @if (GiveUp is not null)
                    {
                        <button type="button" class="btn" @onclick="GiveUp" disabled="@Busy">Klaar</button>
                    }
                </form>
            </div>
        }
        break;

    case QuestionType.Detective:
        <DetectiveBoard View="View" Busy="Busy" ReadOnly="ReadOnly" Send="Send" />
        break;

    case QuestionType.Kaart:
        @* Deel 1: bij elke speld de club(s) kiezen. Deel 2: de club staat bij de speld, kies het stadion. *@
        var stadiums = View?.Part == QuestionRules.KaartStadiumsPart;
        <div class="kaart-q">
            <p class="prompt kaart-prompt">@View?.Prompt</p>
            <LandKaart Land="@(View?.Country ?? QuestionRules.KaartDefaultCountry)" Pins="KaartPins(View)" LabelHuidig="stadiums" />
        </div>
        @if (!ReadOnly && CurrentPin is { } pin)
        {
            @* Vast paneel onderaan: keuzelijst(en) en knoppen blijven altijd zichtbaar, ook bij een gedeeld stadion op een
               klein scherm. De reactie op de vorige speld heeft een vaste plaats, zodat de knoppen nooit verspringen. *@
            <div class="kaart-panel">
                <div class="kaart-feedback" role="status" aria-live="polite">
                    @if (LastAnswered is { } last)
                    {
                        <div class="kaart-fb @(last.IsRight ? "ok" : last.Hits > 0 ? "half" : "bad")" @key="View!.Found">
                            <Icon Name="@(last.IsRight ? "check-circle" : "x-circle")" />
                            <span>@FeedbackText(last, stadiums)</span>
                        </div>
                    }
                </div>
                <div class="kaart-head">
                    <span class="kaart-count">Speld <b>@(View!.Found + 1)</b>/@View.Total</span>
                    @if (stadiums)
                    {
                        <b class="kaart-clubs">@string.Join(" en ", pin.Clubs ?? [])</b>
                    }
                    else if (pin.Choices > 1)
                    {
                        <span class="kaart-shared">Gedeeld stadion: @pin.Choices clubs</span>
                    }
                </div>
                @* Bij een gedeeld stadion staan de keuzelijsten naast elkaar: het paneel wordt niet hoger. *@
                <div class="kaart-selects" style="--kaart-lijsten: @pin.Choices">
                @for (var i = 0; i < pin.Choices; i++)
                {
                    var index = i;
                    <select class="kaart-select" value="@KaartChoice(index)" disabled="@Busy"
                            aria-label="@SelectLabel(pin, index, stadiums)"
                            @onchange="e => SetKaartChoice(index, e.Value?.ToString())">
                        <option value="">@(stadiums ? "Kies een stadion…" : pin.Choices > 1 ? $"Club {index + 1}…" : "Kies een club…")</option>
                        @foreach (var option in View.Options ?? [])
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                }
                </div>
                <div class="kaart-actions">
                    <button class="btn skip" @onclick="SkipPinAsync" disabled="@Busy">Overslaan</button>
                    <button class="btn primary" @onclick="ConfirmPinAsync" disabled="@(Busy || !KaartReady(pin))">Bevestig</button>
                </div>
            </div>
        }
        break;

    default:
        @* Getypte types: Wie ben ik?, Carrièrepad, Emoji, Opstelling, Wissel, Rugnummer, Mannetje, Kluts en Counter *@
        @if (Type == QuestionType.Emoji)
        {
            <div class="emoji-big">@View?.Prompt</div>
            <p class="center light-text">@View?.Note</p>
        }
        else if (Type == QuestionType.Opstelling)
        {
            <p class="prompt">@View?.Prompt</p>
        }
        else if (Type is QuestionType.Carriere or QuestionType.Wissel)
        {
            <p class="center light-text">@View?.Prompt</p>
        }
        else if (Type == QuestionType.Rugnummer)
        {
            <div class="shirt-big" aria-label="Rugnummer @View?.Shirt"><span>@View?.Shirt</span></div>
            <p class="center light-text">@View?.Prompt</p>
        }
        else if (Type == QuestionType.Mannetje && View?.Avatar is { } avatar)
        {
            @* Stap 1: donker silhouet, stap 2: wazig in kleur, daarna scherp. *@
            <div class="mannetje step-@View.Step"><Avatar Id="@avatar" Size="160" /></div>
            <p class="center light-text">@View.Prompt</p>
        }
        else if (Type == QuestionType.Kluts)
        {
            <div class="kluts">
                @foreach (var word in View?.Letters ?? [])
                {
                    <div class="kluts-word">
                        @foreach (var tile in word)
                        {
                            <span class="tile @(tile.Fixed ? "fixed" : "")">@tile.Letter</span>
                        }
                    </div>
                }
            </div>
            <p class="center light-text">Om de @QuestionRules.CarriereClubSeconds seconden valt er per woord een letter juist.</p>
        }
        else if (Type == QuestionType.Counter)
        {
            <div class="counter-card">
                <small>@View?.Note</small>
                <p>@(View?.Prompt ?? "Alle spelers gepasseerd!")</p>
            </div>
        }

        @if (!ReadOnly)
        {
            <form class="answer" @onsubmit="TypeAsync">
                <input @ref="_input" @bind="_guess" @bind:event="oninput"
                       placeholder="@Placeholder" aria-label="Jouw antwoord"
                       autocomplete="off" autocapitalize="words" spellcheck="false" enterkeyhint="send" />
                <button class="btn primary" disabled="@Busy">OK</button>
            </form>

            @if (Type == QuestionType.Counter)
            {
                <button class="btn skip" @onclick="SkipAsync" disabled="@Busy">Doorspelen ⏭</button>
            }

            @* Altijd aanwezig, zodat schermlezers elke nieuwe reactie ("Naast! … is fout") voorlezen. *@
            <div class="play-feedback" role="status" aria-live="polite">
                @if (_goal is not null)
                {
                    <div class="goal" @key="_goal"><Icon Name="soccer-ball" /> @_goal</div>
                }
                @if (_wrongGuess is not null)
                {
                    <div class="wrong" @key="_wrongKey"><Icon Name="x-circle" /> @Commentary.Pick(Commentary.Wrong, _wrongKey) “@_wrongGuess” is fout@(Type == QuestionType.Counter ? "" : $" (−{GameRules.WrongGuessPenalty})")</div>
                }
                @if (_notInLineup is not null)
                {
                    <div class="wrong" @key="_notInLineup"><Icon Name="shield" /> @Commentary.Pick(Commentary.Blocked, _notInLineup.Length) “@_notInLineup” staat niet (meer) op een open plaats</div>
                }
            </div>
        }

        @if (Type == QuestionType.Opstelling)
        {
            <Lineup Slots="View?.Lineup ?? []" />
        }
        else
        {
            @* Nieuwste tip/club bovenaan, zodat hij zichtbaar blijft boven het toetsenbord. *@
            <ol class="hints">
                @for (var i = Hints.Count - 1; i >= 0; i--)
                {
                    <li class="hint @(i == Hints.Count - 1 ? "newest" : "")" @key="i">
                        <span class="hint-num">@(i + 1)</span>
                        <span>@Hints[i]</span>
                    </li>
                }
            </ol>
        }
        break;
}

@code {
    /// <summary>Wat de pagina na een poging teruggeeft, zodat we de juiste reactie tonen.</summary>
    public record Feedback(string? WrongGuess, QuestionView? View, bool Finished);

    [Parameter, EditorRequired] public QuestionType Type { get; set; }
    [Parameter] public QuestionView? View { get; set; }
    [Parameter] public List<string> Hints { get; set; } = [];
    [Parameter] public bool Busy { get; set; }

    /// <summary>Enkel kijken (bv. een toeschouwer bij een online partijtje).</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Hoeveel tijd er nog is. Op volgorde: vlak voor het einde gaat de aangetikte volgorde vanzelf weg.</summary>
    [Parameter] public double SecondsLeft { get; set; } = double.MaxValue;

    /// <summary>Stuurt een poging (een naam, een optie "0".."3", een jaartal of een volgorde "2,0,3,1"); null als het mislukte.</summary>
    [Parameter, EditorRequired] public Func<string, Task<Feedback?>> Send { get; set; } = null!;

    /// <summary>De Krant: stoppen vanuit de vaste balk onderaan (anders moet je eerst het hele artikel door).</summary>
    [Parameter] public Func<Task>? GiveUp { get; set; }

    private string _guess = "";
    private string? _wrongGuess, _notInLineup, _goal;

    /// <summary>Telt mee bij elke reactie, zodat de voetbaluitroep afwisselt ("Voorlangs!", "Naast!", …).</summary>
    private int _wrongKey;

    private ElementReference _input;

    private string Placeholder => Type switch
    {
        QuestionType.Opstelling => "Typ een naam…",
        QuestionType.Wissel => "Wie maakte de transfer?",
        QuestionType.Rugnummer => "Wie droeg dit shirt?",
        QuestionType.Mannetje => "Wie is dit mannetje?",
        QuestionType.Kluts => "Ontwar de naam…",
        QuestionType.Counter => "Typ snel een naam…",
        _ => "Wie ben ik?",
    };

    private int _year = 2010;
    private string _yearText = "2010";

    private bool YearValid => int.TryParse(_yearText, out var y) && y is >= QuestionRules.MinYear and <= QuestionRules.MaxYear;

    private void SetYear(int year)
    {
        _year = Math.Clamp(year, QuestionRules.MinYear, QuestionRules.MaxYear);
        _yearText = _year.ToString();
    }

    /// <summary>Tijdens het typen (bv. "19", "198") laten we de tekst staan; de slider volgt zodra het een geldig jaar is.</summary>
    private void YearTyped(ChangeEventArgs e)
    {
        _yearText = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).Take(4).ToArray());
        if (YearValid) _year = int.Parse(_yearText);
    }

    private async Task YearKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmYearAsync();
    }

    private Task ConfirmYearAsync() => YearValid && !Busy ? SendAsync(_yearText) : Task.CompletedTask;

    private async Task SendAsync(string guess) => await Send(guess);

    /// <summary>Op volgorde: de getoonde kaartjes (index) in de volgorde waarin de speler ze aantikte.</summary>
    private readonly List<int> _order = [];
    private bool _orderSent;

    /// <summary>Voor schermlezers: de tekst van het kaartje en, als het aangetikt is, zijn plaats.</summary>
    private string CardLabel(int index) =>
        (View?.Options?[index] ?? "") + (_order.IndexOf(index) is var place and >= 0 ? $", plaats {place + 1}" : "");

    private void ToggleCard(int index)
    {
        if (!_order.Remove(index)) _order.Add(index);
    }

    private async Task SendOrderAsync()
    {
        if (_orderSent || _order.Count == 0) return;
        _orderSent = true;
        if (await Send(string.Join(",", _order)) is null) _orderSent = false;
    }

    // ---------- Kaart ----------

    /// <summary>Kaart: de gekozen club per keuzelijst van de huidige speld (leeg = nog niets gekozen).</summary>
    private string[] _kaartChoices = [];

    /// <summary>Kaart: voor welke speld (aantal al beantwoorde) de keuzes gelden; een nieuwe speld begint leeg.</summary>
    private int _kaartFor = -1;

    private KaartSpeld? CurrentPin => View?.Pins?.FirstOrDefault(p => p.IsCurrent);

    /// <summary>Kaart: de laatst beantwoorde speld (de spelden komen in de volgorde waarin ze verschenen).</summary>
    private KaartSpeld? LastAnswered => View is { Found: > 0, Pins: { } pins } ? pins.ElementAtOrDefault(View.Found - 1) : null;

    /// <summary>
    /// De spelden van de server als spelden op de kaart: groen, oranje (deels) of rood. Het label is de club: in deel 1
    /// na het antwoord, in deel 2 ook bij de huidige speld (daar is de club de vraag).
    /// </summary>
    public static List<KaartPin> KaartPins(QuestionView? view) =>
        view?.Pins?.Select(p => new KaartPin(p.Lat, p.Lon,
            p.IsCurrent ? KaartPinState.Huidig : p.IsRight ? KaartPinState.Juist : p.Hits > 0 ? KaartPinState.Deels : KaartPinState.Fout,
            p.Clubs is null ? null : string.Join(" / ", p.Clubs))).ToList() ?? [];

    /// <summary>"Juist: Genk" of "Fout: het was Genk (jij: Standard)"; in deel 2 met het stadion.</summary>
    private static string FeedbackText(KaartSpeld last, bool stadiums)
    {
        var answer = string.Join(" en ", last.Answer ?? []);
        if (last.IsRight) return $"Juist: {answer}";
        var mine = string.IsNullOrEmpty(last.Pick) ? "overgeslagen" : "jij: " + last.Pick.Replace(QuestionRules.KaartSeparator.ToString(), " en ");
        return $"{(last.Hits > 0 ? "Deels juist" : "Fout")}: het was {answer} ({mine})";
    }

    private static string SelectLabel(KaartSpeld pin, int index, bool stadiums) =>
        stadiums ? $"In welk stadion speelt {string.Join(" en ", pin.Clubs ?? [])}?"
        : pin.Choices > 1 ? $"Club {index + 1} van dit stadion" : "Welke club speelt hier?";

    private string KaartChoice(int index) => _kaartChoices.ElementAtOrDefault(index) ?? "";

    private void SetKaartChoice(int index, string? choice)
    {
        if (index < _kaartChoices.Length) _kaartChoices[index] = choice ?? "";
    }

    /// <summary>Elke keuzelijst ingevuld (bij een gedeeld stadion in deel 1 alle clubs).</summary>
    private bool KaartReady(KaartSpeld pin) => _kaartChoices.Length == pin.Choices && _kaartChoices.All(c => c.Length > 0);

    /// <summary>De gok gaat met het nummer van de speld mee: een dubbele tik telt zo nooit voor de volgende speld.</summary>
    private Task SendPinAsync(string answer) => Send(QuestionRules.KaartGuess((View?.Found ?? 0) + 1, answer));

    private async Task ConfirmPinAsync()
    {
        if (CurrentPin is not { } pin || !KaartReady(pin) || Busy) return;
        await SendPinAsync(string.Join(QuestionRules.KaartSeparator, _kaartChoices));
    }

    /// <summary>Overslaan telt als fout: de volgende speld verschijnt.</summary>
    private async Task SkipPinAsync()
    {
        if (Busy) return;
        await SendPinAsync(QuestionRules.KaartSkip);
    }

    protected override void OnParametersSet()
    {
        // Een nieuwe speld: lege keuzelijsten, één per club (deel 1) of één voor het stadion (deel 2).
        if (Type == QuestionType.Kaart && View is { } view && view.Found != _kaartFor)
        {
            _kaartFor = view.Found;
            _kaartChoices = new string[CurrentPin?.Choices ?? 0];
            Array.Fill(_kaartChoices, "");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Wat aangetikt is, telt: de rest komt achteraan.
        if (Type == QuestionType.Volgorde && !ReadOnly && SecondsLeft <= QuestionRules.VolgordeAutoSendSeconds && !Busy) await SendOrderAsync();
    }

    private async Task TypeAsync()
    {
        if (string.IsNullOrWhiteSpace(_guess) || Busy) return;
        var guess = _guess;
        var foundBefore = QuestionDisplay.LineupFound(View);
        var counterBefore = View?.Found ?? 0;
        (_goal, _wrongGuess) = (null, null);

        var feedback = await Send(guess);
        if (feedback is null) return;
        if (feedback.WrongGuess is { } wrong)
        {
            _wrongGuess = wrong;
            _wrongKey++;
            _guess = "";
        }
        else if (Type == QuestionType.Counter)
        {
            // Bij een counter kost een foute naam niets: we tonen het enkel.
            var hit = (feedback.View?.Found ?? 0) > counterBefore;
            if (hit) _goal = Commentary.Pick(Commentary.Goal, ++_wrongKey);
            else if (!feedback.Finished) (_wrongGuess, _wrongKey) = (guess, _wrongKey + 1);
            _guess = "";
        }
        else if (Type == QuestionType.Opstelling)
        {
            // Bij een opstelling is een naam die niet past geen fout, maar we tonen het wel.
            _notInLineup = QuestionDisplay.LineupFound(feedback.View) > foundBefore || feedback.Finished ? null : guess;
            _guess = "";
        }
    }

    /// <summary>De Krant: het gat dat de speler nu invult (standaard het eerste open gat).</summary>
    private int? _gap;

    private IEnumerable<KrantPiece> OpenGaps => (View?.Article ?? []).SelectMany(p => p).Where(p => p.Gap >= 0 && p.Filled is null);

    private KrantPiece? SelectedGap => OpenGaps.FirstOrDefault(p => p.Gap == _gap) ?? OpenGaps.FirstOrDefault();

    private async Task SelectGapAsync(int gap)
    {
        (_gap, _goal, _notInLineup) = (gap, null, null);
        await Task.Yield();
        try { await _input.FocusAsync(); } catch { /* al weg */ }
    }

    /// <summary>De Krant: stuurt "gat|tekst". Juist (of een getal gegokt): door naar het volgende open gat.</summary>
    private async Task TypeGapAsync()
    {
        if (string.IsNullOrWhiteSpace(_guess) || Busy || SelectedGap is not { } open) return;
        var guess = _guess;
        (_goal, _notInLineup) = (null, null);

        var feedback = await Send($"{open.Gap}|{guess}");
        if (feedback is null) return;
        var filled = feedback.View?.Article?.SelectMany(p => p).Any(p => p.Gap == open.Gap && p.Filled is not null) ?? feedback.Finished;
        if (filled)
        {
            if (!open.IsNumber) _goal = Commentary.Pick(Commentary.Goal, ++_wrongKey);
            _guess = "";
            // Het volgende open gat na dit, anders het eerste dat nog open is.
            var stillOpen = (feedback.View?.Article ?? []).SelectMany(p => p).Where(p => p.Gap >= 0 && p.Filled is null).ToList();
            _gap = (stillOpen.FirstOrDefault(p => p.Gap > open.Gap) ?? stillOpen.FirstOrDefault())?.Gap;
        }
        else
        {
            (_notInLineup, _wrongKey) = (guess, _wrongKey + 1);
            _guess = "";
        }
    }

    /// <summary>Counter: deze speler overslaan en naar de volgende.</summary>
    private async Task SkipAsync()
    {
        (_goal, _wrongGuess, _guess) = (null, null, "");
        await Send(QuestionRules.CounterSkip);
        try { await _input.FocusAsync(); } catch { /* al weg */ }
    }

    // Bewust geen automatische focus bij het openen van een vraag: op de gsm springt dan meteen het toetsenbord open
    // en schuift de vraag uit beeld. Het toetsenbord verschijnt pas als de speler zelf in het tekstvak tikt.
}
