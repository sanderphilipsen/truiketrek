@* Rijen van een klassement: plaats, speler en punten. Een naam opent het spelersprofiel (met head-to-head). *@
<ol class="board">
    @foreach (var e in Entries)
    {
        <li class="@(e.IsMe ? "me" : "")">
            <span class="rank">@Medal(e.Rank)</span>
            <Avatar Id="@e.AvatarId" User="@e.UserName" Size="38" />
            <a class="player" href="speler/@Uri.EscapeDataString(e.UserName)"><b>@e.UserName</b></a>
            <span class="pts">@e.Points</span>
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired] public List<Row> Entries { get; set; } = [];

    public record Row(int Rank, string UserName, string? AvatarId, int Points, bool IsMe);

    private static string Medal(int rank) => rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => rank.ToString() };
}
