@* Jouw partijtjes en de open partijtjes, live bijgewerkt via SignalR. *@
@implements IAsyncDisposable
@inject ApiClient Api
@inject RealtimeClient Realtime
@inject NavigationManager Nav

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}

@if (_lobby is null)
{
    @if (_loadError is not null)
    {
        <p class="error" role="alert">@_loadError</p>
        <button type="button" class="btn small tables-retry" @onclick="RetryAsync" disabled="@_busy">Opnieuw proberen</button>
    }
    else if (!Compact)
    {
        <div class="center-msg"><Spinner /></div>
    }
}
else
{
    @if (ShowMine && _lobby.Mine.Count > 0)
    {
        <h2 class="section-title">Jouw partijtjes</h2>
        <div class="tables">
            @foreach (var m in _lobby.Mine)
            {
                <a class="table-card mine" href="online/@m.Id">
                    <Avatar Id="@m.HostAvatarId" User="@m.HostName" Size="40" />
                    <div class="table-info">
                        <b>@m.Name</b>
                        <small>
                            @if (m.Status == MatchStatus.Running)
                            {
                                <span><span class="live-dot inline" aria-hidden="true"></span> Bezig</span>
                            }
                            else
                            {
                                <span class="match-meta"><span class="match-meta-chunk">@m.Players/@m.Seats spelers</span> <span class="match-meta-chunk sep">wacht op start</span></span>
                            }
                        </small>
                        <small class="table-type"><MatchMeta Types="m.Types" Questions="m.Questions" Derby="m.Derby" /></small>
                    </div>
                    <span class="btn small primary">@(m.Status == MatchStatus.Running ? "Verder" : "Open")</span>
                </a>
            }
        </div>
    }

    @if (!Compact)
    {
        @* De live-stip staat achter de kop, zodat zijn halo niet buiten de inhoudsmarge uitsteekt. *@
        <h2 class="section-title rooms-title">
            Nu open
            @if (_lobby.Open.Count > 0)
            {
                <span class="rooms-live"><span class="live-dot" aria-hidden="true"></span>@_lobby.Open.Count live</span>
            }
        </h2>
    }
    @if (_lobby.Open.Count == 0 && !Compact)
    {
        <div class="card center tables-empty">
            @if (_lobby.Mine.Count > 0)
            {
                @* Je hebt zelf al een partijtje open: niet nog eens "maak er een" zeggen. *@
                <p>Nog geen andere open partijtjes. Deel de link van jouw partijtje, zodat je maten kunnen aanschuiven.</p>
            }
            else
            {
                <p>Nog geen open partijtjes. Maak er zelf een en daag je maten uit!</p>
            }
        </div>
    }
    else if (_lobby.Open.Count > 0)
    {
        <div class="tables">
            @foreach (var m in _lobby.Open)
            {
                var free = m.Seats - m.Players;
                <div class="table-card room">
                    <Avatar Id="@m.HostAvatarId" User="@m.HostName" Size="44" />
                    <div class="table-info">
                        <b>@m.Name</b>
                        <small class="table-type"><MatchMeta Types="m.Types" Questions="m.Questions" Derby="m.Derby" /></small>
                        <div class="room-seats">
                            @for (var i = 0; i < m.Seats; i++)
                            {
                                <span class="seat @(i < m.Players ? "taken" : "")" aria-hidden="true"></span>
                            }
                            <span class="room-free @(free == 1 ? "last" : "")">
                                <span class="sr-only">@m.Players van @m.Seats plaatsen bezet, </span>@(free == 1 ? "laatste plaats!" : $"nog {free} vrij")
                            </span>
                        </div>
                    </div>
                    @* Op Home is de daily de hoofdactie: meedoen krijgt daar een gewone knop. *@
                    <button type="button" class="btn small room-join @(Compact ? "" : "primary")" @onclick="() => JoinAsync(m.Id)" disabled="@_busy"
                            aria-label="Doe mee met @m.Name">@(_joining == m.Id ? "Even…" : "Doe mee")</button>
                </div>
            }
        </div>
    }
}

@code {
    /// <summary>"Jouw partijtjes" tonen. Home zet dit uit en toont je partijtje als banner bovenaan (via OnLoaded).</summary>
    [Parameter] public bool ShowMine { get; set; } = true;

    /// <summary>
    /// Compact blok voor Home: geen kop, niets tijdens het laden en niets als er geen open partijtjes zijn
    /// (dan staat enkel "Nieuwe match" op Home), en een gewone (niet-gele) knop om mee te doen.
    /// </summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Na elke (live) lading van de lobby, bv. voor de banner op Home.</summary>
    [Parameter] public EventCallback<LobbyOverview> OnLoaded { get; set; }

    private LobbyOverview? _lobby;
    private bool _busy;
    private string? _loadError;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Realtime.LobbyChanged += OnLobbyChanged;
        await LoadAsync();
        try { await Realtime.WatchLobbyAsync(); }
        catch { _error ??= "Live updates zijn niet beschikbaar. Ververs de pagina om nieuwe partijtjes te zien."; }
    }

    private async Task OnLobbyChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        try
        {
            _lobby = await Api.GetLobbyAsync();
            _loadError = null;
            await OnLoaded.InvokeAsync(_lobby);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // Lukt een live herlading niet, dan blijft de vorige lijst staan.
            if (_lobby is null) _loadError = ex is ApiException api ? api.Message : "De partijtjes konden niet geladen worden. Controleer je verbinding.";
        }
    }

    private async Task RetryAsync()
    {
        _busy = true;
        await LoadAsync();
        _busy = false;
    }

    /// <summary>Het partijtje waar je net op "Doe mee" tikte (meteen zichtbare reactie).</summary>
    private int? _joining;

    private async Task JoinAsync(int id)
    {
        _busy = true;
        _joining = id;
        try
        {
            await Api.JoinMatchAsync(id);
            Nav.NavigateTo($"online/{id}");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            await LoadAsync();
        }
        finally { _busy = false; _joining = null; }
    }

    public async ValueTask DisposeAsync()
    {
        Realtime.LobbyChanged -= OnLobbyChanged;
        try { await Realtime.UnwatchLobbyAsync(); } catch { /* verbinding al weg */ }
    }
}
