@* Laden in scorebordstijl: drie segmenten die na elkaar oplichten; de tekst is er alleen voor schermlezers. *@
<span class="spinner @(Small ? "small" : null)" role="status">
    <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
    <span class="sr-only">Laden…</span>
</span>

@code {
    [Parameter] public bool Small { get; set; }
}
