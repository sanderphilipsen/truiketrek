@inherits LayoutComponentBase
@inject AuthState Auth
@inject NavigationManager Nav
@inject GoldenBallState GoldenBall
@inject UpdateNotice UpdateNotice
@implements IDisposable

@* Tijdens een update is de app dicht. Wie midden in een vraag zit, mag die afmaken (de klok loopt op de server);
   een volgende vraag start de server niet meer. *@
@if (UpdateNotice.IsComing && !IsQuestionPage)
{
    <div class="app">
        <div class="maintenance-screen" role="status">
            <img src="logo.svg" alt="" class="maintenance-logo" />
            <h1>Truitje Trek</h1>
            <p>@UpdateNotice.Message</p>
        </div>
    </div>
    return;
}

@* Het admin-paneel gebruikt de volle breedte van een groot scherm. *@
<div class="app @(IsAdminPage ? "wide" : IsProfilePage ? "medium" : "")">
    @* Geen topbar en geen tabbalk: Home is de enige hub. Andere pagina's krijgen een kleine weg terug,
       behalve schermen met een eigen terugknop (een vraag, een wedstrijd, een academiepoging) en Home zelf. *@
    <main class="content">
        <AuthorizeView>
            <Authorized>
                @if (ShowHomeLink)
                {
                    <a href="" class="home-back">‹ Home</a>
                }
            </Authorized>
        </AuthorizeView>
        <UpdateBanner />
        @Body
    </main>
</div>

@code {
    // Sterren en gouden randen van de Gouden Bal: laden zodra er iemand aangemeld is.
    protected override async Task OnInitializedAsync()
    {
        Auth.AuthenticationStateChanged += OnAuthChanged;
        Nav.LocationChanged += OnLocationChanged; // de link terug naar Home tonen of verbergen
        UpdateNotice.Changed += OnUpdateNoticeChanged;
        UpdateNotice.Start();
        await Auth.GetAuthenticationStateAsync();
        await LoadGoldenBallAsync();
    }

    private async void OnAuthChanged(Task<AuthenticationState> _) => await LoadGoldenBallAsync();

    private async Task LoadGoldenBallAsync()
    {
        if (Auth.User is null) GoldenBall.Clear();
        else await GoldenBall.EnsureLoadedAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => StateHasChanged();

    private string Path => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].ToLowerInvariant();

    /// <summary>"‹ Home" bovenaan, behalve op Home (en de sheets erop) en op schermen met een eigen terugknop.</summary>
    private bool ShowHomeLink => Path switch
    {
        "" or "klassement" or "login" => false,
        var p when p.Contains("vraag/") || p.StartsWith("academie/poging") => false,
        var p when p.StartsWith("online/") && p.Length > 7 && char.IsDigit(p[7]) => false, // een wedstrijd of wachtkamer
        _ => true,
    };

    public void Dispose()
    {
        Auth.AuthenticationStateChanged -= OnAuthChanged;
        Nav.LocationChanged -= OnLocationChanged;
        UpdateNotice.Changed -= OnUpdateNoticeChanged;
    }

    private void OnUpdateNoticeChanged() => InvokeAsync(StateHasChanged);

    private bool IsQuestionPage => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Contains("vraag/", StringComparison.OrdinalIgnoreCase);

    private bool IsProfilePage => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("profiel", StringComparison.OrdinalIgnoreCase);

    private bool IsAdminPage => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("admin", StringComparison.OrdinalIgnoreCase);
}
