@inherits LayoutComponentBase
@inject AuthState Auth
@inject NavigationManager Nav
@inject GoldenBallState GoldenBall
@implements IDisposable

@* Het admin-paneel gebruikt de volle breedte van een groot scherm. *@
<div class="app @(IsAdminPage ? "wide" : IsProfilePage ? "medium" : "")">
    <header class="topbar">
        <a href="" class="brand"><img src="logo.svg" alt="" class="logo" /> Truitje Trek</a>
        <AuthorizeView>
            <Authorized>
                @if (Auth.User?.IsAdmin == true)
                {
                    <a href="admin" class="admin-link" title="Admin">⚙️</a>
                }
                @* Lange namen (tot 20 tekens) worden afgekapt; op een smalle gsm valt de naam weg, hij staat al in de begroeting. *@
                <a href="profiel" class="who" aria-label="Jouw profiel: @context.User.Identity?.Name, level @Auth.User?.Level">
                    <span class="who-name">@context.User.Identity?.Name</span>
                    <span class="lvl">Lv @Auth.User?.Level</span>
                    <Avatar Id="@Auth.User?.AvatarId" User="@Auth.User?.UserName" Size="34" />
                </a>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="content">
        @Body
    </main>

    <AuthorizeView>
        <Authorized>
            <nav class="tabbar" aria-label="Hoofdmenu">
                <NavLink href="" Match="NavLinkMatch.All" aria-current="@Current("")"><span aria-hidden="true">🏠</span>Home</NavLink>
                <NavLink href="klassement" aria-current="@Current("klassement")"><span aria-hidden="true">🏆</span>Klassement</NavLink>
                <NavLink href="badges" aria-current="@Current("badges")"><span aria-hidden="true">🎖️</span>Badges</NavLink>
                <NavLink href="statistieken" aria-current="@Current("statistieken")"><span aria-hidden="true">📊</span>Stats</NavLink>
                <NavLink href="profiel" aria-current="@Current("profiel")"><span aria-hidden="true">👤</span>Profiel</NavLink>
            </nav>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    // Sterren en gouden randen van de Gouden Bal: laden zodra er iemand aangemeld is.
    protected override async Task OnInitializedAsync()
    {
        Auth.AuthenticationStateChanged += OnAuthChanged;
        Nav.LocationChanged += OnLocationChanged; // aria-current van de tabbar bijwerken
        await Auth.GetAuthenticationStateAsync();
        await LoadGoldenBallAsync();
    }

    private async void OnAuthChanged(Task<AuthenticationState> _) => await LoadGoldenBallAsync();

    private async Task LoadGoldenBallAsync()
    {
        if (Auth.User is null) GoldenBall.Clear();
        else await GoldenBall.EnsureLoadedAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => StateHasChanged();

    /// <summary>"page" voor het tabblad van de huidige pagina (ook op een subpagina, bv. profiel/...), anders niets.</summary>
    private string? Current(string tab)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        var match = tab == "" ? path == "" : path.Equals(tab, StringComparison.OrdinalIgnoreCase) || path.StartsWith(tab + "/", StringComparison.OrdinalIgnoreCase);
        return match ? "page" : null;
    }

    public void Dispose()
    {
        Auth.AuthenticationStateChanged -= OnAuthChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private bool IsProfilePage => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("profiel", StringComparison.OrdinalIgnoreCase);

    private bool IsAdminPage => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("admin", StringComparison.OrdinalIgnoreCase);
}
